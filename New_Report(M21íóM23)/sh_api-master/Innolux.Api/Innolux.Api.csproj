<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DocumentationFile>Innolux.Api.xml</DocumentationFile>
		<OutputPath></OutputPath>
		<NoWarn>1701;1702;1591</NoWarn>
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
	</PropertyGroup>

	<PropertyGroup>
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
	</PropertyGroup>

	<ItemGroup>
    <PackageReference Include="Autofac" Version="6.3.0" />
		<PackageReference Include="Autofac.Extensions.DependencyInjection" Version="7.2.0" />
		<PackageReference Include="automapper" Version="11.0.0" />
		<PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="11.0.0" />
		<PackageReference Include="EntityFramework" Version="6.4.4" />
		<PackageReference Include="Hangfire" Version="1.7.29" />
		<PackageReference Include="Hangfire.Core" Version="1.7.29" />
		<!--<PackageReference Include="IBM.Data.DB2.Core" Version="3.1.0.600" />
	<PackageReference Include="IBM.Data.DB2.Core-lnx" Version="3.1.0.600-alpha" />-->
		<!-- <PackageReference Include="Microsoft.EntityFrameworkCore" Version="6.0.1" /> -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.sqlserver" Version="6.0.1" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.14.0" />
		<PackageReference Include="Oracle.ManagedDataAccess.Core" Version="3.21.70" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.2.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Innolux.Core\Innolux.Core.csproj" />
		<ProjectReference Include="..\Innolux.EFCore\Innolux.EFCore.csproj" />
		<ProjectReference Include="..\Innolux.Biz\Innolux.Biz.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="ApiScheduler">
		  <HintPath>documents\ApiScheduler.dll</HintPath>
		</Reference>
		<Reference Include="component">
			<HintPath>documents\component.dll</HintPath>
		</Reference>
		<Reference Include="db2Connection">
			<HintPath>documents\db2Connection.dll</HintPath>
		</Reference>
		<Reference Include="GTranslate">
		  <HintPath>documents\GTranslate.dll</HintPath>
		</Reference>
		<Reference Include="InnSqlAgent">
			<HintPath>documents\InnSqlAgent.dll</HintPath>
		</Reference>
		<Reference Include="mySqlConnection">
			<HintPath>documents\mySqlConnection.dll</HintPath>
		</Reference>
		<Reference Include="NCrontab">
		  <HintPath>documents\NCrontab.dll</HintPath>
		</Reference>
		<Reference Include="Newtonsoft.Json">
			<HintPath>documents\Newtonsoft.Json.dll</HintPath>
		</Reference>
		<Reference Include="NLog">
			<HintPath>documents\NLog.dll</HintPath>
		</Reference>
		<Reference Include="Oracle.ManagedDataAccess">
			<HintPath>documents\Oracle.ManagedDataAccess.dll</HintPath>
		</Reference>
		<Reference Include="System.Data.SqlClient">
			<HintPath>documents\System.Data.SqlClient.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<None Update="Innolux.Api.xml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
		<None Update="AppConfig/apiWorkList.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
		<None Update="AppConfig/sqlAgentTest.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!--<ItemGroup Condition="'$(OSTYPE)' != 'linux-gnu' AND '$(OSTYPE)' != 'darwin18'">-->
	<!--<ItemGroup Condition="$([MSBuild]::IsOsPlatform('Linux'))">
		<None Include="clidriver\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>-->
	<!--<ItemGroup>
		<None Include="clidriver\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>-->

	<!--<Target Name="CopyMyFolder" BeforeTargets="PrepareForBuild">
		<ItemGroup Condition="$([MSBuild]::IsOsPlatform('Windows'))">
			<SomeFolder Include="windows/**" />
		</ItemGroup>
		<Copy SourceFiles="@(SomeFolder)" DestinationFiles="$(OutputPath)\%(RecursiveDir)%(Filename)%(Extension)" SkipUnchangedFiles="True">
		</Copy>
	</Target>-->

	<Choose>
		<When Condition=" $([MSBuild]::IsOsPlatform('Windows')) ">
			<ItemGroup>
				<SomeFolder Include="windows\**" />
			</ItemGroup>
		</When>
		<Otherwise>
			<ItemGroup>
				<None Include="clidriver\**">
					<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
				</None>
			</ItemGroup>
			<ItemGroup>
				<None Include="IBM.Data.DB2.Core.dll">
					<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
				</None>
			</ItemGroup>
		</Otherwise>
	</Choose>
	<Target Name="CopyMyFolder" BeforeTargets="PrepareForBuild">
		<Copy SourceFiles="@(SomeFolder)" DestinationFiles="$(OutputPath)\%(RecursiveDir)%(Filename)%(Extension)" SkipUnchangedFiles="True">
		</Copy>
	</Target>
	<ProjectExtensions>
		<VisualStudio><UserProperties appconfig_4appsettings_1json__JsonSchema="" /></VisualStudio>
	</ProjectExtensions>
</Project>
