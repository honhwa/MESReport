<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- 本機調試需編譯 NGB 目錄（Module/Customer/LcmOwner 等 apiName 類別在此），否則 InnSqlAgent 查無 ApiInstance -->
    <!-- NGB 與 SH 同名類別會互相覆蓋 apiName 註冊，以下排除 NGB 重複檔，同名 apiName 一律以 SH 版本為準 -->
    <Compile Remove="SH - sqlserver\**" />
    <EmbeddedResource Remove="SH - sqlserver\**" />
    <None Remove="SH - sqlserver\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SH\LCM\Common\Module.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Innolux.Core\Innolux.Core.csproj" />
    <ProjectReference Include="..\Innolux.EFCore\Innolux.EFCore.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ApiScheduler">
      <HintPath>..\Innolux.Api\documents\ApiScheduler.dll</HintPath>
    </Reference>
    <Reference Include="component">
      <HintPath>..\Innolux.Api\documents\component.dll</HintPath>
    </Reference>
    <Reference Include="db2Connection">
      <HintPath>..\Innolux.Api\documents\db2Connection.dll</HintPath>
    </Reference>
    <Reference Include="ExcelDataReader">
      <HintPath>..\Innolux.Api\documents\ExcelDataReader.dll</HintPath>
    </Reference>
    <Reference Include="ExcelDataReader.DataSet">
      <HintPath>..\Innolux.Api\documents\ExcelDataReader.DataSet.dll</HintPath>
    </Reference>
    <Reference Include="ExcelNumberFormat">
      <HintPath>..\Innolux.Api\documents\ExcelNumberFormat.dll</HintPath>
    </Reference>
    <Reference Include="GTranslate">
      <HintPath>..\Innolux.Api\documents\GTranslate.dll</HintPath>
    </Reference>
    <Reference Include="InnSqlAgent">
      <HintPath>..\Innolux.Api\documents\InnSqlAgent.dll</HintPath>
    </Reference>
    <Reference Include="mySqlConnection">
      <HintPath>..\Innolux.Api\documents\mySqlConnection.dll</HintPath>
    </Reference>
    <Reference Include="NCrontab">
      <HintPath>..\Innolux.Api\documents\NCrontab.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\Innolux.Api\documents\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="NLog">
      <HintPath>..\Innolux.Api\documents\NLog.dll</HintPath>
    </Reference>
    <Reference Include="OnlineTranslate">
