      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select transDATE,wonbr,prodid,SUBentityid,SUBLINEID,entityTqty,case when okflg='1' then 'OK' else 'NG' end as okflg,defectcd,shiftid,userid from wQAx</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
