										<TablixCell>
											<CellContents>
												<Textbox Name="textbox271">
													<CanGrow>true</CanGrow>
													<KeepTogether>true</KeepTogether>
													<Paragraphs>
														<Paragraph>
															<TextRuns>
																<TextRun>
																	<Value>
																		=cstr(round(ROUND(IIF(SUM(24-Fields!OFF_TTL.Value)=0,0,SUM(Fields!UP_TTL.Value)/SUM(24-Fields!OFF_TTL.Value)),4)*
																		ROUND(IIF(SUM(Fields!UP_TTL.Value)=0,0,SUM( Fields!M_RUN.Value)/SUM(Fields!UP_TTL.Value)),4)*
																		ROUND(IIF(SUM(Fields!NORMAL_ACT.Value)=0 or SUM(Fields!TT.Value)=0 or SUM(Fields!M_RUN.Value)=0,0,(SUM(Fields!NORMAL_ACT.Value)/SUM(Fields!M_RUN.Value))/(3600*SUM(Fields!NORMAL_ACT.Value)/SUM(Fields!TT.Value))),4),4) *100)+"%"
																	</Value>
																	<Style>
																		<FontFamily>新細明體</FontFamily>
																	</Style>
																</TextRun>
															</TextRuns>
															<Style>
																<FontFamily />
																<TextAlign>Center</TextAlign>
															</Style>
														</Paragraph>
													</Paragraphs>
													<rd:DefaultName>textbox271</rd:DefaultName>
													<ZIndex>127</ZIndex>
													<Style>
														<Border>
															<Style>Solid</Style>
														</Border>
														<BackgroundColor>SlateGray</BackgroundColor>
														<VerticalAlign>Middle</VerticalAlign>
														<PaddingLeft>2pt</PaddingLeft>
														<PaddingRight>2pt</PaddingRight>
														<PaddingTop>2pt</PaddingTop>
														<PaddingBottom>2pt</PaddingBottom>
													</Style>
												</Textbox>
											</CellContents>
										</TablixCell>
										<TablixCell>
											<CellContents>
												<Textbox Name="textbox272">
													<CanGrow>true</CanGrow>
													<KeepTogether>true</KeepTogether>
													<Paragraphs>
														<Paragraph>
															<TextRuns>
																<TextRun>
																	<Value>
																		= IIF(Fields!PROCESS.Value="COG",
																		cstr(round((ROUND(IIF(SUM((24-Fields!OFF_TTL.Value))=0,0,(SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value+Fields!CHMT.Value)
																		+SUM((Fields!FAC_IDLE.Value+Fields!NONFAC_IDLE.Value) * Fields!UPP_TGT.Value))/
																		SUM((24-Fields!OFF_TTL.Value))),4))*
																		(ROUND(IIF((SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value+Fields!CHMT.Value)
																		+SUM((Fields!NONFAC_IDLE.Value + Fields!FAC_IDLE.Value)* Fields!UPP_TGT.Value))=0,0,(SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value)
																		+SUM(ROUND(Fields!NONFAC_IDLE.Value * Fields!UPP_TGT.Value * Fields!RUNP_TGT.Value,2)))/
																		(SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value+Fields!CHMT.Value)
																		+SUM((Fields!NONFAC_IDLE.Value + Fields!FAC_IDLE.Value)* Fields!UPP_TGT.Value)))
																		,4))*
																		(ROUND(IIF(SUM(Fields!NORMAL_ACT.Value)=0 OR SUM(Fields!TT.Value)=0 or SUM(Fields!M_RUN.Value)=0,0,(SUM(Fields!NORMAL_ACT.Value)/SUM(Fields!M_RUN.Value))/(3600*SUM(Fields!NORMAL_ACT.Value)/SUM(Fields!TT.Value))),4) ),4)*100) +"%"
																		,

																		cstr(round(ROUND((SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value+Fields!CHMT.Value)
																		+SUM((Fields!FAC_IDLE.Value+Fields!NONFAC_IDLE.Value+Fields!OFF_TTL.Value) * Fields!UPP_TGT.Value))/
																		SUM(24),4)
																		*
																		iif((SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value+Fields!CHMT.Value)
																		+SUM((Fields!NONFAC_IDLE.Value + Fields!FAC_IDLE.Value+Fields!OFF_TTL.Value)* Fields!UPP_TGT.Value))=0,0,ROUND((SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value)
																		+SUM(ROUND((Fields!NONFAC_IDLE.Value +Fields!FAC_IDLE.Value+Fields!OFF_TTL.Value )* Fields!UPP_TGT.Value * Fields!RUNP_TGT.Value,2)))/
																		(SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value+Fields!CHMT.Value)
																		+SUM((Fields!NONFAC_IDLE.Value + Fields!FAC_IDLE.Value+Fields!OFF_TTL.Value)* Fields!UPP_TGT.Value))
																		,4))
																		*
																		(ROUND(IIF(SUM(Fields!NORMAL_ACT.Value)=0 OR SUM(Fields!TT.Value)=0 or SUM(Fields!M_RUN.Value)=0,0,(SUM(Fields!NORMAL_ACT.Value)/SUM(Fields!M_RUN.Value))/(3600*SUM(Fields!NORMAL_ACT.Value)/SUM(Fields!TT.Value))),4) ),4)*100) +"%")
																	</Value>
																	<Style>
