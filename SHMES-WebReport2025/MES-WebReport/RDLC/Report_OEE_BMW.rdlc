											<CellContents>
												<Textbox Name="Textbox210">
													<CanGrow>true</CanGrow>
													<KeepTogether>true</KeepTogether>
													<Paragraphs>
														<Paragraph>
															<TextRuns>
																<TextRun>
																	<Value>=CSTR( ROUND(ROUND( IIF(Fields!PROCESS.Value="COG",ROUND(IIF(SUM(24-Fields!OFF_TTL.Value)=0,0,SUM(Fields!UP_TTL.Value)/SUM(24-Fields!OFF_TTL.Value)),4),ROUND(SUM(Fields!UP_TTL.Value)/SUM(24),4))-iif(SUM(Fields!UP_TTL.Value)=0,0,ROUND(SUM( Fields!PSETUP.Value)/SUM(Fields!UP_TTL.Value),4)),4)*(ROUND(IIF(SUM(Fields!NORMAL_ACT.Value)=0 OR SUM(Fields!TT.Value)=0 OR SUM(Fields!M_RUN.Value)=0,Fields!UPHP_ACT.Value, (SUM(Fields!NORMAL_ACT.Value)/SUM(Fields!M_RUN.Value))/(3600*SUM(Fields!NORMAL_ACT.Value)/SUM(Fields!TT.Value))),4) )*(iif(Fields!Quality.Value=0,0,ROUND( Fields!Quality.Value,4))),4)*100)+"%"</Value>
																	<Style>
																		<FontFamily>新細明體</FontFamily>
																	</Style>
																</TextRun>
															</TextRuns>
