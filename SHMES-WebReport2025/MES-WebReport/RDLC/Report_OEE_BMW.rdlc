										<TablixCell>
											<CellContents>
												<Textbox Name="textbox198">
													<CanGrow>true</CanGrow>
													<KeepTogether>true</KeepTogether>
													<Paragraphs>
														<Paragraph>
															<TextRuns>
																<TextRun>
																	<Value>=CSTR(ROUND(iif(SUM(Fields!NORMAL_ACT.Value)=0,Fields!UPP_TGT.Value,SUM(Fields!NORMAL_ACT.Value * Fields!UPP_TGT.Value)/SUM(Fields!NORMAL_ACT.Value)),4)*100)+"%"</Value>
																	<Style>
																		<FontFamily>新細明體</FontFamily>
																	</Style>
																</TextRun>
															</TextRuns>
															<Style>
																<FontFamily />
																<TextAlign>Center</TextAlign>
															</Style>
														</Paragraph>
													</Paragraphs>
													<rd:DefaultName>textbox198</rd:DefaultName>
													<ZIndex>98</ZIndex>
													<Style>
														<Border>
															<Style>Solid</Style>
														</Border>
														<TopBorder>
															<Style>Solid</Style>
														</TopBorder>
														<BottomBorder>
															<Style>Solid</Style>
														</BottomBorder>
														<LeftBorder>
															<Style>Solid</Style>
														</LeftBorder>
														<RightBorder>
															<Style>Solid</Style>
														</RightBorder>
														<BackgroundColor>#8fa0b0</BackgroundColor>
														<VerticalAlign>Middle</VerticalAlign>
														<PaddingLeft>2pt</PaddingLeft>
														<PaddingRight>2pt</PaddingRight>
														<PaddingTop>2pt</PaddingTop>
														<PaddingBottom>2pt</PaddingBottom>
													</Style>
												</Textbox>
											</CellContents>
										</TablixCell>
										<TablixCell>
											<CellContents>
												<Textbox Name="textbox194">
													<CanGrow>true</CanGrow>
													<KeepTogether>true</KeepTogether>
													<Paragraphs>
														<Paragraph>
															<TextRuns>
																<TextRun>
																	<Value>
																		=IIF(Fields!PROCESS.Value="COG",CSTR(ROUND(IIF(SUM(24-Fields!OFF_TTL.Value)=0,0,SUM(Fields!UP_TTL.Value)/SUM(24-Fields!OFF_TTL.Value)),4)*100 )+"%",
																		CSTR(ROUND(SUM(Fields!UP_TTL.Value)/SUM(24),4)*100 )+"%"    )
																	</Value>
																	<Style>
																		<FontFamily>新細明體</FontFamily>
																	</Style>
																</TextRun>
															</TextRuns>
															<Style>
																<FontFamily />
																<TextAlign>Center</TextAlign>
