	<DataSets>
		<DataSet Name="DataSet1_WEDWM">
			<Query>
				<DataSourceName>connhis</DataSourceName>
				<CommandText>
					SELECT PROCESS,EQ_TYPE,EQUIP_ID AS EQ_ID,TGT_MOVE_PROD_QTY AS NORMAL_TGT,
					NORMALQTY AS NORMAL_ACT,ENGQTY AS ENG_TGT
					,TGT_UPH_MEAS AS UPH_TGT,UPH_MEAS AS UPH_ACT,OFFTIME_MEAS AS OFF_TTL
					,MRUN_MEAS AS M_RUN,ERUN_MEAS AS ERUN,ESETUP_MEAS AS ESETUP,PSETUP_MEAS AS PSETUP,
					CHG_MTL_MEAS AS CHMT,FAC_IDLE_MEAS AS FAC_IDLE,NONFAC_IDLE_MEAS AS NONFAC_IDLE
					,UP_TIME_MEAS AS UP_TTL,FAC_DOWN_MEAS AS FACEDOWN,REPAIR_MEAS AS REPAIR,PRD_DOWN_MEAS AS PRODOWN
					,ENG_MEAS AS ENG, PM_MEAS AS PM,WARM_UP_MEAS AS WARM_UP,DOWN_TIME_MEAS AS DOWN_TTL,
					UP_TIME_MEAS+DOWN_TIME_MEAS+OFFTIME_MEAS AS TOTAL_TTL,TGT_UP_RATE AS UPP_TGT,
					UP_RATE AS UPP_ACT,UP_MOD_RATE AS UPP_MODIFY,TGT_RUN_RATE AS RUNP_TGT,
					RUN_RATE AS RUNP_ACT,RUN_MOD_RATE AS RUNP_MODIFY,TGT_UPH_RATE AS UPHP_TGT,
					UPH_RATE AS UPHP_ACT,TGT_PSETUP_RATE AS PSETUPP_TGT,PSETUP_RATE AS PSERUPP_ACT,
					TGT_ELOT_RATE AS ELOTP_TGT,ELOT_RATE AS ELOTP_ACT,
					TGT_OEE_RATE AS OEEP_TGT,OEE_RATE AS OEEP_ACT,OEE_MOD_RATE AS OEEP_MODIFY
					FROM WEDWM
				</CommandText>
				<rd:UseGenericDesigner>true</rd:UseGenericDesigner>
			</Query>
