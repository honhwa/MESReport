										<TablixCell>
											<CellContents>
												<Textbox Name="Textbox217">
													<CanGrow>true</CanGrow>
													<KeepTogether>true</KeepTogether>
													<Paragraphs>
														<Paragraph>
															<TextRuns>
																<TextRun>
																	<Value>=CSTR(  ROUND( IIF(Fields!PROCESS.Value="COG",ROUND(IIF(SUM(24-Fields!OFF_TTL.Value)=0,0,SUM(Fields!UP_TTL.Value)/SUM(24-Fields!OFF_TTL.Value)),4)*100,ROUND(SUM(Fields!UP_TTL.Value)/SUM(24),4)*100)-iif(SUM(Fields!UP_TTL.Value)=0,0,ROUND(SUM( Fields!PSETUP.Value)/SUM(Fields!UP_TTL.Value),4) *100),4))+"%"</Value>
