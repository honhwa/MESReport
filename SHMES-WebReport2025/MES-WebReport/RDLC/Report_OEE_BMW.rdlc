													<Paragraphs>
														<Paragraph>
															<TextRuns>
																<TextRun>
																	<Value>=iif(Fields!OEE_Tgt.Value=0,0,CSTR(ROUND( Fields!OEE_Tgt.Value,4) *100) +"%")</Value>
																	<Style>
