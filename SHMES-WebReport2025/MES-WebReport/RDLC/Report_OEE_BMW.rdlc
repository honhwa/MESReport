															<TextRuns>
																<TextRun>
																	<Value>=CSTR(ROUND(iif(SUM(Fields!NORMAL_ACT.Value)=0,Fields!UPP_TGT.Value,SUM(Fields!NORMAL_ACT.Value * Fields!UPP_TGT.Value)/SUM(Fields!NORMAL_ACT.Value)),4)*100)+"%"</Value>
																	<Style>
																		<FontFamily>新細明體</FontFamily>
