													<Paragraphs>
														<Paragraph>
															<TextRuns>
																<TextRun>
																	<Value>
																		=IIF(Fields!PROCESS.Value="COG",CSTR(ROUND(IIF(SUM(24-Fields!OFF_TTL.Value)=0,0,SUM(Fields!UP_TTL.Value)/SUM(24-Fields!OFF_TTL.Value)),4)*100 )+"%",
																		CSTR(ROUND(SUM(Fields!UP_TTL.Value)/SUM(24),4)*100 )+"%"    )
																	</Value>
																	<Style>
