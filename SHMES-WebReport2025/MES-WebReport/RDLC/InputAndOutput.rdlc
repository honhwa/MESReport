  <rd:ReportID>6392fe0e-ad21-4c60-8a01-cbaa91746958</rd:ReportID>
  <LeftMargin>2.5cm</LeftMargin>
  <DataSets>
    <DataSet Name="InputAndOutput">
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>select rw.reportdate,rw.workctr,ctr.workname,sl.lineid,rw.prodid,rw.shiftid,'' as t9ncno, rw.prodgroup,rw.wonbr,rw.inputqty,
                       outputaqty +outputsqty+outputrqty as totalqty,outputaqty as outputqty from RWCIO rw 
                       inner join mslm sl  on  rw.fabid=sl.fabid and rw.sublineid=sl.sublineid inner join
                       mwcm ctr on rw.workctr=ctr.workctr and rw.fabid=ctr.fabid</CommandText>
        <DataSourceName>InputAndOutput</DataSourceName>
      </Query>
      <Fields>
        <Field Name="reportdate">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>reportdate</DataField>
        </Field>
        <Field Name="workctr">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>workctr</DataField>
        </Field>
        <Field Name="t9ncno">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>t9ncno</DataField>
        </Field>
        <Field Name="totalqty">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>totalqty</DataField>
        </Field>
        <Field Name="workname">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>workname</DataField>
        </Field>
        <Field Name="lineid">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>lineid</DataField>
        </Field>
        <Field Name="prodid">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>prodid</DataField>
        </Field>
        <Field Name="shiftid">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>shiftid</DataField>
        </Field>
        <Field Name="prodgroup">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>prodgroup</DataField>
        </Field>
        <Field Name="wonbr">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>wonbr</DataField>
        </Field>
        <Field Name="inputqty">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>inputqty</DataField>
        </Field>
        <Field Name="outputqty">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>outputqty</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
