  <rd:ReportID>33555462-07ea-4903-9bb9-ecdafcf82858</rd:ReportID>
  <LeftMargin>2.5cm</LeftMargin>
  <DataSets>
    <DataSet Name="IBEWipQueryForDetail">
      <rd:DataSetInfo>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:DataSetName>IBEWipQueryForDetail</rd:DataSetName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterName>WLTMTableAdapter</rd:TableAdapterName>
        <rd:TableName>WLTM</rd:TableName>
      </rd:DataSetInfo>
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>
			SELECT	CSHOPCD,N9NCNO,CPRODID,PLOTGRADE,CWORKCTR,WONBR,
			CASE WHEN CSHOPCD = 'CELL2' THEN C9NCNO ELSE N9NCNO END AS PRODID,
			C9NCNO,ENTITYID,ENTITYTQTY
			FROM EIF.WLTM
			WHERE MFGDATE = '2011-07-18'
			GROUP BY CSHOPCD,N9NCNO,CPRODID,PLOTGRADE,CWORKCTR,WONBR,C9NCNO,CSHOPCD,N9NCNO
			HAVING SUM(ENTITYTQTY)!=0
			ORDER BY CWORKCTR
		</CommandText>
        <DataSourceName>ConnectPRD</DataSourceName>
      </Query>
      <Fields>
        <Field Name="CSHOPCD">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CSHOPCD</DataField>
        </Field>
        <Field Name="N9NCNO">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>N9NCNO</DataField>
        </Field>
        <Field Name="CPRODID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CPRODID</DataField>
        </Field>
        <Field Name="PLOTGRADE">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PLOTGRADE</DataField>
        </Field>
        <Field Name="CWORKCTR">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CWORKCTR</DataField>
        </Field>
        <Field Name="WONBR">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>WONBR</DataField>
        </Field>
        <Field Name="PRODID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PRODID</DataField>
        </Field>
        <Field Name="C9NCNO">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>C9NCNO</DataField>
        </Field>
        <Field Name="ENTITYID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ENTITYID</DataField>
        </Field>
        <Field Name="ENTITYTQTY">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ENTITYTQTY</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
