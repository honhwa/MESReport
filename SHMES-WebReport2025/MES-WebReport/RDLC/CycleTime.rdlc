        <Field Name="WaitTime">
          <DataField>WaitTime</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="HoldTime">
          <DataField>HoldTime</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="AVGQTY">
          <DataField>AVGQTY</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TotalTime_H">
          <DataField>TotalTime_H</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TotalTime_D">
          <DataField>TotalTime_D</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>CycleTime</DataSourceName>
        <CommandText>SELECT ProdID,ReportDate AS Month_Week,
SUM(BankTime) AS BankTime,
SUM(RunTime) AS RunTime,
SUM(WaitTime) AS WaitTime,
SUM(HoldTime) AS HoldTime,
SUM(AVGQTY) AS AVGQTY,
SUM(BankTime)+SUM(RunTime)+SUM(WaitTime)+SUM(HoldTime) AS TotalTime_H,
CAST(((SUM(BankTime)+SUM(RunTime)+SUM(WaitTime)+SUM(HoldTime))/24) AS NUMERIC(10,2)) AS TotalTime_D
FROM RCYCLETIMES GROUP BY VERB,ProdID,ReportDate</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
