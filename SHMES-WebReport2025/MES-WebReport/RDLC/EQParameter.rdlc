      <Query>
        <DataSourceName>Connect10</DataSourceName>
        <CommandText>
			SELECT A.TRANSDATE,A.ENTITYID,A.SUBLINEID,A.PRODID,A.EQID,A.WORKCTR,A.PARAMETER,A.VALUE,A.USERID,A.TEAMID,B.CMT,A.OperationID
			FROM New_WEQPARAM A
			LEFT JOIN WSSD B ON A.ENTITYID=B.ENTITYID
		</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <rd:DataSetInfo>
