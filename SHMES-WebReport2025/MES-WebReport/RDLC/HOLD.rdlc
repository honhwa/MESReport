  <rd:ReportID>1408a7d3-cccf-49ed-877b-236fcf35d4e5</rd:ReportID>
  <LeftMargin>2.5cm</LeftMargin>
  <DataSets>
    <DataSet Name="HOLD_HOLD">
      <rd:DataSetInfo>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:DataSetName>HOLD</rd:DataSetName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterName>HOLDTableAdapter</rd:TableAdapterName>
        <rd:TableName>HOLD</rd:TableName>
      </rd:DataSetInfo>
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT         FABID, PRODID, WONBR, WORKCTR, SUM(ENTITYTQTY) AS QTY, LOTGRADE, 
                          HoldOwner, HoldDefectCD, WAITDAY, TIME_LIMIT
FROM             (SELECT         A.FABID, A.PRODID, A.WONBR, A.CWORKCTR AS WORKCTR, 
                                                      A.ENTITYTQTY, A.LOTGRADE, B.HoldOwner, B.HoldDefectCD, 
                                                      DATEDIFF(DAY, A.TRANSDATE, GETDATE()) AS WAITDAY, 
                                                      CASE WHEN A.LOTGRADE = 'A' THEN 3 WHEN A.LOTGRADE = 'R' THEN
                                                       7 WHEN A.LOTGRADE = 'S' THEN 3 ELSE 0 END AS TIME_LIMIT
                           FROM              eif.WLTM AS A INNER JOIN
                                                      rep.WHLD AS B ON A.FABID = B.FabID AND 
                                                      A.HOLDID = B.HoldID
                           WHERE          (A.FABID = 'A') AND (A.HIDEFLG = '0') AND (A.ENTITYSTS = 'H') AND
                                                       (ISNULL(A.HOLDID, '') &lt;&gt; '')) AS AA
GROUP BY  FABID, PRODID, WONBR, WORKCTR, LOTGRADE, HoldOwner, HoldDefectCD, 
                          WAITDAY, TIME_LIMIT</CommandText>
        <DataSourceName>Connect7</DataSourceName>
      </Query>
      <Fields>
        <Field Name="FABID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>FABID</DataField>
        </Field>
        <Field Name="PRODID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PRODID</DataField>
        </Field>
        <Field Name="QTY">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>QTY</DataField>
        </Field>
        <Field Name="LOTGRADE">
