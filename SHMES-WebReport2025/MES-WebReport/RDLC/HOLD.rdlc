          <DataField>LOTGRADE</DataField>
        </Field>
        <Field Name="HoldOwner">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>HoldOwner</DataField>
        </Field>
        <Field Name="HoldDefectCD">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>HoldDefectCD</DataField>
        </Field>
        <Field Name="WAITDAY">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>WAITDAY</DataField>
        </Field>
        <Field Name="TIME_LIMIT">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>TIME_LIMIT</DataField>
        </Field>
        <Field Name="Wonbr">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Wonbr</DataField>
        </Field>
        <Field Name="Workctr">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Workctr</DataField>
        </Field>
      </Fields>
    </DataSet>
