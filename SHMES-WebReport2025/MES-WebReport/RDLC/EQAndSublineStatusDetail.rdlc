  </Body>
  <rd:ReportID>b3c8259f-268b-41ca-8545-9329868e0062</rd:ReportID>
  <LeftMargin>2.5cm</LeftMargin>
  <DataSets>
    <DataSet Name="EQAndSublineStatusDetail">
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT SH.PRODID,SH.SHIFTID,SH.CMT,SH.EQID,SH.SUBLINEID,SH.WORKCTR,SH.EQCCD,SH.EQCD,  CASE WHEN CONVERT(DATETIME,CONVERT(VARCHAR(19),SH.STARTDATE,120))&lt;CONVERT(VARCHAR(19),'2008-02-14 18:37:35', 120)   THEN   CONVERT(VARCHAR(19),'2008-02-14 18:37:35', 120) ELSE  SH.STARTDATE END AS STARTDT ,  CASE WHEN CONVERT(DATETIME,CONVERT(VARCHAR(19),SH.ENDDATE,120))&lt;CONVERT(VARCHAR(19),'2008-07-14 18:38:17', 120) THEN  SH.ENDDATE ELSE CONVERT(VARCHAR(19),'2008-07-14 18:38:17', 120) END AS ENDDT,'' AS SUMDATE,SH.USERID+'  / '+EM.USERNAME AS USERID FROM New_EQSHM SH   LEFT JOIN MEMM EM ON SH.FABID=EM.FABID AND SH.USERID=EM.USERID WHERE  ((CONVERT(VARCHAR(19),SH.STARTDATE,120) BETWEEN CONVERT(VARCHAR(19),'2008-02-14 18:37:35', 120)  AND CONVERT(VARCHAR(19),'2008-07-14 18:38:17', 120)AND SH.SUBLINEID NOT IN ('BMXXX-01','BCXXX-01'))  OR  (CONVERT(VARCHAR(19),SH.ENDDATE,120) BETWEEN CONVERT(VARCHAR(19),'2008-02-14 18:37:35', 120)  AND CONVERT(VARCHAR(19),'2008-07-14 18:38:17', 120) AND SH.SUBLINEID NOT IN ('BMXXX-01','BCXXX-01'))  OR (CONVERT(VARCHAR(19),SH.ENDDATE,120) &gt; CONVERT(VARCHAR(19),'2008-07-14 18:38:17', 120) AND CONVERT(VARCHAR(19),SH.STARTDATE,120) &lt; CONVERT(VARCHAR(19),'2008-02-14 18:37:35', 120))) AND SH.FABID= 'B' AND SH.SHOPCD= 'MODULE' AND SH.WORKCTR IN ('8180','8190','8280','8380','8450','8501','8600','8700','8800','9001','CTR1','MR0A','MR0B','MR0C','MS0S','OR01','ORPK','RS01','RS02','WR01')</CommandText>
        <DataSourceName>EQAndSublineStatusDetail</DataSourceName>
      </Query>
      <Fields>
        <Field Name="EQID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>EQID</DataField>
        </Field>
