  <rd:ReportID>28928cc9-dfe4-414d-90e2-8cdda4570319</rd:ReportID>
  <LeftMargin>2.5cm</LeftMargin>
  <DataSets>
    <DataSet Name="OEE_EXEC_LOG">
      <rd:DataSetInfo>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:DataSetName>OEE_EXEC_LOG</rd:DataSetName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterName>OEE_EXEC_LOGTableAdapter</rd:TableAdapterName>
        <rd:TableName>OEE_EXEC_LOG</rd:TableName>
      </rd:DataSetInfo>
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>
			SELECT	A.FABID,A.USERID,B.USERNAME,
			case A.ISEXEC_OK
			when 0 then '否'
			when 1 then '是'
			END AS ISEXEC_OK,A.CMT,A.EXEC_DATE,A.TIME_STAMP
			FROM R_OEE_EXEC_LOG A,MEMM B
			WHERE A.USERID=B.USERID
		</CommandText>
        <DataSourceName>Connect7</DataSourceName>
      </Query>
      <Fields>
        <Field Name="FABID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>FABID</DataField>
        </Field>
        <Field Name="USERID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>USERID</DataField>
        </Field>
        <Field Name="USERNAME">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>USERNAME</DataField>
        </Field>
        <Field Name="ISEXEC_OK">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ISEXEC_OK</DataField>
        </Field>
        <Field Name="CMT">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CMT</DataField>
        </Field>
        <Field Name="EXEC_DATE">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>EXEC_DATE</DataField>
        </Field>
        <Field Name="TIME_STAMP">
          <rd:TypeName>System.DATETIME</rd:TypeName>
          <DataField>TIME_STAMP</DataField>
        </Field>
      </Fields>
    </DataSet>
