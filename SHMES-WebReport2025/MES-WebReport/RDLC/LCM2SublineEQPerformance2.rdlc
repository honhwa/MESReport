+val(Fields!IDLETIME.Value)
+val(Fields!WAITTIME.Value)
+val(Fields!SETUPTIME.Value)
+val(Fields!ENGTIME.Value)
+val(Fields!OTHERTIME.Value))=0,0 ,val(Fields!RUNTIME.Value)/(val(Fields!PDUPTIME.Value)
+val(Fields!RUNTIME.Value)
+val(Fields!IDLETIME.Value)
+val(Fields!WAITTIME.Value)
+val(Fields!SETUPTIME.Value)
+val(Fields!ENGTIME.Value)
+val(Fields!OTHERTIME.Value))))</Value>
