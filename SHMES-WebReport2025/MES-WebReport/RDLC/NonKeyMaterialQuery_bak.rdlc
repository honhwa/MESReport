  <rd:ReportID>0dc9932c-0bd7-4ac8-890f-cda56161a2f6</rd:ReportID>
  <LeftMargin>2.5cm</LeftMargin>
  <DataSets>
    <DataSet Name="NonKeyMaterialQuery">
      <rd:DataSetInfo>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:DataSetName>DataSet1</rd:DataSetName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterName>DataTable1TableAdapter</rd:TableAdapterName>
        <rd:TableName>DataTable1</rd:TableName>
      </rd:DataSetInfo>
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>
			SELECT A.PRODID,A.CWORKCTR,SUM(A.ENTITYTQTY) AS ENTITYTQTY,C.PARTID,C.PARTTYPE,D.PARTQTY,SUM(A.ENTITYTQTY*D.PARTQTY) AS QTY
			FROM WLTM A, New_SAPSWMPD B, MNKPAM C, MNKMQM D
			WHERE A.FABID = B.FABID
			AND A.FABID = C.FABID
			AND A.FABID = D.FABID
			AND A.WONBR = B.WONBR
			AND B.PARTID = C.PARTID
			AND A.PRODID = D.PRODID
			AND A.CWORKCTR = D.WORKCTR
			AND C.PARTTYPE = D.PARTTYPE
			AND A.FABID = 'A' AND A.HIDEFLG = '0'
			GROUP BY A.PRODID,A.CWORKCTR,C.PARTID,C.PARTTYPE,D.PARTQTY</CommandText>
        <DataSourceName>Connect10</DataSourceName>
      </Query>
      <Fields>
        <Field Name="PRODID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PRODID</DataField>
        </Field>
        <Field Name="CWORKCTR">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CWORKCTR</DataField>
        </Field>
        <Field Name="ENTITYTQTY">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>ENTITYTQTY</DataField>
        </Field>
        <Field Name="PARTID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PARTID</DataField>
        </Field>
        <Field Name="PARTTYPE">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PARTTYPE</DataField>
        </Field>
        <Field Name="PARTQTY">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>PARTQTY</DataField>
        </Field>
        <Field Name="QTY">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>QTY</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
