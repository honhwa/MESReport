  <rd:ReportID>6f9d6e3e-bece-4a38-a75b-28bfe4b8458a</rd:ReportID>
  <LeftMargin>2.5cm</LeftMargin>
  <DataSets>
    <DataSet Name="OQCPieceBlock">
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>
			SELECT A.ENTITYID,A.SOLOTID,A.WONBR,A.CARTID,b.SerialNo,ISNULL(C.LOTID,A.ENTITYID)AS PANELID,A.ENTITYTQTY,A.BANKID,A.TRANSDATE,A.PRODID
			FROM dbo.WLTM A
			left JOIN New_WCMSD B ON A.CARTID=b.CARTID
			LEFT JOIN New_FILEPARM c ON b.SerialNo=c.SN
		</CommandText>
        <DataSourceName>DataSource1</DataSourceName>
      </Query>
      <Fields>
        <Field Name="PANELID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PANELID</DataField>
        </Field>
        <Field Name="SerialNo">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>SerialNo</DataField>
        </Field>
        <Field Name="SOLOTID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>SOLOTID</DataField>
        </Field>
        <Field Name="WONBR">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>WONBR</DataField>
        </Field>
        <Field Name="CARTID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CARTID</DataField>
        </Field>
        <Field Name="ENTITYTQTY">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ENTITYTQTY</DataField>
        </Field>
        <Field Name="BANKID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>BANKID</DataField>
        </Field>
        <Field Name="TRANSDATE">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>TRANSDATE</DataField>
        </Field>
        <Field Name="PRODID">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>PRODID</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
