  <DataSets>
    <DataSet Name="localReport">
      <Fields>
        <Field Name="MFGDATE">
          <DataField>MFGDATE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TOPRODID">
          <DataField>TOPRODID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SHIFTID">
          <DataField>SHIFTID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CSUBLIEID">
          <DataField>CSUBLIEID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PUTTYPE">
          <DataField>PUTTYPE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TOLOTGRADE">
          <DataField>TOLOTGRADE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DEFECTCD">
          <DataField>DEFECTCD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ENTITYQTY">
          <DataField>ENTITYQTY</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>localReport</DataSourceName>
        <CommandText>SELECT H.MFGDATE,H.TOPRODID,H.SHIFTID,H.CSUBLIEID,H.PUTTYPE,H.TOLOTGRADE,H.DEFECTCD,SUM(H.ENTITYQTY) AS ENTITYQTY FROM (  SELECT convert(char(10), MFGDATE,20) as MFGDATE ,SHIFTID,TOPRODID,TOLOTGRADE,   NSubLineID AS CSUBLIEID ,DEFECTCD, 'INPUT' AS PUTTYPE,   (sum(case when VERB in ('MVIN') then NENTITYTQTY else 0 end)+  sum(case when VERB in ('MTAH') AND NSubLineID&lt;&gt;CSubLineID then NENTITYTQTY else 0 end)+  sum(case when VERB in ('MTUH') AND NSubLineID&lt;&gt;CSubLineID then NENTITYTQTY else 0 end)) AS ENTITYQTY  FROM WLTX WHERE FABID='B'   AND ( (VERB ='MVIN') OR ( VERB In ('MTAH','MTUH') AND NSubLineID&lt;&gt;CSubLineID ))   AND NSubLineID in ('REWORK-M1','REWORK-M2','REWORK-M3') AND CWORKCTR in ('MR0A','MR0B','MR0C') AND NWORKCTR in ('MR0A','MR0B','MR0C')  AND TOPRODID IN ('','','AP024T0Y004','TJ018LUE001','TJ018LUE003','TJ018LUE006','TJ018TUE011','TJ018TUE013','TJ020KVE001','TK018KUE001','TK018LUE001','TK018LUE003','TK018LUE004','TK020SVE001','TP024T0Y003') AND MFGDATE BETWEEN '2008-05-13 00:00:00.000' AND '2008-05-13 00:00:00.000'  GROUP BY MFGDATE,SHIFTID,TOPRODID,TOLOTGRADE,NSubLineID ,DEFECTCD  UNION SELECT convert(char(10), MFGDATE,20) as MFGDATE ,SHIFTID,TOPRODID,TOLOTGRADE,  CSubLineID,DEFECTCD,'OUTPUT' AS PUTTYPE,SUM(NENTITYTQTY) AS ENTITYQTY   FROM WLTX WHERE FABID='B'  AND VERB  IN ('MTAH','MTUH')   AND CSubLineID IN ('REWORK-M1','REWORK-M2','REWORK-M3') AND CWORKCTR IN ('MR0A','MR0B','MR0C') AND CWORKCTR=NWORKCTR   AND CSubLineID&lt;&gt;NSubLineID AND TOPRODID IN ('','','AP024T0Y004','TJ018LUE001','TJ018LUE003','TJ018LUE006','TJ018TUE011','TJ018TUE013','TJ020KVE001','TK018KUE001','TK018LUE001','TK018LUE003','TK018LUE004','TK020SVE001','TP024T0Y003') AND MFGDATE BETWEEN '2008-05-13 00:00:00.000' AND '2008-05-13 00:00:00.000'  GROUP BY MFGDATE,SHIFTID,TOPRODID,TOLOTGRADE,CSubLineID,DEFECTCD  UNION   SELECT convert(char(10), MFGDATE,20) as MFGDATE ,SHIFTID,TOPRODID,TOLOTGRADE, CSUBLINEID,DEFECTCD,'OUTPUT' AS PUTTYPE ,SUM(NENTITYTQTY) AS ENTITYQTY  FROM WLTX WHERE FABID='B' AND VERB='MVOU' AND CSUBLINEID IN ('REWORK-M1','REWORK-M2','REWORK-M3')  AND CWORKCTR IN ('MR0A','MR0B','MR0C') AND TOPRODID IN ('','','AP024T0Y004','TJ018LUE001','TJ018LUE003','TJ018LUE006','TJ018TUE011','TJ018TUE013','TJ020KVE001','TK018KUE001','TK018LUE001','TK018LUE003','TK018LUE004','TK020SVE001','TP024T0Y003') AND TOLOTGRADE='A'   AND MFGDATE BETWEEN '2008-05-13 00:00:00.000' AND '2008-05-13 00:00:00.000'  GROUP BY MFGDATE,SHIFTID,TOPRODID,TOLOTGRADE,CSUBLINEID,DEFECTCD  UNION  SELECT convert(char(10), B.MFGDATE,20) as MFGDATE,B.SHIFTID,B.PRODID AS TOPRODID, B.LOTGRADE AS TOLOTGRADE,B.CSUBLINEID AS CSUBLINEID,B.DEFECTCD AS DEFECTCD,'OUTPUT' as PTYTYPE,  SUM(B.DEFECTQTY) AS ENTITYQTY FROM WLTX A,New_WLDX B    WHERE B.FABID='B' AND B.CSUBLINEID in ('REWORK-M1','REWORK-M2','REWORK-M3') AND B.CWORKCTR in ('MR0A','MR0B','MR0C') AND B.LOTGRADE='S'   AND B.CSHOPCD='MODULE' AND B.PRODID IN ('','','AP024T0Y004','TJ018LUE001','TJ018LUE003','TJ018LUE006','TJ018TUE011','TJ018TUE013','TJ020KVE001','TK018KUE001','TK018LUE001','TK018LUE003','TK018LUE004','TK020SVE001','TP024T0Y003') AND B.MFGDATE BETWEEN '2008-05-13 00:00:00.000' AND '2008-05-13 00:00:00.000'  AND A.FABID=B.FABID AND A.CSUBLINEID=B.CSUBLINEID AND A.TRANSID=B.TRANSID  AND A.CWORKCTR=B.CWORKCTR AND A.TOENTITYID=ENTITYID AND A.VERB='MVOU' AND A.TOLOTGRADE='S'  AND B.DEFECTQTY&gt;0  GROUP BY B.MFGDATE,B.SHIFTID,B.PRODID,B.CSUBLINEID,B.LOTGRADE,B.DEFECTCD  ) H  GROUP BY H.MFGDATE,H.TOPRODID,H.SHIFTID,H.CSUBLIEID,H.PUTTYPE,H.TOLOTGRADE,H.DEFECTCD</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
  <Width>20.31746cm</Width>
