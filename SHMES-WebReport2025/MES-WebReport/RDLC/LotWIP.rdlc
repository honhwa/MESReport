        <CommandText>SELECT FABID, ENTITYID, ENTITYUNIT, RTGCD, PWORKCTR, CWORKCTR, PENTITYSTS, ENTITYSTS, PLOTGRADE, PLOTLEVEL, LOTGRADE, LOTLEVEL, DEFECTCD, ENTITYTQTY, SubWorkCtr, SubENTITYSTS, HIDEFLG, PRODID, N9NCNO, WOTYPE, WONBR, RMANO, LOTTYPE, LOTPTY, TRANSDATE, PENTITYQTY, PENTITYUNIT, BOMVersion, SOLOTID, SOPRODID, SO9NCNO, SOFAB, SOBANK, SOGRADE, SOLEVEL, SOLOTTYPE, SOPACKFLG, SOBatchID, CPRODID, C9NCNO, WOPSTARTDATE, WOPDUEDATE, ENTITYCARRY, ENTITYPOS, MLOTID, PACKLOTID, PLOTID, RLOTID, LIDTYPE, LARGESN, GROUPID, QANBR, DCARTID, CARTID, BOXID, PALLETID, ReasonCD, STARTDATE, DUEDATE, TRANSID, TRANSSeq, TRANSMonth, TRANSWeek, TRACKINDATE, TRACKOUTDATE, RunCardID, TeamID, USERID, TrackINTeamID, TRACKINUSERID, SHIFTID, RRTGCD, OPRSEQNO, MAXOPRSEQ, PSHOPCD, CSHOPCD, PPROCID, CPROCID, CAUCTR, RWKCTR, RWKCNT, HOLDCD, HOLDCTR, FHOLDID, HOLDID, BANKID, STORAGEID, PACKFLG, UNITTRACEFLG, SALEORDER, CUSTOMERID, PSubLineID, SubLineID, LineID, EQID, PASSBOXID, SNFLG, USGFLG, AgingID, ListID, ListType, WOOWNER, LOTOWNER, ReworkFlg, ScrapMode, ToLocation, PostingDate, MFGDATE FROM eif.WLTM WHERE (FABID = 'B') AND (HIDEFLG = '0') AND (ENTITYID = '027N1AA00004CY') ORDER BY ENTITYID</CommandText>
