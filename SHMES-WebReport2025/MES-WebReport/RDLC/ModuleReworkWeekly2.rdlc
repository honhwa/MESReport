  <DataSets>
    <DataSet Name="localReport">
      <Fields>
        <Field Name="MFGDATE">
          <DataField>MFGDATE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TOPRODID">
          <DataField>TOPRODID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SHIFTID">
          <DataField>SHIFTID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CSUBLIEID">
          <DataField>CSUBLIEID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PUTTYPE">
          <DataField>PUTTYPE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TOLOTGRADE">
          <DataField>TOLOTGRADE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ENTITYQTY">
          <DataField>ENTITYQTY</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DEFECTCD">
          <DataField>DEFECTCD</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>localReport</DataSourceName>
        <CommandText>SELECT H.MFGDATE,H.TOPRODID,H.SHIFTID,H.CSUBLIEID,H.PUTTYPE,H.TOLOTGRADE,SUM(H.ENTITYQTY)AS ENTITYQTY,H.DEFECTCD
FROM 
(
 SELECT convert(char(10), MFGDATE,20) as MFGDATE,SHIFTID,TOPRODID,TOLOTGRADE,  SUM(NENTITYTQTY) AS ENTITYQTY  ,  NSubLineID AS CSUBLIEID ,DEFECTCD, 'INPUT' AS PUTTYPE   FROM WLTX WHERE FABID='B'  AND VERB In ('MVIN','MTAH','MTUH' )   AND NSubLineID in ('REWORK-M1','REWORK-M2','REWORK-M3') AND NWORKCTR in ('MR0A','MR0B','MR0C')  AND TOPRODID IN ('','','AP024T0Y004','TJ018LUE001','TJ018LUE003','TJ018LUE006','TP024T0Y003') AND MFGDATE BETWEEN '2008-02-02 00:00:00.000' AND '2008-02-07 00:00:00.000'  GROUP BY MFGDATE,SHIFTID,TOPRODID,TOLOTGRADE,NSubLineID ,DEFECTCD 
 UNION SELECT convert(char(10), MFGDATE,20) as MFGDATE ,SHIFTID,TOPRODID,TOLOTGRADE,  SUM(NENTITYTQTY) AS ENTITYQTY,CSubLineID,DEFECTCD,'OUTPUT' AS PUTTYPE   FROM WLTX WHERE FABID='B'  AND VERB  IN ('MTAH','MTUH')   AND CSubLineID IN ('REWORK-M1','REWORK-M2','REWORK-M3') AND CWORKCTR IN ('MR0A','MR0B','MR0C') AND CWORKCTR=NWORKCTR   AND CSubLineID&lt;&gt;NSubLineID AND TOPRODID IN ('','','AP024T0Y004','TJ018LUE001','TJ018LUE003','TJ018LUE006','TP024T0Y003') AND MFGDATE BETWEEN '2008-02-02 00:00:00.000' AND '2008-02-07 00:00:00.000'  GROUP BY MFGDATE,SHIFTID,TOPRODID,TOLOTGRADE,CSubLineID,DEFECTCD
			UNION  SELECT convert(char(10), MFGDATE,20) as MFGDATE ,SHIFTID,TOPRODID,TOLOTGRADE,SUM(NENTITYTQTY) AS ENTITYQTY,  CSUBLINEID,DEFECTCD,'OUTPUT' AS PUTTYPE  FROM WLTX WHERE FABID='B' AND VERB='MVOU' AND CSUBLINEID IN ('REWORK-M1','REWORK-M2','REWORK-M3')  AND CWORKCTR IN ('MR0A','MR0B','MR0C') AND TOPRODID IN ('','','AP024T0Y004','TJ018LUE001','TJ018LUE003','TJ018LUE006','TP024T0Y003') AND TOLOTGRADE='A'   AND MFGDATE BETWEEN '2008-02-02 00:00:00.000' AND '2008-02-07 00:00:00.000'  GROUP BY MFGDATE,SHIFTID,TOPRODID,TOLOTGRADE,CSUBLINEID,DEFECTCD
			UNION  SELECT convert(char(10), MFGDATE,20) as MFGDATE ,SHIFTID,PRODID AS TOPRODID,LOTGRADE AS TOLOTGRADE,SUM(DEFECTQTY) AS ENTITYQTY,CSUBLINEID ,DEFECTCD ,'OUTPUT' as PTYTYPE  FROM New_WLDX WHERE FABID='B' AND CSUBLINEID in ('REWORK-M1','REWORK-M2','REWORK-M3') AND CWORKCTR in ('MR0A','MR0B','MR0C') AND LOTGRADE='S'   AND CSHOPCD='MODULE' AND PRODID IN ('','','AP024T0Y004','TJ018LUE001','TJ018LUE003','TJ018LUE006','TP024T0Y003') AND MFGDATE BETWEEN '2008-02-02 00:00:00.000' AND '2008-02-07 00:00:00.000'  GROUP BY PRODID,CSUBLINEID,LOTGRADE,MFGDATE,SHIFTID,DEFECTCD
			)H
			GROUP BY H.MFGDATE,H.TOPRODID,H.SHIFTID,H.CSUBLIEID,H.PUTTYPE,H.TOLOTGRADE,H.DEFECTCD</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
