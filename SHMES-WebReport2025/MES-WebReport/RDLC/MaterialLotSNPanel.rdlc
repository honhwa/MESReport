  </Body>
  <rd:ReportID>dd711c78-c3d2-4486-a4e1-2c877ebe2681</rd:ReportID>
  <LeftMargin>2.5cm</LeftMargin>
  <DataSets>
    <DataSet Name="MaterialLotSNPanel_WPKX">
      <rd:DataSetInfo>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:DataSetName>MaterialLotSNPanel</rd:DataSetName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterName>WPKXTableAdapter</rd:TableAdapterName>
        <rd:TableName>WPKX</rd:TableName>
      </rd:DataSetInfo>
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT FABID,TransDate , PRODID,ENTITYID,PARTID,PARTTYPE,SUBSTRING(PARTLOTID,0,CASE WHEN PATINDEX('%/%',PARTLOTID)&lt;0 THEN 0 ELSE  PATINDEX('%/%',PARTLOTID) END) as PARTLOTID,SUBSTRING(PARTLOTID,PATINDEX('%/%',PARTLOTID)+1,LEN(PARTLOTID))AS PARTSN,SUBLINEID,WONBR,WORKCTR,USERID,SHIFTID ,CMT  FROM  New_WPKX WHERE PRODID IN (SELECT PRODID FROM MPIM WHERE PFLAG&lt;&gt;'0') AND TRANSDATE&gt;='2009-07-01  19:58:18' AND TRANSDATE&lt;='2010-07-22  19:58:20' AND SUBSTRING(PARTLOTID,0,CASE WHEN PATINDEX('%/%',PARTLOTID)&lt;0 THEN 0 ELSE  PATINDEX('%/%',PARTLOTID) END) ='402000375' ORDER BY TRANSDATE,PRODID</CommandText>
        <DataSourceName>Connect10</DataSourceName>
      </Query>
      <Fields>
        <Field Name="FABID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>FABID</DataField>
        </Field>
        <Field Name="TransDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>TransDate</DataField>
        </Field>
        <Field Name="PRODID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PRODID</DataField>
        </Field>
        <Field Name="ENTITYID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ENTITYID</DataField>
        </Field>
        <Field Name="PARTID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PARTID</DataField>
        </Field>
