		<!--<add name="Connect7" connectionString="Data Source=10.119.8.132\MESHIS;Initial Catalog=shmeshis;Persist Security Info=True;User ID=shhis;password=sh#his!021;Max Pool Size=10;Min Pool Size=5;Pooling=True;" providerName="System.Data.SqlClient"/>-->
		<!--<add name="ConnectPRD" connectionString="Data Source=10.119.8.243,14335\SHMESWIP;Initial Catalog=SHMESWIP;Persist Security Info=True;User ID=DTMESAP05;password=asqs98jk9*k!" providerName="System.Data.SqlClient" />-->
