      <Query>
        <DataSourceName>REPORTRMDDQUERY</DataSourceName>
        <CommandText>SELECT ReportDate,WORKCTR,PRODGROUP,TEAMMODE,REPORTUSERID+REPORTUSERNAME AS USERID,TEAMID,SUBLINEID,PRODID,LOTTYPE,ACTINPUT  
AOUTPUT,WORKINGHOUR,MANPOWER,(WORKINGHOUR*MANPOWER)/10 AS MANPOWER1,
STDINPUT,UPSQTY,
CASE WHEN AOUTPUT=0 THEN 0 ELSE UPSQTY/AOUTPUT END AS UPSRATE,LPSQTY, 
CASE WHEN AOUTPUT=0 THEN 0 ELSE LPSQTY/AOUTPUT END AS LPSRATE,ICSQTY,
CASE WHEN AOUTPUT=0 THEN 0 ELSE ICSQTY/AOUTPUT END AS ICSRATE,FPSQTY, 
CASE WHEN AOUTPUT=0 THEN 0 ELSE FPSQTY/AOUTPUT END AS FPSRATE,BLSQTY,
CASE WHEN AOUTPUT=0 THEN 0 ELSE (BLSQTY/AOUTPUT) END AS BLSRATE,WBSQTY,
CASE WHEN AOUTPUT=0 THEN 0 ELSE WBSQTY/AOUTPUT  END AS WBSRATE,TPSQTY,
CASE WHEN AOUTPUT=0 THEN 0 ELSE TPSQTY/AOUTPUT END AS TPSRATE  ,
CASE WHEN AOUTPUT=0 THEN 0 ELSE (UPSQTY/AOUTPUT+LPSQTY/AOUTPUT+ICSQTY/AOUTPUT+FPSQTY/AOUTPUT + BLSQTY/AOUTPUT +  WBSQTY/AOUTPUT + TPSQTY/AOUTPUT) END AS TMSRATE, 
ACTINPUT,AOUTPUT,SOUTPUT ,
CASE WHEN ACTINPUT=0 THEN 0 ELSE SOUTPUT/ACTINPUT  END AS SRATE,SDEFECTCD,ROUTPUT,
CASE WHEN ACTINPUT=0 THEN 0 ELSE ROUTPUT/ACTINPUT END AS RRATE, 
CASE WHEN ACTINPUT=0 THEN '100%' ELSE  CONVERT(VARCHAR,(ACTINPUT-SOUTPUT-ROUTPUT)*100/ACTINPUT)+'%'  END AS YIELD,  
CASE WHEN ACTINPUT+STDINPUT=0 THEN '' WHEN  ACTINPUT-STDINPUT&gt;-50 THEN 'OK' ELSE CONVERT(VARCHAR,ACTINPUT-STDINPUT) END AS CAPALOSS   
FROM RMDD</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
