                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                          <ZIndex>139</ZIndex>
                          <CanGrow>true</CanGrow>
                          <Value>=IIF(Fields!PROCESS.Value="COG",CSTR(ROUND(IIF(SUM(24-Fields!OFF_TTL.Value)=0,0,SUM(Fields!UP_TTL.Value)/SUM(24-Fields!OFF_TTL.Value)),4)*100 )+"%",
          CSTR(ROUND(SUM(Fields!UP_TTL.Value)/SUM(24),4)*100 )+"%"    )</Value>
                        </Textbox>
                      </ReportItems>
                    </TableCell>
                    <TableCell>
                      <ReportItems>
                        <Textbox Name="textbox260">
                          <rd:DefaultName>textbox260</rd:DefaultName>
                          <Style>
                            <BackgroundColor>SlateGray</BackgroundColor>
                            <BorderStyle>
                              <Default>Solid</Default>
                            </BorderStyle>
                            <FontFamily>新細明體</FontFamily>
                            <TextAlign>Center</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                          <ZIndex>138</ZIndex>
                          <CanGrow>true</CanGrow>
                          <Value>=IIF(Fields!PROCESS.Value="COG",CSTR(ROUND((SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value+Fields!CHMT.Value) 
+SUM((Fields!FAC_IDLE.Value+Fields!NONFAC_IDLE.Value) * Fields!UPP_TGT.Value))/
SUM((24-Fields!OFF_TTL.Value)),4)*100) +"%",
 CSTR(ROUND((SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value+Fields!CHMT.Value) 
+SUM((Fields!FAC_IDLE.Value+Fields!NONFAC_IDLE.Value+Fields!OFF_TTL.Value) * Fields!UPP_TGT.Value))/
SUM(24),4)*100)+"%")</Value>
                        </Textbox>
                      </ReportItems>
                    </TableCell>
