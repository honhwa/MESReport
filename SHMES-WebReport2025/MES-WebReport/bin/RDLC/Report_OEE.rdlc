                          <Value>=CSTR(ROUND(IIF(SUM(Fields!NORMAL_ACT.Value)=0,Fields!RUNP_TGT.Value,SUM(Fields!NORMAL_ACT.Value * Fields!RUNP_TGT.Value)/SUM(Fields!NORMAL_ACT.Value)),4)*100)+"%"</Value>
