                          <CanGrow>true</CanGrow>
                          <Value>=cstr(round(ROUND(IIF(SUM(24-Fields!OFF_TTL.Value)=0,0,SUM(Fields!UP_TTL.Value)/SUM(24-Fields!OFF_TTL.Value)),4)*
ROUND(IIF(SUM(Fields!UP_TTL.Value)=0,0,SUM( Fields!M_RUN.Value)/SUM(Fields!UP_TTL.Value)),4)*
ROUND(IIF(SUM(Fields!NORMAL_ACT.Value)=0 or SUM(Fields!TT.Value)=0 or SUM(Fields!M_RUN.Value)=0,0,(SUM(Fields!NORMAL_ACT.Value)/SUM(Fields!M_RUN.Value))/(3600*SUM(Fields!NORMAL_ACT.Value)/SUM(Fields!TT.Value))),4),4) *100)+"%"</Value>
