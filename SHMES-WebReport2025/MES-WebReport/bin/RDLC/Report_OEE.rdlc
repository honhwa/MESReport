                    <TableCell>
                      <ReportItems>
                        <Textbox Name="textbox174">
                          <rd:DefaultName>textbox174</rd:DefaultName>
                          <Style>
                            <BackgroundColor>#6e9eca</BackgroundColor>
                            <BorderStyle>
                              <Default>Solid</Default>
                              <Left>Solid</Left>
                              <Right>Solid</Right>
                              <Top>Solid</Top>
                              <Bottom>Solid</Bottom>
                            </BorderStyle>
                            <FontFamily>新細明體</FontFamily>
                            <TextAlign>Center</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                          <ZIndex>182</ZIndex>
                          <CanGrow>true</CanGrow>
                          <Value>=CSTR(ROUND(iif(SUM(Fields!NORMAL_ACT.Value)=0,Fields!UPP_TGT.Value,SUM(Fields!NORMAL_ACT.Value * Fields!UPP_TGT.Value)/SUM(Fields!NORMAL_ACT.Value)),4)*100)+"%"</Value>
                        </Textbox>
                      </ReportItems>
                    </TableCell>
                    <TableCell>
                      <ReportItems>
                        <Textbox Name="textbox175">
                          <rd:DefaultName>textbox175</rd:DefaultName>
                          <Style>
                            <BackgroundColor>#6e9eca</BackgroundColor>
                            <BorderStyle>
                              <Default>Solid</Default>
                              <Left>Solid</Left>
                              <Right>Solid</Right>
                              <Top>Solid</Top>
                              <Bottom>Solid</Bottom>
                            </BorderStyle>
                            <FontFamily>新細明體</FontFamily>
                            <TextAlign>Center</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                          <ZIndex>181</ZIndex>
                          <CanGrow>true</CanGrow>
                          <Value>=IIF(Fields!PROCESS.Value="COG",CSTR(ROUND(IIF(SUM(24-Fields!OFF_TTL.Value)=0,0,SUM(Fields!UP_TTL.Value)/SUM(24-Fields!OFF_TTL.Value)),4)*100 )+"%",
          CSTR(ROUND(SUM(Fields!UP_TTL.Value)/SUM(24),4)*100 )+"%"    )</Value>
                        </Textbox>
                      </ReportItems>
                    </TableCell>
                    <TableCell>
                      <ReportItems>
                        <Textbox Name="textbox176">
                          <rd:DefaultName>textbox176</rd:DefaultName>
                          <Style>
                            <BackgroundColor>#6e9eca</BackgroundColor>
                            <BorderStyle>
                              <Default>Solid</Default>
                              <Left>Solid</Left>
                              <Right>Solid</Right>
                              <Top>Solid</Top>
                              <Bottom>Solid</Bottom>
                            </BorderStyle>
                            <FontFamily>新細明體</FontFamily>
                            <TextAlign>Center</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                          <ZIndex>180</ZIndex>
                          <CanGrow>true</CanGrow>
                          <Value>=IIF(Fields!PROCESS.Value="COG",CSTR(ROUND((SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value+Fields!CHMT.Value) 
+SUM((Fields!FAC_IDLE.Value+Fields!NONFAC_IDLE.Value) * Fields!UPP_TGT.Value))/
SUM((24-Fields!OFF_TTL.Value)),4)*100) +"%",
 CSTR(ROUND((SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value+Fields!CHMT.Value) 
+SUM((Fields!FAC_IDLE.Value+Fields!NONFAC_IDLE.Value+Fields!OFF_TTL.Value) * Fields!UPP_TGT.Value))/
SUM(24),4)*100)+"%")</Value>
                        </Textbox>
                      </ReportItems>
                    </TableCell>
                    <TableCell>
                      <ReportItems>
                        <Textbox Name="textbox177">
                          <rd:DefaultName>textbox177</rd:DefaultName>
                          <Style>
                            <BackgroundColor>#6e9eca</BackgroundColor>
                            <BorderStyle>
                              <Default>Solid</Default>
                              <Left>Solid</Left>
                              <Right>Solid</Right>
                              <Top>Solid</Top>
                              <Bottom>Solid</Bottom>
                            </BorderStyle>
                            <FontFamily>新細明體</FontFamily>
                            <TextAlign>Center</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                          <ZIndex>179</ZIndex>
                          <CanGrow>true</CanGrow>
                          <Value>=CSTR(ROUND(IIF(SUM(Fields!NORMAL_ACT.Value)=0,Fields!RUNP_TGT.Value,SUM(Fields!NORMAL_ACT.Value * Fields!RUNP_TGT.Value)/SUM(Fields!NORMAL_ACT.Value)),4)*100)+"%"</Value>
                        </Textbox>
                      </ReportItems>
                    </TableCell>
                    <TableCell>
                      <ReportItems>
                        <Textbox Name="textbox129">
                          <Style>
                            <BackgroundColor>#6e9eca</BackgroundColor>
                            <BorderStyle>
                              <Default>Solid</Default>
                              <Left>Solid</Left>
                              <Right>Solid</Right>
                              <Top>Solid</Top>
                              <Bottom>Solid</Bottom>
                            </BorderStyle>
                            <FontFamily>新細明體</FontFamily>
                            <TextAlign>Center</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                          <ZIndex>178</ZIndex>
                          <CanGrow>true</CanGrow>
                          <Value>=iif(SUM(Fields!UP_TTL.Value)=0,0,CSTR(ROUND(SUM( Fields!M_RUN.Value)/SUM(Fields!UP_TTL.Value),4) *100) +"%")</Value>
                        </Textbox>
                      </ReportItems>
                    </TableCell>
                    <TableCell>
                      <ReportItems>
                        <Textbox Name="textbox179">
                          <rd:DefaultName>textbox179</rd:DefaultName>
                          <Style>
                            <BackgroundColor>#6e9eca</BackgroundColor>
                            <BorderStyle>
                              <Default>Solid</Default>
                              <Left>Solid</Left>
                              <Right>Solid</Right>
                              <Top>Solid</Top>
                              <Bottom>Solid</Bottom>
                            </BorderStyle>
                            <FontFamily>新細明體</FontFamily>
                            <TextAlign>Center</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                          <ZIndex>177</ZIndex>
                          <CanGrow>true</CanGrow>
                          <Value>=IIF (Fields!PROCESS.Value="COG",iif((SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value+Fields!CHMT.Value)
+SUM((Fields!NONFAC_IDLE.Value + Fields!FAC_IDLE.Value)* Fields!UPP_TGT.Value))=0,0,CSTR(ROUND((SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value) 
+SUM(ROUND(Fields!NONFAC_IDLE.Value * Fields!UPP_TGT.Value * Fields!RUNP_TGT.Value,2)))/
(SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value+Fields!CHMT.Value)
+SUM((Fields!NONFAC_IDLE.Value + Fields!FAC_IDLE.Value)* Fields!UPP_TGT.Value))
,4)*100) +"%"),
iif((SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value+Fields!CHMT.Value)
+SUM((Fields!NONFAC_IDLE.Value + Fields!FAC_IDLE.Value+Fields!OFF_TTL.Value)* Fields!UPP_TGT.Value))=0,0,CSTR(ROUND((SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value) 
+SUM(ROUND((Fields!NONFAC_IDLE.Value +Fields!FAC_IDLE.Value+Fields!OFF_TTL.Value )* Fields!UPP_TGT.Value * Fields!RUNP_TGT.Value,2)))/
(SUM(Fields!M_RUN.Value+Fields!ESETUP.Value+Fields!PSETUP.Value +Fields!ERUN.Value+Fields!CHMT.Value)
+SUM((Fields!NONFAC_IDLE.Value + Fields!FAC_IDLE.Value+Fields!OFF_TTL.Value)* Fields!UPP_TGT.Value))
,4)*100) +"%")
)</Value>
                        </Textbox>
                      </ReportItems>
                    </TableCell>
                    <TableCell>
                      <ReportItems>
                        <Textbox Name="textbox180">
                          <rd:DefaultName>textbox180</rd:DefaultName>
