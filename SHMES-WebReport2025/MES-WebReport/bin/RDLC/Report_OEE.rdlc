                          <CanGrow>true</CanGrow>
                          <Value>=iif(SUM(Fields!UP_TTL.Value)=0,0%,CSTR(ROUND(SUM( Fields!PSETUP.Value)/SUM(Fields!UP_TTL.Value),4) *100) +"%")</Value>
