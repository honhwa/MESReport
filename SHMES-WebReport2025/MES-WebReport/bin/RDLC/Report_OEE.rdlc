                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                          <ZIndex>175</ZIndex>
                          <CanGrow>true</CanGrow>
                          <Value>=CSTR(ROUND(IIF(SUM(Fields!NORMAL_ACT.Value)=0 OR SUM(Fields!TT.Value)=0 OR SUM(Fields!M_RUN.Value)=0,Fields!UPHP_ACT.Value, (SUM(Fields!NORMAL_ACT.Value)/SUM(Fields!M_RUN.Value))/(3600*SUM(Fields!NORMAL_ACT.Value)/SUM(Fields!TT.Value))),4) *100)+"%"</Value>
                        </Textbox>
                      </ReportItems>
                    </TableCell>
