        <Field Name="CUSTOMERID">
          <DataField>CUSTOMERID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>
			SELECT transdate,cartid,prodid,WONBR,entityid,  case when entitysts='C'
			AND CWORKCTR='8800' then '8800LotID' else '8380LotID' end as opt1,
			userid,CUSTOMERID FROM New_WLTM
		</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
