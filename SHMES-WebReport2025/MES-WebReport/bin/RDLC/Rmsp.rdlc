        </Field>
        <Field Name="WO_NUM">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>WO_NUM</DataField>
        </Field>
        <Field Name="WORKCTR">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>WORKCTR</DataField>
