        <Field Name="DEFECTDESC">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>DEFECTDESC</DataField>
        </Field>
        <Field Name="COMP_PART">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>COMP_PART</DataField>
        </Field>
        <Field Name="WO_TYPE">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>WO_TYPE</DataField>
        </Field>
        <Field Name="LOT_TYPE">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>LOT_TYPE</DataField>
        </Field>
        <Field Name="COPM_FLAG">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>COPM_FLAG</DataField>
        </Field>
        <Field Name="LC_FLAG">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>LC_FLAG</DataField>
        </Field>
        <Field Name="BIPAME_PART">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>BIPAME_PART</DataField>
        </Field>
        <Field Name="UPS">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>UPS</DataField>
        </Field>
        <Field Name="PACK_FLAG">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PACK_FLAG</DataField>
        </Field>
        <Field Name="COMP_M_GROUP">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>COMP_M_GROUP</DataField>
        </Field>
        <Field Name="COMP_USAGE">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>COMP_USAGE</DataField>
        </Field>
        <Field Name="OUT_QTY">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>OUT_QTY</DataField>
        </Field>
        <Field Name="SCRAP_QTY">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>SCRAP_QTY</DataField>
        </Field>
        <Field Name="PRESCRAP_QTY">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>PRESCRAP_QTY</DataField>
        </Field>
        <Field Name="PANEL_SCRAP_QTY">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>PANEL_SCRAP_QTY</DataField>
        </Field>
        <Field Name="SCRAP_TYPE">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>SCRAP_TYPE</DataField>
        </Field>
        <Field Name="SOURCE_FAB">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>SOURCE_FAB</DataField>
        </Field>
