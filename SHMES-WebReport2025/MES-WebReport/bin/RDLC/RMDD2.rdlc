      <Query>
        <DataSourceName>RMDD2</DataSourceName>
        <CommandText>SELECT substring(convert(varchar,REPORTDATE,120),1,10) AS REPORTDATE,WORKCTR++'('+WORKNAME+')' as WORKCTR,
CASE WHEN ISNULL(PRODGROUP,'')='' THEN '沒有機種群組' ELSE PRODGROUP END as PRODGROUP,
TEAMMODE,SUBLINEID,TEAMID,PRODID,  LOTTYPE,STDINPUT,ACTINPUT,
CASE WHEN STDINPUT=0 THEN '0' ELSE CAST(CAST(CAST(ACTINPUT*100 AS NUMERIC)/CAST(STDINPUT AS NUMERIC) AS NUMERIC(17,2)) AS VARCHAR)+'%' END AS INPUTRATE,
CASE WHEN STDINPUT=0 THEN 'RED' 
	 WHEN CAST(CAST(ACTINPUT AS NUMERIC)/CAST(STDINPUT AS NUMERIC) AS NUMERIC(17,4))&lt;1 THEN 'RED'
	 ELSE 'WHITE' END AS INPUTRATECOLOR,
STDOUTPUT,AOUTPUT,
CASE WHEN STDOUTPUT=0 THEN '0' ELSE CAST(CAST(CAST(AOUTPUT*100 AS NUMERIC)/CAST(STDOUTPUT AS NUMERIC) AS NUMERIC(17,2)) AS VARCHAR)+'%' END AS OUTPUTRATE,
CASE WHEN STDOUTPUT=0 THEN 'RED' 
	 WHEN CAST(CAST(AOUTPUT AS NUMERIC)/CAST(STDOUTPUT AS NUMERIC) AS NUMERIC(17,4))&lt;1 THEN 'RED'
	 ELSE 'WHITE' END AS OUTPUTRATECOLOR,
CAST(WORKINGHOUR AS NUMERIC(17,2)) AS WORKINGHOUR,MANPOWER,
CAST((WORKINGHOUR*MANPOWER)/10 AS NUMERIC(17,2)) AS ACMANPOWER,
PMSYIELD, 
UPSQTY, 
CASE WHEN AOUTPUT=0 THEN '0' ELSE CAST(CAST(CAST(UPSQTY*100 AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4)) AS NUMERIC(17,2)) AS VARCHAR)+'%' END AS UPSRATE,
CASE WHEN AOUTPUT=0 THEN 'RED' 
	 WHEN CAST(CAST(UPSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4)) AS NUMERIC(17,4))&gt;CAST(PMSYIELD AS NUMERIC(17,4)) THEN 'RED'
     ELSE 'WHITE'
END AS UPSRATECOLOR,
LPSQTY, 
CASE WHEN AOUTPUT=0 THEN 0 ELSE CAST(CAST(LPSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4)) AS NUMERIC(17,4)) END AS LPSRATE,
CASE WHEN AOUTPUT=0 THEN 'RED' 
	 WHEN CAST(CAST(LPSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4)) AS NUMERIC(17,4))&gt;PMSYIELD THEN 'RED'
     ELSE 'WHITE'
END AS LPSRATECOLOR,
ICSQTY, 
CASE WHEN AOUTPUT=0 THEN 0 ELSE CAST(CAST(ICSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4))  
AS NUMERIC(17,4)) END AS ICSRATE,
CASE WHEN AOUTPUT=0 THEN 'RED' 
	 WHEN CAST(CAST(ICSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4)) AS NUMERIC(17,4))&gt;PMSYIELD THEN 'RED'
     ELSE 'WHITE'
END AS ICSRATECOLOR,
FPSQTY,  
CASE WHEN AOUTPUT=0 THEN 0 ELSE CAST(CAST(FPSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4))  AS NUMERIC(17,4)) END AS FPSRATE,
CASE WHEN AOUTPUT=0 THEN 'RED' 
	 WHEN CAST(CAST(FPSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4)) AS NUMERIC(17,4))&gt;PMSYIELD THEN 'RED'
     ELSE 'WHITE'
END AS FPSRATECOLOR,
BLSQTY,
CASE WHEN AOUTPUT=0 THEN 0 ELSE CAST(CAST(BLSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4))  AS NUMERIC(17,4)) END AS BLSRATE,
CASE WHEN AOUTPUT=0 THEN 'RED' 
	 WHEN CAST(CAST(BLSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4)) AS NUMERIC(17,4))&gt;PMSYIELD THEN 'RED'
     ELSE 'WHITE'
END AS BLSRATECOLOR,
WBSQTY,  
CASE WHEN AOUTPUT=0 THEN 0 ELSE CAST(CAST(WBSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4))   AS NUMERIC(17,4)) END AS WBSRATE,
CASE WHEN AOUTPUT=0 THEN 'RED' 
	 WHEN CAST(CAST(WBSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4)) AS NUMERIC(17,4))&gt;PMSYIELD THEN 'RED'
     ELSE 'WHITE'
END AS WBSRATECOLOR,
TPSQTY,  
CASE WHEN AOUTPUT=0 THEN 0 ELSE CAST(CAST(TPSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4))  AS NUMERIC(17,4)) END AS TPSRATE ,
CASE WHEN AOUTPUT=0 THEN 'RED' 
	 WHEN CAST(CAST(TPSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4)) AS NUMERIC(17,4))&gt;PMSYIELD THEN 'RED'
     ELSE 'WHITE'
END AS TPSRATECOLOR, 
CASE WHEN AOUTPUT=0 THEN 0 ELSE CAST((CAST(UPSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4))+CAST(LPSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4))+CAST(ICSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4)) +CAST(FPSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4))+ CAST(BLSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4))+CAST(WBSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4))+CAST(TPSQTY AS NUMERIC(17,4))/CAST(AOUTPUT AS NUMERIC(17,4))  ) AS NUMERIC(17,4))  END AS TMSRATE ,
SOUTPUT, CASE WHEN ACTINPUT=0 THEN 0 ELSE CAST(CAST(SOUTPUT AS NUMERIC(17,4))/CAST(ACTINPUT AS NUMERIC(17,4))  AS NUMERIC(17,4))  END AS SRATE,SDEFECTCD,ROUTPUT, 
CASE WHEN ACTINPUT=0 THEN 0 ELSE CAST(CAST(ROUTPUT AS NUMERIC(17,4))/CAST(ACTINPUT AS NUMERIC(17,4))  AS NUMERIC(17,4)) END AS RRATE, RDEFECTCD, 
CASE WHEN ACTINPUT=0 THEN '0' ELSE  CAST(CAST(CAST((ACTINPUT-SOUTPUT-ROUTPUT)*100 AS NUMERIC(17,4))/CAST(ACTINPUT AS NUMERIC(17,4)) AS NUMERIC(17,2)) AS VARCHAR)+'%'   END AS YIELD,
CASE WHEN ACTINPUT=0 THEN 'RED'
	 WHEN CAST(CAST((ACTINPUT-SOUTPUT-ROUTPUT)*100 AS NUMERIC(17,4))/CAST(ACTINPUT AS NUMERIC(17,4)) AS NUMERIC(17,2))&lt;PYIELD THEN 'RED'
     ELSE 'WHITE' END AS YIELDCOLOR,
CAST(CAST(PYIELD AS NUMERIC(17,4)) AS VARCHAR)+'%' AS PYIELD,  
CASE WHEN ACTINPUT-STDINPUT&gt;=0 THEN 'OK' ELSE CONVERT(VARCHAR,ACTINPUT-STDINPUT) END AS CAPALOSS,
CASE WHEN ACTINPUT-STDINPUT&lt;0 THEN 'RED' ELSE  'WHITE' END AS CAPALOSSCOLOR
FROM RMDD WHERE FABID='B'  AND WORKCTR IN ('8180','8280','8380')   AND REPORTDATE='2008-04-10'  AND SHIFTID='D'
ORDER BY REPORTDATE,WORKCTR,PRODGROUP,PRODID,TEAMMODE,TEAMID,LOTTYPE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
