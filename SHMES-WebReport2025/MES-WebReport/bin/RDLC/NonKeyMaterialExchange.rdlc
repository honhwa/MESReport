  </Body>
  <rd:ReportID>d461edc6-26de-4d00-85f4-8676b146c317</rd:ReportID>
  <LeftMargin>2.5cm</LeftMargin>
  <DataSets>
    <DataSet Name="NonKeyMaterialExchange">
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT A.TRANSDATE AS TRANSDATE,A.PARTID AS PARTID,A.PARTTYPE AS PARTTYPE,
       B.PARTNAME AS PARTNAME,A.PRODID AS PRODID,A.CSTOCKID AS CSTOCKID,
       A.NSTOCKID AS NSTOCKID,A.PARTQTY AS PARTQTY,
	   CASE WHEN VERB='W2MC' THEN '庫房發料'
			WHEN VERB='MC2S' THEN '發到產線'
			WHEN VERB='S2MC' THEN '產線退回'
			WHEN VERB='MC2Z' THEN '發到站點'
			WHEN VERB='Z2MC' THEN '站點退回'
			WHEN VERB='MC2W' THEN 'NONKEY繳庫'
		    ELSE '' END AS TRANSTYPE,	
	   CASE WHEN VERB='S2MC' THEN CSUBLINEID
		    WHEN VERB='MC2S' THEN NSUBLINEID
			WHEN VERB='MC2Z' THEN NSTOCKID 
            WHEN VERB='Z2MC' THEN CSTOCKID
			ELSE '' END AS SUBLINE,
       A.SHIFTID AS SHIFTID,A.USERID AS USERID 
       FROM WNKPAX A LEFT JOIN MNKPAM B ON 
       A.FABID=B.FABID AND A.PARTID=B.PARTID 
       </CommandText>
        <DataSourceName>NonKeyMaterialExchange</DataSourceName>
      </Query>
      <Fields>
        <Field Name="TRANSDATE">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>TRANSDATE</DataField>
        </Field>
        <Field Name="PARTID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PARTID</DataField>
        </Field>
        <Field Name="PARTTYPE">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PARTTYPE</DataField>
        </Field>
        <Field Name="PARTNAME">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PARTNAME</DataField>
        </Field>
        <Field Name="PRODID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PRODID</DataField>
        </Field>
        <Field Name="CSTOCKID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CSTOCKID</DataField>
        </Field>
        <Field Name="NSTOCKID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>NSTOCKID</DataField>
        </Field>
        <Field Name="PARTQTY">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>PARTQTY</DataField>
        </Field>
        <Field Name="TRANSTYPE">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>TRANSTYPE</DataField>
        </Field>
        <Field Name="SUBLINE">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>SUBLINE</DataField>
        </Field>
        <Field Name="SHIFTID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>SHIFTID</DataField>
        </Field>
        <Field Name="USERID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>USERID</DataField>
        </Field>
      </Fields>
    </DataSet>
