<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="RMDDSMC">
      <rd:DataSourceID>45a6dae8-1b7c-4abc-8f10-ca72a2cd57c7</rd:DataSourceID>
      <DataSourceReference>RMDDSMC</DataSourceReference>
    </DataSource>
  </DataSources>
  <InteractiveHeight>11in</InteractiveHeight>
  <rd:DrawGrid>true</rd:DrawGrid>
  <InteractiveWidth>8.5in</InteractiveWidth>
  <rd:GridSpacing>0.25cm</rd:GridSpacing>
  <rd:SnapToGrid>true</rd:SnapToGrid>
  <RightMargin>2.5cm</RightMargin>
  <LeftMargin>2.5cm</LeftMargin>
  <BottomMargin>2.5cm</BottomMargin>
  <rd:ReportID>b2276649-6a24-4fb5-99a8-f23656b930e9</rd:ReportID>
  <PageWidth>21cm</PageWidth>
  <DataSets>
    <DataSet Name="RMDDSMC">
      <Fields>
        <Field Name="REPORTDATE">
          <DataField>REPORTDATE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RATE">
          <DataField>RATE</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="PARTTYPE">
          <DataField>PARTTYPE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>RMDDSMC</DataSourceName>
        <CommandText>SELECT REPORTDATE,RATE,PARTTYPE FROM ( SELECT SUBSTRING(CONVERT(VARCHAR,REPORTDATE,120),1,10) AS REPORTDATE, 
 CASE WHEN SUM(AOUTPUT)=0 THEN 0 ELSE CAST(CAST(SUM(UPSQTY) AS NUMERIC)/CAST(SUM(AOUTPUT) AS NUMERIC) AS NUMERIC(17,4)) END AS RATE , 
 'UP' AS PARTTYPE  FROM RMDD  WHERE FABID='B' AND UPSQTY&gt;0  
AND WORKCTR IN ('8180','8280','8380')  AND  
CONVERT(VARCHAR,REPORTYEAR)+RIGHT('00'+CAST(REPORTMONTH AS VARCHAR),2) 
BETWEEN 200803 AND 200803 AND WORKCTR IN ('8180','8280','8380')  
GROUP BY REPORTDATE HAVING  SUM(AOUTPUT)&gt;0  
UNION ALL   
SELECT SUBSTRING(CONVERT(VARCHAR,REPORTDATE,120),1,10) AS REPORTDATE,
CASE WHEN SUM(AOUTPUT)=0 THEN 0 ELSE 
CAST(CAST(SUM(LPSQTY) AS NUMERIC)/CAST(SUM(AOUTPUT) AS NUMERIC) AS NUMERIC(17,4))  END AS RATE , 
'LP' AS PARTTYPE  FROM RMDD  WHERE FABID='B' AND  LPSQTY&gt;0  
AND WORKCTR IN ('8180','8280','8380')  AND  
CONVERT(VARCHAR,REPORTYEAR)+RIGHT('00'+CAST(REPORTMONTH AS VARCHAR),2)
 BETWEEN 200803 AND 200803 AND WORKCTR IN ('8180','8280','8380')  
GROUP BY REPORTDATE  HAVING  SUM(AOUTPUT)&gt;0  UNION ALL
SELECT SUBSTRING(CONVERT(VARCHAR,REPORTDATE,120),1,10) AS REPORTDATE,
CASE WHEN SUM(AOUTPUT)=0 THEN 0 ELSE  CAST(CAST(SUM(ICSQTY) AS NUMERIC)/CAST(SUM(AOUTPUT) AS NUMERIC) AS NUMERIC(17,4))   END AS RATE ,
  'IC' AS PARTTYPE FROM RMDD 
 WHERE FABID='B' AND ICSQTY&gt;0 AND WORKCTR IN ('8180','8280','8380')   AND  
CONVERT(VARCHAR,REPORTYEAR)+RIGHT('00'+CAST(REPORTMONTH AS VARCHAR),2) 
BETWEEN 200803 AND 200803 AND WORKCTR IN ('8180','8280','8380')   GROUP BY REPORTDATE   
HAVING  SUM(AOUTPUT)&gt;0  
UNION ALL  
SELECT SUBSTRING(CONVERT(VARCHAR,REPORTDATE,120),1,10) AS REPORTDATE,
CASE WHEN SUM(AOUTPUT)=0 THEN 0 ELSE  CAST(CAST(SUM(FPSQTY) AS NUMERIC)/CAST(SUM(AOUTPUT) AS NUMERIC) AS NUMERIC(17,4))   END AS RATE ,  
 'FP' AS PARTTYPE  FROM RMDD  WHERE FABID='B' AND  FPSQTY&gt;0 AND WORKCTR IN ('8180','8280','8380')  AND 
 CONVERT(VARCHAR,REPORTYEAR)+RIGHT('00'+CAST(REPORTMONTH AS VARCHAR),2) 
BETWEEN 200803 AND 200803 AND WORKCTR IN ('8180','8280','8380')   GROUP BY REPORTDATE  
 HAVING  SUM(AOUTPUT)&gt;0 
 UNION ALL  SELECT SUBSTRING(CONVERT(VARCHAR,REPORTDATE,120),1,10) AS REPORTDATE,
CASE WHEN SUM(AOUTPUT)=0 THEN 0 ELSE CAST(CAST(SUM(BLSQTY) AS NUMERIC)/CAST(SUM(AOUTPUT) AS NUMERIC) AS NUMERIC(17,4)) END AS RATE , 
  'BL' AS PARTTYPE  FROM RMDD  WHERE FABID='B' AND BLSQTY&gt;0 AND WORKCTR IN ('8180','8280','8380')  AND  
CONVERT(VARCHAR,REPORTYEAR)+RIGHT('00'+CAST(REPORTMONTH AS VARCHAR),2) BETWEEN 200803 AND 200803 AND
 WORKCTR IN ('8180','8280','8380')   GROUP BY REPORTDATE  HAVING  SUM(AOUTPUT)&gt;0 
UNION ALL  
SELECT SUBSTRING(CONVERT(VARCHAR,REPORTDATE,120),1,10) AS REPORTDATE,
CASE WHEN SUM(AOUTPUT)=0 THEN 0 ELSE CAST(CAST(SUM(WBSQTY) AS NUMERIC)/CAST(SUM(AOUTPUT) AS NUMERIC) AS NUMERIC(17,4)) END AS RATE ,  
 'WB' AS PARTTYPE  FROM RMDD  WHERE FABID='B' AND WBSQTY&gt;0 AND WORKCTR IN ('8180','8280','8380')  AND  
CONVERT(VARCHAR,REPORTYEAR)+RIGHT('00'+CAST(REPORTMONTH AS VARCHAR),2) BETWEEN 200803 AND 200803 AND
 WORKCTR IN ('8180','8280','8380')   GROUP BY REPORTDATE  
 HAVING  SUM(AOUTPUT)&gt;0 UNION ALL  SELECT SUBSTRING(CONVERT(VARCHAR,REPORTDATE,120),1,10) AS REPORTDATE,
CASE WHEN SUM(AOUTPUT)=0 THEN 0 ELSE  CAST(CAST(SUM(TPSQTY)  AS NUMERIC)/CAST(SUM(AOUTPUT) AS NUMERIC) AS NUMERIC(17,4))  END AS RATE ,  
 'TP' AS PARTTYPE  FROM RMDD  WHERE FABID='B' AND  TPSQTY&gt;0 AND 
WORKCTR IN ('8180','8280','8380')  AND  CONVERT(VARCHAR,REPORTYEAR)+RIGHT('00'+CAST(REPORTMONTH AS VARCHAR),2)
 BETWEEN 200803 AND 200803 AND WORKCTR IN ('8180','8280','8380')  GROUP BY REPORTDATE  
 HAVING  SUM(AOUTPUT)&gt;0 ) A ORDER BY REPORTDATE,PARTTYPE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
  <Width>27.25cm</Width>
