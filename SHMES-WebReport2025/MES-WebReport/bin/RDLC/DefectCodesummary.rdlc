    <DataSet Name="DefectCodesummary_VWLDXA">
      <rd:DataSetInfo>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:DataSetName>DefectCodesummary</rd:DataSetName>
