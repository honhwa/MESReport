        <rd:TableName>VWLDXA</rd:TableName>
      </rd:DataSetInfo>
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT CONVERT(VARCHAR(19),TRANSDATE,120) AS transdate,CWORKCTR,CSUBLINEID,ENTITYID,MLOTID,LOTGRADE,LOTLEVEL,DEFECTCD,PRODID,WONBR,LOTTYPE,SHIFTID,CSHOPCD,SUM(DEFECTQTY)DEFECTQTY FROM VWLDXA  where 1=1 and MLOTID='KN92601HGM.03'GROUP BY TRANSDATE,CWORKCTR,CSUBLINEID,ENTITYID,MLOTID,LOTGRADE,LOTLEVEL,DEFECTCD,PRODID,WONBR,LOTTYPE,SHIFTID,CSHOPCD</CommandText>
        <DataSourceName>Connect10</DataSourceName>
      </Query>
