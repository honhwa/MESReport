  <rd:ReportID>31bb2607-61a1-429d-9b55-9f10556a0afe</rd:ReportID>
  <LeftMargin>2.5cm</LeftMargin>
  <DataSets>
    <DataSet Name="DataSet1_DataTable1">
      <rd:DataSetInfo>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:DataSetName>DataSet1</rd:DataSetName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterName>DataTable1TableAdapter</rd:TableAdapterName>
        <rd:TableName>DataTable1</rd:TableName>
      </rd:DataSetInfo>
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>
			select a.*,b.cmt from (select transdate,frentityid,toentityid,verb,cworkctr,toprodid,ton9ncno,towonbr,solotid,soprodid,so9ncno,mlotid from vwltxa) a left join wssd b on a.toentityid=b.entityid
		</CommandText>
        <DataSourceName>Connect10</DataSourceName>
      </Query>
