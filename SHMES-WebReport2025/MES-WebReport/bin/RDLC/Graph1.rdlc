      <Query>
        <DataSourceName>Graph1</DataSourceName>
        <CommandText>select    '1'  as TRANSDATE,
                    '1'   as WORKCTR,
                         '1'  as  LINEID,
                         '1' AS SUBLINEID,'1' as EQID,
                        '20' AS OPTIME,
                        '1'  as  NONOPTIME,
