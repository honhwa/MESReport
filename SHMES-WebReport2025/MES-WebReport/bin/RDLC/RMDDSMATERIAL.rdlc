        </Field>
        <Field Name="ROUTPUT">
          <DataField>ROUTPUT</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="RRATE">
          <DataField>RRATE</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
