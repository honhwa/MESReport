        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>
			select a.verb,a.TransDate,a.TrackInDate,a.mlotid,
			a.PTrackOutDate,a.PWorkCtr,a.CWorkCtr,a.NWorkCtr,a.FrProdID,a.ToProdID, a.FrWoNbr,a.ToWoNbr,
			a.FrEntityID,a.ToEntityID,a.MLotID,a.FrPEntityUnit,a.ToPEntityUnit,a.FrEntityUnit,a.ToEntityUnit,
			a.EntityCarry,a.CEntityTQty,a.Nentitytqty,
			a.FrWoType,a.ToWoType,a.FrLotType,a.ToLotType,a.FrLotGrade,a.ToLotGrade,
			a.FrLotLevel,a.ToLotLevel,a.CSUBLineID, a.NSUBLineID,a.userid,a.ShiftID,a.CustomerID ,
			a.SALEORDER,a.TmpFIELD  from  New_WLTX a</CommandText>
        <DataSourceName>DataSource1</DataSourceName>
      </Query>
