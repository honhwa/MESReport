  <rd:ReportID>8ff1497d-7bb8-4868-8649-da456cd49851</rd:ReportID>
  <LeftMargin>2.5cm</LeftMargin>
  <DataSets>
    <DataSet Name="MACHINEPMTRACKING_DataTable1">
      <rd:DataSetInfo>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:DataSetName>MACHINEPMTRACKING</rd:DataSetName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterName>DataTable1TableAdapter</rd:TableAdapterName>
        <rd:TableName>DataTable1</rd:TableName>
      </rd:DataSetInfo>
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>
			select a.*,b.eqdes from (select transdate,workctr,sublineid,shopcd,sublinestatus from New_ESLS where eqccd='P' union select transdate,workctr,sublineid,shopcd,sublinestatus from New_ESLSH where eqccd='P') a left join mecm b on a.sublinestatus=b.eqcd
		</CommandText>
        <DataSourceName>Connect8</DataSourceName>
      </Query>
      <Fields>
        <Field Name="transdate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>transdate</DataField>
        </Field>
        <Field Name="workctr">
