          <DataField>workctr</DataField>
        </Field>
        <Field Name="sublineid">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>sublineid</DataField>
        </Field>
        <Field Name="shopcd">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>shopcd</DataField>
        </Field>
        <Field Name="sublinestatus">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>sublinestatus</DataField>
        </Field>
        <Field Name="eqdes">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>eqdes</DataField>
