  <rd:ReportID>01cd2590-46b3-4d6d-a001-5cb1c0cbfc9c</rd:ReportID>
  <LeftMargin>2.5cm</LeftMargin>
  <DataSets>
    <DataSet Name="IbeWipQuery">
      <rd:DataSetInfo>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:DataSetName>IbeWipQuery</rd:DataSetName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterName>WLTMTableAdapter</rd:TableAdapterName>
        <rd:TableName>WLTM</rd:TableName>
      </rd:DataSetInfo>
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT	CWORKCTR,			
				CASE WHEN CSHOPCD = 'CELL2' THEN C9NCNO ELSE N9NCNO END AS PRODID,
				C9NCNO,
				SUM(ENTITYTQTY)QTY
FROM EIF.WLTM				
WHERE MFGDATE = '2011-07-18'
GROUP BY CWORKCTR,C9NCNO,CSHOPCD,N9NCNO
HAVING SUM(ENTITYTQTY)!=0
ORDER BY CWORKCTR</CommandText>
        <DataSourceName>Connect7</DataSourceName>
      </Query>
      <Fields>
        <Field Name="CWORKCTR">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CWORKCTR</DataField>
        </Field>
        <Field Name="PRODID">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PRODID</DataField>
        </Field>
        <Field Name="C9NCNO">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>C9NCNO</DataField>
        </Field>
        <Field Name="QTY">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>QTY</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
