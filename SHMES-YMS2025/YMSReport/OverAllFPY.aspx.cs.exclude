            {
                ChartRDefectCode.Series[HTR.Series.Name.ToString()].Label = " #VALY{##,##0.##}";
                ChartRDefectCode.Series[HTR.Series.Name.ToString()].LabelBackColor = Color.White;
            }
            else
            {
                ChartRDefectCode.Series[HTR.Series.Name.ToString()].Label = "";
            }
        }
    }
    protected void ChartRDefectDistr_Click(object sender, ImageClickEventArgs e)
    {
        HitTestResult HTR = ChartRDefectDistr.HitTest(e.X, e.Y);
        if (HTR.ChartElementType == ChartElementType.DataPoint)
        {
            if (ChartRDefectDistr.Series[HTR.Series.Name.ToString()].Label == "")
            {
                ChartRDefectDistr.Series[HTR.Series.Name.ToString()].Label = " #VALY{##,##0.##}";
                ChartRDefectDistr.Series[HTR.Series.Name.ToString()].LabelBackColor = Color.White;
            }
            else
            {
                ChartRDefectDistr.Series[HTR.Series.Name.ToString()].Label = "";
            }
        }
    }
    //---
}
