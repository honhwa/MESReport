    protected void ChangeHeight()
    {
        if (PSubLineID.Visible == false && PLotType.Visible == false && PProdID.Visible == false && PWonbr.Visible == false)
        {
            PMain.Height = 60;
        }
        else
        {
            PMain.Height = 200;
        }
    }
