    protected void CreateYieldSessionDataTable()
    {
        DataTable dtOVFPY = new DataTable();
        //--創建數據集，將查詢的資料做邏輯處理后填寫資料集中供UI顯示
        dtOVFPY.Columns.Add(new DataColumn("ReportDT", typeof(string)));			            /*0 */
        dtOVFPY.Columns.Add(new DataColumn("PRODUCT_ID", typeof(string)));			        /*1 */
        dtOVFPY.Columns.Add(new DataColumn("OPERATION_ID", typeof(string)));                 /*2 */
        dtOVFPY.Columns.Add(new DataColumn("Chip_Qty", typeof(long)));                       /*3 */
        dtOVFPY.Columns.Add(new DataColumn("A_Yield", typeof(double)));                      /*4 */
        dtOVFPY.Columns.Add(new DataColumn("R_Yield", typeof(double)));                      /*5 */
        dtOVFPY.Columns.Add(new DataColumn("S_Yield", typeof(double)));                      /*6 */
        dtOVFPY.Columns.Add(new DataColumn("AA_Yield", typeof(double)));                     /*7 */
        dtOVFPY.Columns.Add(new DataColumn("A0_Yield", typeof(double)));                     /*8*/
        dtOVFPY.Columns.Add(new DataColumn("A1_Yield", typeof(double)));                     /*9*/
        dtOVFPY.Columns.Add(new DataColumn("A2_Yield", typeof(double)));                     /*10*/
        dtOVFPY.Columns.Add(new DataColumn("A3_Yield", typeof(double)));                     /*11*/
        dtOVFPY.Columns.Add(new DataColumn("A4_Yield", typeof(double)));                     /*12*/
        dtOVFPY.Columns.Add(new DataColumn("A5_Yield", typeof(double)));                     /*13*/
        dtOVFPY.Columns.Add(new DataColumn("AB_Yield", typeof(double)));                     /*14*/
        dtOVFPY.Columns.Add(new DataColumn("AD_Yield", typeof(double)));                     /*15*/
        dtOVFPY.Columns.Add(new DataColumn("AF_Yield", typeof(double)));                     /*16*/
        dtOVFPY.Columns.Add(new DataColumn("AH_Yield", typeof(double)));                     /*17*/
        dtOVFPY.Columns.Add(new DataColumn("AK_Yield", typeof(double)));                     /*18*/
        dtOVFPY.Columns.Add(new DataColumn("AL_Yield", typeof(double)));                     /*19*/
        dtOVFPY.Columns.Add(new DataColumn("AM_Yield", typeof(double)));                     /*20*/
        dtOVFPY.Columns.Add(new DataColumn("AP_Yield", typeof(double)));                     /*21*/
        dtOVFPY.Columns.Add(new DataColumn("AV_Yield", typeof(double)));                     /*22*/
        dtOVFPY.Columns.Add(new DataColumn("AX_Yield", typeof(double)));                     /*23*/
        dtOVFPY.Columns.Add(new DataColumn("UNDEFINE_CNT", typeof(long)));                   /*24*/
        dtOVFPY.Columns.Add(new DataColumn("ALevel_Yield", typeof(double)));                 /*25*/
        dtOVFPY.Columns.Add(new DataColumn("ItemNo", typeof(int)));                          /*26*/
        dtOVFPY.Columns.Add(new DataColumn("DFQty", typeof(long)));                          /*27*/
        dtOVFPY.Columns.Add(new DataColumn("S_DFQty", typeof(long)));                          /*28*/
        dtOVFPY.Columns.Add(new DataColumn("R_DFQty", typeof(long)));                          /*29*/
        dtOVFPY.Clear();
        /*對數據集創建Key，供後續Rows.Find()使用*/
        DataColumn[] keys = new DataColumn[3];
        keys[0] = dtOVFPY.Columns["ReportDT"];
        keys[1] = dtOVFPY.Columns["PRODUCT_ID"];
        keys[2] = dtOVFPY.Columns["OPERATION_ID"];
        dtOVFPY.PrimaryKey = keys;
        /*-------------------------------------------------------------------------------------*/
        Session["dtOVFPY"] = null;
        Session["dtOVFPY"] = dtOVFPY;
       
    }
    protected void CreateDefSessionDataTable()
    { 
        /*-------------------------------------------------------------------------------------*/
        DataTable dtOVDef = new DataTable();
        //--創建數據集，將查詢的資料做邏輯處理后填寫資料集中供UI顯示
        dtOVDef.Columns.Add(new DataColumn("ReportDT", typeof(string)));			                /*0 */
        dtOVDef.Columns.Add(new DataColumn("PRODUCT_ID", typeof(string)));			            /*1 */
        dtOVDef.Columns.Add(new DataColumn("LOTGRADE", typeof(string)));                          /*2 */
        dtOVDef.Columns.Add(new DataColumn("DEFCODE", typeof(string)));                           /*3 */
        dtOVDef.Columns.Add(new DataColumn("DEFECTDESC", typeof(string)));                        /*4 */
        dtOVDef.Columns.Add(new DataColumn("TTL_CNT", typeof(long)));                             /*5 */
        dtOVDef.Columns.Add(new DataColumn("SEMISCRIBE", typeof(long)));                          /*6 */
        dtOVDef.Columns.Add(new DataColumn("LCInjection", typeof(long)));                         /*7 */
        dtOVDef.Columns.Add(new DataColumn("EndSealing", typeof(long)));                          /*8 */
        dtOVDef.Columns.Add(new DataColumn("ROUGHCLEAN", typeof(long)));                          /*9 */
        dtOVDef.Columns.Add(new DataColumn("LOT1", typeof(long)));                                /*10 */
        dtOVDef.Columns.Add(new DataColumn("OUTVIEW", typeof(long)));                             /*11 */
        dtOVDef.Columns.Add(new DataColumn("FINALCLEAN", typeof(long)));                          /*12 */
        dtOVDef.Columns.Add(new DataColumn("DefectRate", typeof(double)));                        /*13 */
        dtOVDef.Columns.Add(new DataColumn("Percentage", typeof(double)));                        /*14 */
        dtOVDef.Columns.Add(new DataColumn("ItemNo", typeof(int)));                               /*15*/
        dtOVDef.Columns.Add(new DataColumn("ReLon1", typeof(long)));                              /*16*/   /*V1.00*/
        dtOVDef.Columns.Add(new DataColumn("ReLon1Rate", typeof(double)));                         /*17*/    /*V1.01*/
        dtOVDef.Columns.Add(new DataColumn("LOT1_OUTVIEW_808T", typeof(long)));                   /*18 */   /*V1.02*/
        dtOVDef.Clear();
        /*對數據集創建Key，供後續Rows.Find()使用*/
        DataColumn[] DFkeys = new DataColumn[4];
        DFkeys[0] = dtOVDef.Columns["ReportDT"];
        DFkeys[1] = dtOVDef.Columns["PRODUCT_ID"];
        DFkeys[2] = dtOVDef.Columns["LOTGRADE"];
        DFkeys[3] = dtOVDef.Columns["DEFCODE"];
        dtOVDef.PrimaryKey = DFkeys;
        /*-------------------------------------------------------------------------------------*/
        Session["dtOVDef"] = null;
        Session["dtOVDef"] = dtOVDef;
    }
    protected void btQuery_Click(object sender, EventArgs e)
    {
        AppClass Apc = new AppClass();
        int intSecCnt = 0;
        string strSubLineID = "'='";
        string strProdID = "'='";
        string strLotType = "'='";
        string strWonbr = "'='";
        lblTTime.Text = "";
        lblTime01.Text = "";
        lblTime02.Text = "";
        lblTime03.Text = "";
        DateTime dtF = System.DateTime.Now;
        /*--------------------------------------------------------------------------------------*/
        tbDateType.Text = "";
        tbDiffDate.Text = "0";
        tbCPFlag.Text = "";
        tbFDate.Text = "";
        tbTDate.Text = "";

        lblFabID.Text = tbFABName.Text;

        Session["dtOVFPY"] = null;
        Session["dtOVDef"] = null;

        IBGBYData.Enabled = false;
        cblLevel.Enabled = false;

        ddlByProdID.Items.Clear();
        ddlSDefList.Items.Clear();
        ddlRDefList.Items.Clear();

        ClearChartBound();

        if (cblSubLineID.Items.Count > 0)
        {
            foreach (ListItem li in this.cblSubLineID.Items)
            {
                if (li.Selected)
                {
                    strSubLineID = strSubLineID + "," + "'" + li.Text + "'";
                }
            }
        }
        if (cblLotType.Items.Count > 0)
        {
            foreach (ListItem li in this.cblLotType.Items)
            {
                if (li.Selected)
                {
                    strLotType = strLotType + "," + "'" + li.Text + "'";
                }
            }
        }
        if (cblProdID.Items.Count > 0)
        {
            foreach (ListItem li in this.cblProdID.Items)
            {
                if (li.Selected)
                {
                    strProdID = strProdID + "," + "'" + li.Text + "'";
                }
            }
        }
        if (cblWonbr.Items.Count > 0)
        {
            foreach (ListItem li in this.cblWonbr.Items)
            {
                if (li.Selected)
                {
                    strWonbr = strWonbr + "," + "'" + li.Text + "'";
                }
            }
        }
        /*-------------------------------------------------------------------------------------*/
        if (ddlDateType.SelectedValue == "Date")
        {
            DateTime dt1 = Convert.ToDateTime(txtFDate.Text);
            DateTime dt2 = Convert.ToDateTime(txtTDate.Text);
            TimeSpan ts = dt2 - dt1;
            tbDiffDate.Text = Convert.ToInt32(ts.TotalDays).ToString();

            tbDateType.Text = "D";

            tbFDate.Text = txtFDate.Text;
            tbTDate.Text = txtTDate.Text;
        }
        if (ddlDateType.SelectedValue == "Week")
        {
            tbDiffDate.Text = Convert.ToString(Convert.ToInt32(ddlTDate.SelectedValue.Replace("W", "")) - Convert.ToInt32(ddlFDate.SelectedValue.Replace("W", "")));
            tbDateType.Text = "W";
            //tbFDate.Text = ddlFDate.SelectedValue.Replace("W0", "").Replace("W", "");
            //tbTDate.Text = ddlTDate.SelectedValue.Replace("W0", "").Replace("W", "");
            tbFDate.Text = (Convert.ToInt32(ddlFDate.SelectedValue.Replace("W0", "").Replace("W", "")) - 1).ToString();
            tbTDate.Text = (Convert.ToInt32(ddlTDate.SelectedValue.Replace("W0", "").Replace("W", "")) - 1).ToString();
        }
        if (ddlDateType.SelectedValue == "Month")
        {
            tbDiffDate.Text = Convert.ToString(Convert.ToInt32(ddlTDate.SelectedValue.Replace("M", "")) - Convert.ToInt32(ddlFDate.SelectedValue.Replace("M", "")));
            tbDateType.Text = "M";
            tbFDate.Text = ddlFDate.SelectedValue.Replace("M0", "").Replace("M", "");
            tbTDate.Text = ddlTDate.SelectedValue.Replace("M0", "").Replace("M", "");
        }
        if (Convert.ToInt32(tbDiffDate.Text) < 0)
        {
            Page.ClientScript.RegisterStartupScript(Page.GetType(), "message", "<script language='javascript'>alert('開始時間不能大於結束時間！');</script>");
            return;
        }
        if (cbCPFlag.Checked == true)   /*判斷是否有選擇"CELL2 PRODID"的選項*/
        {
            tbCPFlag.Text = "C";
        }
        else
        {
            tbCPFlag.Text = "P";
        }
        /*--------------------------------------------------------------------------------------*/
        tbSqlDate.Text = "";
        if (tbDateType.Text == "D") { tbSqlDate.Text = tbSqlDate.Text + " WHERE ReportDate >= '" + tbFDate.Text + "' AND ReportDate <= '" + tbTDate.Text + "' "; }
        if (tbDateType.Text == "W") { tbSqlDate.Text = tbSqlDate.Text + " WHERE ReportYear = '" + ddlYear.SelectedValue + "' AND ReportWeek >= " + tbFDate.Text + " AND ReportWeek <= " + tbTDate.Text + " "; }
        if (tbDateType.Text == "M") { tbSqlDate.Text = tbSqlDate.Text + " WHERE ReportYear = '" + ddlYear.SelectedValue + "' AND ReportMonth >= " + tbFDate.Text + " AND ReportMonth <= " + tbTDate.Text + " "; }

        tbSqlWhere.Text = "";
        if (ddlShiftID.SelectedValue != "ShiftID") { tbSqlWhere.Text = tbSqlWhere.Text + " AND SHIFT_ID LIKE '%" + ddlShiftID.SelectedValue + "'"; }
        if (strSubLineID != "'='") { tbSqlWhere.Text = tbSqlWhere.Text + " AND SUBLINEID IN(" + strSubLineID + ")"; }
        if (strLotType != "'='") { tbSqlWhere.Text = tbSqlWhere.Text + " AND LOT_TYPE IN(" + strLotType + ")"; }
        if (tbCPFlag.Text == "C")
        {
            if (strProdID != "'='") { tbSqlWhere.Text = tbSqlWhere.Text + " AND CPRODUCT_ID IN(" + strProdID + ")"; }
        }
        else
        {
            if (strProdID != "'='") { tbSqlWhere.Text = tbSqlWhere.Text + " AND PRODUCT_ID IN(" + strProdID + ")"; }
        }
        if (strWonbr != "'='") { tbSqlWhere.Text = tbSqlWhere.Text + " AND WORK_ORDER IN(" + strWonbr + ")"; }
        /*-------------------------------------------------------------------------------------*/
        CreateYieldSessionDataTable();
        CreateDefSessionDataTable();
        /*--------------------------------------------------------------------------------------*/
        QueryFPYDataBound("TOTAL", "ALL");
        QueryFPYDataBound("Days", ddlByProdID.SelectedValue);
        QueryDefectDataBound("TOTAL", ddlByProdID.SelectedValue, "ALL");
        QueryDefectDataBound("Days", ddlByProdID.SelectedValue, "S");
        QueryDefectDataBound("Days", ddlByProdID.SelectedValue, "R");
        GridViewDataBound();
        ChartDataBound();
        DataTable dtTmp = (DataTable)Session["dtOVFPY"];
        string strLogWhere = "DateType:" + ddlDateType.SelectedValue.ToString() +
                             ";From:" + tbFDate.Text.ToString() +
                             ";To:" + tbTDate.Text.ToString() +
                             ";Year:" + ddlYear.SelectedValue.ToString() +
                             ";Cell2Prodid:" + cbCPFlag.Checked.ToString() +
                             ";Length:" + ddlPdLen.SelectedValue.ToString() +
                             ";ShiftID:" + ddlShiftID.SelectedValue.ToString() +
                             ";SelType:" + ddlSelType.SelectedValue.ToString() +        /*V1.01*/ 
                             ";SubLineID:" + strSubLineID.ToString() +
                             ";LotType:" + strLotType.ToString() +
                             ";ProdID:" + strProdID.ToString() +
                             ";Wo:" + strWonbr.ToString();
        Apc.RecordLogInfo(tbFABID.Text, tbLoginNTName.Text, "UnLogin", Session.SessionID.ToString(), "Query", HttpContext.Current.Request.Url.AbsolutePath.ToString(), tbLoginPCName.Text, tbLoginPCIP.Text, "Query-btQuery;筆數:" + dtTmp.Rows.Count.ToString(), strLogWhere.Replace("'", ""), "");
        /*--------------------------------------------------------------------------------------*/
        DateTime dtT = System.DateTime.Now;
        TimeSpan tsDiff = dtT - dtF;
        intSecCnt = Convert.ToInt32(tsDiff.TotalSeconds);
        lblTTime.Text = "查詢耗時：" + intSecCnt.ToString() + "s";
        PMain.Enabled = false;
        /*--------------------------------------------------------------------------------------*/
        IBGBYData.Enabled = true;
        cblLevel.Enabled = true;
    }
    protected void QueryFPYDataBound(string strMode, string strProdID)
    {
        try
        {
            StringBuilder strSql = new StringBuilder();
            DBConn dbConn = new DBConn(tbFABID.Text.ToString());
            string strLot1Def = " (DEF_CODE LIKE 'MD%' OR DEF_CODE LIKE 'MM%' OR DEF_CODE LIKE 'MV%' OR DEF_CODE LIKE 'ML%'  OR DEF_CODE = 'BS07' OR DEF_CODE = 'MS07' OR DEF_CODE = 'MS28' OR DEF_CODE = 'MS38' OR DEF_CODE = 'MS40' OR DEF_CODE = 'A000'OR DEF_CODE = 'MA53') ";
            string strViewDef = " (DEF_CODE LIKE 'MS%' AND DEF_CODE != 'MS07' AND DEF_CODE != 'MS28' AND DEF_CODE != 'MS38' AND DEF_CODE != 'MS40') OR DEF_CODE LIKE '99%' OR DEF_CODE LIKE 'DS%' ";
            /*-------------------------------------------------------------------------------------*/
            /*機種清單*/
            if (strMode != "Days")
            {
                strSql.Append(" SELECT DISTINCT SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN CPRODUCT_ID ELSE PRODUCT_ID END,1," + ddlPdLen.SelectedValue + ") AS PRODUCT_ID FROM YIELD_TBL_LIGHTON_PRODUCT WITH(NOLOCK) ");
                strSql.Append(tbSqlDate.Text);
                strSql.Append(" AND FAB_ID = '" + tbFABID.Text + "' ");
                strSql.Append(" AND OPERATION_ID IN('8020','8040','8050','8060','8080','808A','808B','808C','808E','808F','808G','808H','808T','8090','8180')");   /*V1.00*//*V1.02*/
                strSql.Append(tbSqlWhere.Text);
                strSql.Append(" ORDER BY SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN CPRODUCT_ID ELSE PRODUCT_ID END,1," + ddlPdLen.SelectedValue + ")");
                DataSet dt00 = new DataSet();
                SqlDataAdapter sqlApt00 = new SqlDataAdapter(strSql.ToString(), dbConn.ConnectionString);
                sqlApt00.Fill(dt00);
                if (dt00.Tables[0].Rows.Count == 0)
                {
                    Page.ClientScript.RegisterStartupScript(Page.GetType(), "message", "<script language='javascript'>alert('查無資料！');</script>");
                    return;
                }
                ddlByProdID.DataSource = dt00;
                ddlByProdID.DataTextField = "PRODUCT_ID";
                ddlByProdID.DataValueField = "PRODUCT_ID";
                ddlByProdID.DataBind();
                dt00.Dispose();
                sqlApt00.Dispose();
                strSql.Remove(0, strSql.Length);
            }
            /*-------------------------------------------------------------------------------------*/

            strSql.Remove(0, strSql.Length);
            strSql.Append(" SELECT T1.REPORTDT");                /*0 */
            strSql.Append(" ,T1.PRODUCT_ID");                /*1 */
            strSql.Append(" ,T1.OPERATION_ID");                /*2 */
            strSql.Append(" ,T1.T_CNT");                 /*3 */
            strSql.Append(" ,T1.A_CNT");                 /*4 */
            strSql.Append(" ,T1.R_CNT");                 /*5 */
            strSql.Append(" ,T1.S_CNT");                 /*6 */
            strSql.Append(" ,T1.AA_CNT");                /*7 */
            strSql.Append(" ,T1.A0_CNT");                /*8 */
            strSql.Append(" ,T1.A1_CNT");                /*9 */
            strSql.Append(" ,T1.A2_CNT");                /*10*/
            strSql.Append(" ,T1.A3_CNT");                /*11*/
            strSql.Append(" ,T1.A4_CNT");                /*12*/
            strSql.Append(" ,T1.A5_CNT");                /*13*/
            strSql.Append(" ,T1.AB_CNT");                /*14*/
            strSql.Append(" ,T1.AD_CNT");                /*15*/
            strSql.Append(" ,T1.AF_CNT");                /*16*/
            strSql.Append(" ,T1.AH_CNT");                /*17*/
            strSql.Append(" ,T1.AK_CNT");                /*18*/
            strSql.Append(" ,T1.AL_CNT");                /*19*/
            strSql.Append(" ,T1.AM_CNT");                /*20*/
            strSql.Append(" ,T1.AP_CNT");                /*21*/
            strSql.Append(" ,T1.AV_CNT");                /*22*/
            strSql.Append(" ,T1.AX_CNT");                /*23*/
            strSql.Append(" ,T1.UNDEFINE_CNT");                /*24*/
            strSql.Append(" ,ISNULL(S_LDFQty ,0) AS S_LDFQty");   /* 25*/
            strSql.Append(" ,ISNULL(S_VDFQty ,0) AS S_VDFQty");   /*26*/
            strSql.Append(" ,ISNULL(VS_LDFQty,0) AS VS_LDFQty");  /*27*/ /*特殊機種的外觀特定defect for LOT1 計算*/
            strSql.Append(" ,T1.VT_CNT ");                        /*28*/
            strSql.Append(" ,T1.VA_CNT");                         /*29*/
            strSql.Append(" ,T1.VR_CNT ");                        /*30*/
            strSql.Append(" ,T1.VS_CNT ");                        /*31*/
            strSql.Append(" ,T1.VAA_CNT ");                       /*32*/
            strSql.Append(" ,T1.VA0_CNT ");                       /*33*/
            strSql.Append(" ,T1.VA1_CNT");                        /*34*/
            strSql.Append(" ,T1.VA2_CNT ");                       /*35*/
            strSql.Append(" ,T1.VA3_CNT ");                       /*36*/
            strSql.Append(" ,T1.VA4_CNT ");                       /*37*/
            strSql.Append(" ,T1.VA5_CNT");                        /*38*/
            strSql.Append(" ,T1.VAB_CNT ");                       /*39*/
            strSql.Append(" ,T1.VAD_CNT ");                       /*40*/
            strSql.Append(" ,T1.VAF_CNT ");                       /*41*/
            strSql.Append(" ,T1.VAH_CNT ");                       /*42*/
            strSql.Append(" ,T1.VAK_CNT");                        /*43*/
            strSql.Append(" ,T1.VAL_CNT");                        /*44*/
            strSql.Append(" ,T1.VAM_CNT ");                       /*45*/
            strSql.Append(" ,T1.VAP_CNT ");                       /*46*/
            strSql.Append(" ,T1.VAV_CNT ");                       /*47*/
            strSql.Append(" ,T1.VAX_CNT ");                       /*48*/
            strSql.Append(" ,CASE WHEN T1.PRODUCT_ID  IN(SELECT PRODID FROM MRPYMSM) THEN 'SET' ELSE 'NORMAL' END AS PDFLAG");   /*49*/
            strSql.Append(" FROM(");

            strSql.Append(" SELECT CASE WHEN OPERATION_ID IN ('8080','808A','808B','808C','808E','808F','808G','808H')THEN '808ALL'");
            //strSql.Append(" WHEN OPERATION_ID IN('808E','808F','808G') THEN '808NTOTAL'");
            strSql.Append(" ELSE OPERATION_ID END AS OPERATION_ID,");
            if (strMode == "Days")
            {
                strSql.Append(" CASE WHEN '" + tbDateType.Text + "'='D' THEN CONVERT(VARCHAR(10),ReportDate,120) WHEN '" + tbDateType.Text + "'='W' THEN 'W'+RIGHT('0'+CAST(ReportWeek+1 AS VARCHAR(2)),2) WHEN '" + tbDateType.Text + "'='M' THEN 'M'+RIGHT('0'+CAST(ReportMonth AS VARCHAR(2)),2) ELSE '' END AS ReportDT,");
            }
            else
            {
                strSql.Append(" 'TOTAL' AS ReportDT,");
            }
            strSql.Append(" SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN CPRODUCT_ID ELSE PRODUCT_ID END,1," + ddlPdLen.SelectedValue + ") AS PRODUCT_ID,");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(T_CNT,0) ELSE 0 END) AS T_CNT,");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(A_CNT,0) ELSE 0 END) AS A_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(R_CNT,0) ELSE 0 END) AS R_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(S_CNT,0) ELSE 0 END) AS S_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(AA_CNT,0) ELSE 0 END) AS AA_CNT,");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(A0_CNT,0) ELSE 0 END) AS A0_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(A1_CNT,0) ELSE 0 END) AS A1_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(A2_CNT,0) ELSE 0 END) AS A2_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(A3_CNT,0) ELSE 0 END) AS A3_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(A4_CNT,0) ELSE 0 END) AS A4_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(A5_CNT,0) ELSE 0 END) AS A5_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(AB_CNT,0) ELSE 0 END) AS AB_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(AD_CNT,0) ELSE 0 END) AS AD_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(AF_CNT,0) ELSE 0 END) AS AF_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(AH_CNT,0) ELSE 0 END) AS AH_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(AK_CNT,0) ELSE 0 END) AS AK_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(AL_CNT,0) ELSE 0 END) AS AL_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(AM_CNT,0) ELSE 0 END) AS AM_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(AP_CNT,0) ELSE 0 END) AS AP_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(AV_CNT,0) ELSE 0 END) AS AV_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID NOT IN ('808E','808F','808G','808H') THEN ISNULL(AX_CNT,0) ELSE 0 END) AS AX_CNT, ");
            strSql.Append(" SUM(ISNULL(UNDEFINE_CNT,0)) AS UNDEFINE_CNT,");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(T_CNT,0) ELSE 0 END) AS VT_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(A_CNT,0) ELSE 0 END) AS VA_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(R_CNT,0) ELSE 0 END) AS VR_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(S_CNT,0) ELSE 0 END) AS VS_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(AA_CNT,0) ELSE 0 END) AS VAA_CNT,");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(A0_CNT,0) ELSE 0 END) AS VA0_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(A1_CNT,0) ELSE 0 END) AS VA1_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(A2_CNT,0) ELSE 0 END) AS VA2_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(A3_CNT,0) ELSE 0 END) AS VA3_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(A4_CNT,0) ELSE 0 END) AS VA4_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(A5_CNT,0) ELSE 0 END) AS VA5_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(AB_CNT,0) ELSE 0 END) AS VAB_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(AD_CNT,0) ELSE 0 END) AS VAD_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(AF_CNT,0) ELSE 0 END) AS VAF_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(AH_CNT,0) ELSE 0 END) AS VAH_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(AK_CNT,0) ELSE 0 END) AS VAK_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(AL_CNT,0) ELSE 0 END) AS VAL_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(AM_CNT,0) ELSE 0 END) AS VAM_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(AP_CNT,0) ELSE 0 END) AS VAP_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(AV_CNT,0) ELSE 0 END) AS VAV_CNT, ");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN ISNULL(AX_CNT,0) ELSE 0 END) AS VAX_CNT");
            strSql.Append(" FROM YIELD_TBL_LIGHTON_PRODUCT WITH(NOLOCK)");
            strSql.Append(tbSqlDate.Text);
            strSql.Append(" AND FAB_ID = '" + tbFABID.Text + "' ");
            strSql.Append(" AND (OPERATION_ID IN('8020','8040','8050','8060','8080','808A','808B','808C','808T','8090','8180')");  /*V1.00*//*V1.02*/
            strSql.Append("OR (OPERATION_ID IN('808E','808F','808G','808H') ");
            strSql.Append("AND  SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "'='C' THEN   CPRODUCT_ID ELSE PRODUCT_ID END,1," + ddlPdLen.SelectedValue + ") IN (SELECT PRODID FROM MRPYMSM))) ");
            if (strMode == "Days")
            {
                //strSql.Append(" AND PRODUCT_ID ='" + strProdID + "' ");
                strSql.Append("AND SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN CPRODUCT_ID ELSE PRODUCT_ID END,1, " + ddlPdLen.SelectedValue + ") = '" + strProdID + "' ");
            }
            strSql.Append(tbSqlWhere.Text);
            strSql.Append(" GROUP BY CASE WHEN OPERATION_ID IN ('8080','808A','808B','808C','808E','808F','808G','808H') THEN '808ALL' ELSE OPERATION_ID END,");
            strSql.Append(" SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN CPRODUCT_ID ELSE PRODUCT_ID END,1," + ddlPdLen.SelectedValue + ") ");
            if (strMode == "Days")
            {
                strSql.Append(" ,CASE WHEN '" + tbDateType.Text + "'='D' THEN CONVERT(VARCHAR(10),ReportDate,120) WHEN '" + tbDateType.Text + "'='W' THEN 'W'+RIGHT('0'+CAST(ReportWeek+1 AS VARCHAR(2)),2) WHEN '" + tbDateType.Text + "'='M' THEN 'M'+RIGHT('0'+CAST(ReportMonth AS VARCHAR(2)),2) ELSE '' END");
            }
            strSql.Append(" ) T1");
            strSql.Append(" LEFT JOIN (");
            strSql.Append(" SELECT '808ALL' AS OPERATION_ID,");
            if (strMode == "Days")
            {
                strSql.Append(" CASE WHEN '" + tbDateType.Text + "'='D' THEN CONVERT(VARCHAR(10),ReportDate,120) WHEN '" + tbDateType.Text + "'='W' THEN 'W'+RIGHT('0'+CAST(ReportWeek+1 AS VARCHAR(2)),2) WHEN '" + tbDateType.Text + "'='M' THEN 'M'+RIGHT('0'+CAST(ReportMonth AS VARCHAR(2)),2) ELSE '' END AS ReportDT,");
            }
            else
            {
                strSql.Append(" 'TOTAL' AS ReportDT,");
            }
            strSql.Append(" SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN CPRODUCT_ID ELSE PRODUCT_ID END,1," + ddlPdLen.SelectedValue + ") AS PRODUCT_ID,");

            strSql.Append(" SUM(CASE WHEN (" + strLot1Def + ") AND LOT_GRADE = 'S' THEN DEF_CNT ELSE 0 END) AS S_LDFQty,");
            strSql.Append("'0'AS VS_LDFQty, ");
            strSql.Append(" SUM(CASE WHEN (" + strViewDef + ") AND LOT_GRADE = 'S' THEN DEF_CNT ELSE 0 END) AS S_VDFQty");

            strSql.Append(" FROM NJ_TBL_LIGHTON_DEFECT WITH(NOLOCK)");
            strSql.Append(tbSqlDate.Text);
            strSql.Append(" AND FAB_ID = '" + tbFABID.Text + "' ");
            strSql.Append(" AND OPERATION_ID  IN ( '8080','808A','808B','808C')");
            strSql.Append(" AND LOT_LEVEL != 'SH'");
            strSql.Append(" AND SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN CPRODUCT_ID ELSE PRODUCT_ID END,1," + ddlPdLen.SelectedValue + ") NOT IN ( SELECT PRODID FROM MRPYMSM)");
            if (strMode == "Days")
            {
                //strSql.Append(" AND PRODUCT_ID ='" + strProdID + "' ");
                strSql.Append("AND SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN CPRODUCT_ID ELSE PRODUCT_ID END,1, " + ddlPdLen.SelectedValue + ") = '" + strProdID + "' ");
            }
            strSql.Append(tbSqlWhere.Text);
            strSql.Append(" AND DEF_CODE  != ''");
            strSql.Append(" GROUP BY ");
            strSql.Append(" SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN CPRODUCT_ID ELSE PRODUCT_ID END,1," + ddlPdLen.SelectedValue + ") ");
            if (strMode == "Days")
            {
                strSql.Append(" ,CASE WHEN '" + tbDateType.Text + "'='D' THEN CONVERT(VARCHAR(10),ReportDate,120) WHEN '" + tbDateType.Text + "'='W' THEN 'W'+RIGHT('0'+CAST(ReportWeek+1 AS VARCHAR(2)),2) WHEN '" + tbDateType.Text + "'='M' THEN 'M'+RIGHT('0'+CAST(ReportMonth AS VARCHAR(2)),2) ELSE '' END");
            }

            //-
            strSql.Append(" UNION (");
            strSql.Append(" SELECT '808ALL' AS OPERATION_ID,");
            if (strMode == "Days")
            {
                strSql.Append(" CASE WHEN '" + tbDateType.Text + "'='D' THEN CONVERT(VARCHAR(10),ReportDate,120) WHEN '" + tbDateType.Text + "'='W' THEN 'W'+RIGHT('0'+CAST(ReportWeek+1 AS VARCHAR(2)),2) WHEN '" + tbDateType.Text + "'='M' THEN 'M'+RIGHT('0'+CAST(ReportMonth AS VARCHAR(2)),2) ELSE '' END AS ReportDT,");
            }
            else
            {
                strSql.Append(" 'TOTAL' AS ReportDT,");
            }
            strSql.Append(" SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN CPRODUCT_ID ELSE PRODUCT_ID END,1," + ddlPdLen.SelectedValue + ") AS PRODUCT_ID,");

            strSql.Append(" SUM(CASE WHEN  OPERATION_ID IN ('8080','808A','808B','808C') AND (" + strLot1Def + ") AND LOT_GRADE = 'S' THEN DEF_CNT ELSE 0 END) AS S_LDFQty,");
            strSql.Append(" SUM(CASE WHEN  OPERATION_ID IN ('8080','808A','808B','808C') AND (" + strViewDef + ")  AND LOT_GRADE = 'S' THEN DEF_CNT ELSE 0 END ) AS  VS_LDFQty,");
            strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H')  AND LOT_GRADE = 'S' THEN DEF_CNT ELSE 0 END) AS S_VDFQty");

            strSql.Append(" FROM NJ_TBL_LIGHTON_DEFECT WITH(NOLOCK)");
            strSql.Append(tbSqlDate.Text);
            strSql.Append(" AND FAB_ID = '" + tbFABID.Text + "' ");
            strSql.Append(" AND OPERATION_ID  IN ( '8080','808A','808B','808C','808E','808F','808G','808H')");
            strSql.Append(" AND SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN CPRODUCT_ID ELSE PRODUCT_ID END,1," + ddlPdLen.SelectedValue + ")  IN ( SELECT PRODID FROM MRPYMSM)");
            strSql.Append(" AND LOT_LEVEL != 'SH'");
            if (strMode == "Days")
            {
                //strSql.Append(" AND PRODUCT_ID ='" + strProdID + "' ");
                strSql.Append("AND SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN CPRODUCT_ID ELSE PRODUCT_ID END,1, " + ddlPdLen.SelectedValue + ") = '" + strProdID + "' ");
            }
            strSql.Append(tbSqlWhere.Text);
            strSql.Append(" AND DEF_CODE  != ''");
            strSql.Append(" GROUP BY  ");
            strSql.Append(" SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN CPRODUCT_ID ELSE PRODUCT_ID END,1," + ddlPdLen.SelectedValue + ") ");
            if (strMode == "Days")
            {
                strSql.Append(" ,CASE WHEN '" + tbDateType.Text + "'='D' THEN CONVERT(VARCHAR(10),ReportDate,120) WHEN '" + tbDateType.Text + "'='W' THEN 'W'+RIGHT('0'+CAST(ReportWeek+1 AS VARCHAR(2)),2) WHEN '" + tbDateType.Text + "'='M' THEN 'M'+RIGHT('0'+CAST(ReportMonth AS VARCHAR(2)),2) ELSE '' END");
            }
            //--
            strSql.Append(" )) T2 ON(T1.ReportDT=T2.ReportDT AND T1.OPERATION_ID=T2.OPERATION_ID AND T1.PRODUCT_ID=T2.PRODUCT_ID) ");
            DataSet dt011 = new DataSet();
            SqlDataAdapter sqlApt011 = new SqlDataAdapter(strSql.ToString(), dbConn.ConnectionString);
            sqlApt011.Fill(dt011);
            /*-------------------------------------------------------------------------------------*/
            BoudFPYDataTable(dt011, strMode, strProdID);
            /*-------------------------------------------------------------------------------------*/
            dt011.Dispose();
            sqlApt011.Dispose();
            strSql.Remove(0, strSql.Length);
            AppClass Apc = new AppClass();
            lblDataRunTime.Text = Apc.QueryDataRunTime(tbFABID.Text).ToString();
        }
        catch (Exception ex)
        {
            throw ex;
        }
    }
    protected void QueryDefectDataBound(string strMode, string strProdID, string strGradeID)
    {
        try
        {
            StringBuilder strSql = new StringBuilder();
            DBConn dbConn = new DBConn(tbFABID.Text.ToString());
            string strLot1Def = " (DEF_CODE LIKE 'MD%' OR DEF_CODE LIKE 'MM%' OR DEF_CODE LIKE 'MV%' OR DEF_CODE LIKE 'ML%'  OR DEF_CODE = 'BS07' OR DEF_CODE = 'MS07' OR DEF_CODE = 'MS28' OR DEF_CODE = 'MS38' OR DEF_CODE = 'MS40' OR DEF_CODE = 'A000'OR DEF_CODE = 'MA53') ";
            string strViewDef = " (DEF_CODE LIKE 'MS%' AND DEF_CODE != 'MS07' AND DEF_CODE != 'MS28' AND DEF_CODE != 'MS38' AND DEF_CODE != 'MS40') OR DEF_CODE LIKE '99%' OR DEF_CODE LIKE 'DS%' ";
            if (strMode != "Days")
            {
                ddlRDefList.Items.Clear();
                ddlRDefList.Items.Clear();
            }
            /*-------------------------------------------------------------------------------------*/
            //----
            String strSql1 = "";
            strSql1 = " SELECT PRODID FROM MRPYMSM WHERE FABID='" + tbFABID.Text + "' AND PRODID='" + strProdID + "' ";
            DataTable ds = new DataTable();
            ds = dbConn.GetDataSetBySql(strSql1).Tables[0];
            if (ds.Rows.Count == 0)
            {
                //----
                /*計算各機種DefectCode數量*/
                strSql.Append(" SELECT ");
                if (strMode == "Days")
                {
                    strSql.Append(" CASE WHEN '" + tbDateType.Text + "'='D' THEN CONVERT(VARCHAR(10),ReportDate,120) WHEN '" + tbDateType.Text + "'='W' THEN 'W'+RIGHT('0'+CAST(ReportWeek+1 AS VARCHAR(2)),2) WHEN '" + tbDateType.Text + "'='M' THEN 'M'+RIGHT('0'+CAST(ReportMonth AS VARCHAR(2)),2) ELSE '' END AS ReportDT,");
                }
                else
                {
                    strSql.Append(" 'TOTAL' AS ReportDT,");
                }
                strSql.Append(" SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN A.CPRODUCT_ID ELSE A.PRODUCT_ID END,1," + ddlPdLen.SelectedValue + ") AS PRODUCT_ID,");
                strSql.Append(" LOT_GRADE, ");
                strSql.Append(" DEF_CODE, ");
                strSql.Append(" DEFECTDESC,  ");
                strSql.Append(" SUM(DEF_CNT) AS TTL_CNT,  ");
                strSql.Append(" SUM(CASE WHEN OPERATION_ID = '8020' THEN DEF_CNT ELSE 0 END) AS SEMISCRIBE,  ");
                strSql.Append(" SUM(CASE WHEN OPERATION_ID = '8040' THEN DEF_CNT ELSE 0 END) AS LCInjection,  ");
                strSql.Append(" SUM(CASE WHEN OPERATION_ID = '8050' THEN DEF_CNT ELSE 0 END) AS EndSealing,  ");
                strSql.Append(" SUM(CASE WHEN OPERATION_ID = '8060' THEN DEF_CNT ELSE 0 END) AS ROUGHCLEAN,  ");
                //strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('8080','808A','808B','808C') THEN DEF_CNT ELSE 0 END) AS LOT1_OUTVIEW,  ");
                strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('8080','808A','808B','808C') AND LOT_GRADE='S'AND (" + strLot1Def + ")THEN DEF_CNT ELSE 0 END) AS LOT1,  ");
                strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('8080','808A','808B','808C') AND LOT_GRADE='S'AND (" + strViewDef + ") THEN DEF_CNT ELSE 0 END) AS OUTVIEW,  ");
                strSql.Append(" SUM(CASE WHEN OPERATION_ID = '8090' THEN DEF_CNT ELSE 0 END) AS FINALCLEAN ");
                strSql.Append(" ,SUM(CASE WHEN OPERATION_ID = '8180' THEN DEF_CNT ELSE 0 END) AS ReLon1  ");      /*V1.00*/
                strSql.Append(" ,SUM(CASE WHEN OPERATION_ID = '808T' THEN DEF_CNT ELSE 0 END) AS LOT1_OUTVIEW_808T  ");      /*V1.02*/
                //strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN DEF_CNT ELSE 0 END) AS OUTVIEW_808E  ");
                strSql.Append(" FROM NJ_TBL_LIGHTON_DEFECT A WITH(NOLOCK),MDCM B WITH(NOLOCK) ");
                strSql.Append(tbSqlDate.Text);
                strSql.Append(" AND A.FAB_ID = '" + tbFABID.Text + "' ");
                strSql.Append(" AND A.OPERATION_ID IN('8020','8040','8050','8060','8080','808A','808B','808C','808E','808F','808G','808H','808T','8090','8180')"); /*V1.00*//*V1.02*/
                //strSql.Append(" AND PRODUCT_ID ='" + strProdID + "' ");
                strSql.Append("AND SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN CPRODUCT_ID ELSE PRODUCT_ID END,1, " + ddlPdLen.SelectedValue + ") = '" + strProdID + "' ");
                if (strGradeID == "ALL")
                {
                    strSql.Append(" AND A.LOT_GRADE IN('R','S')");
                }
                else
                {
                    strSql.Append(" AND A.LOT_GRADE = '" + strGradeID + "'");
                }
                strSql.Append(tbSqlWhere.Text);
                strSql.Append(" AND A.FAB_ID=B.FABID");
                strSql.Append(" AND A.DEF_CODE=B.DEFECTCD");
                strSql.Append(" GROUP BY ");
                if (strMode == "Days")
                {
                    strSql.Append(" CASE WHEN '" + tbDateType.Text + "'='D' THEN CONVERT(VARCHAR(10),ReportDate,120) WHEN '" + tbDateType.Text + "'='W' THEN 'W'+RIGHT('0'+CAST(ReportWeek+1 AS VARCHAR(2)),2) WHEN '" + tbDateType.Text + "'='M' THEN 'M'+RIGHT('0'+CAST(ReportMonth AS VARCHAR(2)),2) ELSE '' END, ");
                }
                strSql.Append(" SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN A.CPRODUCT_ID ELSE A.PRODUCT_ID END,1," + ddlPdLen.SelectedValue + "), ");
                strSql.Append(" LOT_GRADE,DEF_CODE,DEFECTDESC ORDER BY SUM(DEF_CNT) DESC");

                //--
            }
            else
            {
                strSql.Append(" SELECT ");
                if (strMode == "Days")
                {
                    strSql.Append(" CASE WHEN '" + tbDateType.Text + "'='D' THEN CONVERT(VARCHAR(10),ReportDate,120) WHEN '" + tbDateType.Text + "'='W' THEN 'W'+RIGHT('0'+CAST(ReportWeek+1 AS VARCHAR(2)),2) WHEN '" + tbDateType.Text + "'='M' THEN 'M'+RIGHT('0'+CAST(ReportMonth AS VARCHAR(2)),2) ELSE '' END AS ReportDT,");
                }
                else
                {
                    strSql.Append(" 'TOTAL' AS ReportDT,");
                }
                strSql.Append(" SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN A.CPRODUCT_ID ELSE A.PRODUCT_ID END,1," + ddlPdLen.SelectedValue + ") AS PRODUCT_ID,");
                strSql.Append(" LOT_GRADE, ");
                strSql.Append(" DEF_CODE, ");
                strSql.Append(" DEFECTDESC,  ");
                strSql.Append(" SUM(DEF_CNT) AS TTL_CNT,  ");
                strSql.Append(" SUM(CASE WHEN OPERATION_ID = '8020' THEN DEF_CNT ELSE 0 END) AS SEMISCRIBE,  ");
                strSql.Append(" SUM(CASE WHEN OPERATION_ID = '8040' THEN DEF_CNT ELSE 0 END) AS LCInjection,  ");
                strSql.Append(" SUM(CASE WHEN OPERATION_ID = '8050' THEN DEF_CNT ELSE 0 END) AS EndSealing,  ");
                strSql.Append(" SUM(CASE WHEN OPERATION_ID = '8060' THEN DEF_CNT ELSE 0 END) AS ROUGHCLEAN,  ");
                //strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('8080','808A','808B','808C') THEN DEF_CNT ELSE 0 END) AS LOT1_OUTVIEW,  ");
                strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('8080','808A','808B','808C') AND LOT_GRADE='S'AND (" + strLot1Def + ")THEN DEF_CNT ELSE 0 END) AS LOT1,  ");
                strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') AND LOT_GRADE='S' THEN DEF_CNT ELSE 0 END) AS OUTVIEW,  ");
                strSql.Append(" SUM(CASE WHEN OPERATION_ID = '8090' THEN DEF_CNT ELSE 0 END) AS FINALCLEAN  ");
                strSql.Append(" ,SUM(CASE WHEN OPERATION_ID = '8180' THEN DEF_CNT ELSE 0 END) AS ReLon1  ");     /*V1.00*/
                strSql.Append(" ,SUM(CASE WHEN OPERATION_ID = '808T' THEN DEF_CNT ELSE 0 END) AS LOT1_OUTVIEW_808T  ");      /*V1.02*/
                //strSql.Append(" SUM(CASE WHEN OPERATION_ID IN ('808E','808F','808G','808H') THEN DEF_CNT ELSE 0 END) AS OUTVIEW_808E  ");
                strSql.Append(" FROM NJ_TBL_LIGHTON_DEFECT A WITH(NOLOCK),MDCM B WITH(NOLOCK) ");
                strSql.Append(tbSqlDate.Text);
                strSql.Append(" AND A.FAB_ID = '" + tbFABID.Text + "' ");
                strSql.Append(" AND A.OPERATION_ID IN('8020','8040','8050','8060','8080','808A','808B','808C','808E','808F','808G','808H','808T','8090','8180')");    /*V1.00*//*V1.02*/
                //strSql.Append(" AND PRODUCT_ID ='" + strProdID + "' ");
                strSql.Append("AND SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN CPRODUCT_ID ELSE PRODUCT_ID END,1, " + ddlPdLen.SelectedValue + ") = '" + strProdID + "' ");
                if (strGradeID == "ALL")
                {
                    strSql.Append(" AND A.LOT_GRADE IN('R','S')");
                }
                else
                {
                    strSql.Append(" AND A.LOT_GRADE = '" + strGradeID + "'");
                }
                strSql.Append(tbSqlWhere.Text);
                strSql.Append(" AND A.FAB_ID=B.FABID");
                strSql.Append(" AND A.DEF_CODE=B.DEFECTCD");
                strSql.Append(" GROUP BY ");
                if (strMode == "Days")
                {
                    strSql.Append(" CASE WHEN '" + tbDateType.Text + "'='D' THEN CONVERT(VARCHAR(10),ReportDate,120) WHEN '" + tbDateType.Text + "'='W' THEN 'W'+RIGHT('0'+CAST(ReportWeek+1 AS VARCHAR(2)),2) WHEN '" + tbDateType.Text + "'='M' THEN 'M'+RIGHT('0'+CAST(ReportMonth AS VARCHAR(2)),2) ELSE '' END, ");
                }
                strSql.Append(" SUBSTRING(CASE WHEN '" + tbCPFlag.Text + "' = 'C' THEN A.CPRODUCT_ID ELSE A.PRODUCT_ID END,1," + ddlPdLen.SelectedValue + "), ");
                strSql.Append(" LOT_GRADE,DEF_CODE,DEFECTDESC ORDER BY SUM(DEF_CNT) DESC");

            }

            //--
            DataSet dt012 = new DataSet();

            SqlDataAdapter sqlApt012 = new SqlDataAdapter(strSql.ToString(), dbConn.ConnectionString);
            sqlApt012.Fill(dt012);
            /*-------------------------------------------------------------------------------------*/
            BoudDefectDataTable(dt012, strMode, strProdID, strGradeID);
            /*-------------------------------------------------------------------------------------*/
            dt012.Dispose();
            sqlApt012.Dispose();
            strSql.Remove(0, strSql.Length);
            /*-------------------------------------------------------------------------------------*/
        }
        catch (Exception ex)
        {
            throw ex;
        }
    }
    private void BoudFPYDataTable(DataSet dsTmp, string strMode, string strProdID)
    {
        try
        {
            DataTable dtOVFPY = (DataTable)Session["dtOVFPY"];
            /*-------------------------------------------------------------------------------------*/
            /*將各站點用編號區分，循環處理這幾個站點的資料*/
            for (int DTCnt = 0; DTCnt <= Convert.ToInt32(tbDiffDate.Text); DTCnt++)
            {
                string strReportDT = "";
                if (strMode != "Days")
                {
                    strReportDT = "TOTAL";
                    DTCnt = Convert.ToInt32(tbDiffDate.Text);
                }
                else
                {
                    if (tbDateType.Text == "D")
                    {
                        strReportDT = Convert.ToDateTime(tbFDate.Text).AddDays(DTCnt).ToString("yyyy-MM-dd");
                    }
                    else
                    {
                        if (Convert.ToString((Convert.ToInt32(tbFDate.Text) + DTCnt)).Length == 1)
                        {
                            if (tbDateType.Text == "M") { strReportDT = "M0" + Convert.ToString((Convert.ToInt32(tbFDate.Text) + DTCnt)); }
                        }
                        else
                        {
                            if (tbDateType.Text == "M") { strReportDT = "M" + Convert.ToString((Convert.ToInt32(tbFDate.Text) + DTCnt)); }
                        }

                        if (Convert.ToString((Convert.ToInt32(tbFDate.Text) + 1 + DTCnt)).Length == 1)
                        {
                            if (tbDateType.Text == "W") { strReportDT = "W0" + Convert.ToString((Convert.ToInt32(tbFDate.Text) + 1 + DTCnt)); }
                        }
                        else
                        {
                            if (tbDateType.Text == "W") { strReportDT = "W" + Convert.ToString((Convert.ToInt32(tbFDate.Text) + 1 + DTCnt)); }
                        }
                    }
                }
                /*-------------------------------------------------------------------------------------*/
                /*循環處理各站點的產品的數據*/
                for (int k = 0; k < Convert.ToInt32(ddlByProdID.Items.Count); k++)
                {
                    string strPRODUCTID = "";         /*產品型號*/
                    if (strMode != "Days")
                    {
                        strPRODUCTID = ddlByProdID.Items[k].Value.ToString();       /*獲取產品型號*/
                    }
                    else
                    {
                        strPRODUCTID = strProdID.ToString();       /*獲取產品型號*/
                        k = Convert.ToInt32(ddlByProdID.Items.Count);
                    }
                    /*-------------------------------------------------------------------------------------*/
                    for (int i = 0; i <= 8; i++)
                    {
                        string strOPERATIONID = "";       /*站點代碼*/
                        string strType = "";              /*站點類型描述*/
                        switch (i)
                        {
                            case 0: strOPERATIONID = "8020"; strType = "SemiScribe"; break;
                            case 1: strOPERATIONID = "8040"; strType = "LCInjection"; break;
                            case 2: strOPERATIONID = "8050"; strType = "EndSealing"; break;
                            case 3: strOPERATIONID = "8060"; strType = "RoughClean"; break;
                            case 4: strOPERATIONID = "808ALL"; strType = "LOT1"; break;
                            case 5: strOPERATIONID = "808ALL"; strType = "外觀"; break;
                            case 6: strOPERATIONID = "808T"; strType = "LOT1&外觀(808T)"; break;       /*V1.02*/
                            case 7: strOPERATIONID = "8090"; strType = "FinalClean"; break;
                            case 8: strOPERATIONID = "8180"; strType = "ReLon1"; break;     /*V1.00*/
                            default:
                                break;
                        }
                        /*查詢個站點的資料*/
                        DataRow[] drType = dsTmp.Tables[0].Select(" (REPORTDT='" + strReportDT + "' AND PRODUCT_ID='" + strPRODUCTID + "' AND OPERATION_ID='" + strOPERATIONID + "')", "PRODUCT_ID DESC");

                        if (drType.Length > 0)
                        {
                            long lngMQty = 0;
                            long lngChipQty = 0;
                            double dblAYield = 0, dblRYield = 0, dblSYield = 0, dblAAYield = 0, dblA3Yield = 0, dblA1Yield = 0, dblA2Yield = 0, dblAPYield = 0, dblAKYield = 0, dblA0Yield = 0, dblABYield = 0, dblAFYield = 0, dblAHYield = 0, dblALYield = 0, dblAXYield = 0, dblAMYield = 0, dblAVYield = 0, dblA4Yield = 0, dblADYield = 0, dblA5Yield = 0, dblALevelYield = 0;
                            long lngTarget = 0;

                            long lngDFQty = 0, lngSDFQty = 0, lngRDFQty = 0;

                            string FLG = "";
                            FLG = drType[0].ItemArray[49].ToString();

                            if (strType == "LOT1")
                            {
                                /*
                                8080(LOT1)
                                ChipQty=A+S
                                AYield=(A+S(外觀))/(ChipQty)
                                //RYield=LOT1_R/(ChipQty-LOT1_R)
                                SYield=LOT1_S/(ChipQty)
                                AAYield=(AA+S(外觀))/(ChipQty)
                                A?Yield=(A?+S(外觀))/(ChipQty)
                                //(AA+A0+A1+A2)Yield=(AA+LOT1_A0+LOT1_A1+LOT1_A2)/(ChipQty-LOT1_R)
                                */

                                if (FLG == "NORMAL")
                                {
                                    lngChipQty = Convert.ToInt32(drType[0].ItemArray[4]) + Convert.ToInt32(drType[0].ItemArray[6]);
                                    lngMQty = lngChipQty;
                                    dblAYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[4]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    dblRYield = 0;
                                    dblSYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[25])) / lngMQty, 4) * 100;
                                    dblAAYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[7]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    //dblA0Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[8]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    //dblA1Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[9]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    //dblA2Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[10]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    //dblA3Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[11]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    //dblA4Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[12]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    //dblA5Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[13]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    //dblABYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[14]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    //dblADYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[15]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    //dblAFYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[16]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    //dblAHYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[17]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    //dblAKYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[18]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    //dblALYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[19]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    //dblAMYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[20]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    //dblAPYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[21]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    //dblAVYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[22]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    //dblAXYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[23]) + Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    //dblALevelYield = 0;

                                    lngSDFQty = Convert.ToInt32(drType[0].ItemArray[25]);  // LOT1 S
                                    //lngRDFQty = Convert.ToInt32(drType[0].ItemArray[27]);
                                }
                                else
                                {
                                    lngChipQty = Convert.ToInt32(drType[0].ItemArray[4]) + Convert.ToInt32(drType[0].ItemArray[6]);
                                    lngMQty = lngChipQty;
                                    dblAYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[4]) + Convert.ToDouble(drType[0].ItemArray[27])) / lngMQty, 4) * 100;
                                    dblAAYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[7]) + Convert.ToDouble(drType[0].ItemArray[27])) / lngMQty, 4) * 100;
                                    dblSYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[25])) / lngMQty, 4) * 100;
                                    lngSDFQty = Convert.ToInt32(drType[0].ItemArray[25]);
                                }
                            }
                            else if (strType == "外觀")
                            {
                                /*
                                808ALL 外觀=(808+808A+808B+808C) 外觀
                                ChipQty=A+S(外觀)
                               
                                AYield=A/(ChipQty)
                                
                                SYield=外觀_S(特定defect)/(ChipQty)
                                AAYield=AA/(ChipQty)
                                A?Yield=A?/(ChipQty)
                                //(AA+A0+A1+A2)Yield=(AA+外觀_A0+外觀_A1+外觀_A2)/(ChipQty)
                                 */
                                if (FLG == "NORMAL")
                                {
                                    lngChipQty = Convert.ToInt32(drType[0].ItemArray[4]) + Convert.ToInt32(drType[0].ItemArray[26]);
                                    lngMQty = lngChipQty;
                                    dblAYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[4])) / lngMQty, 4) * 100;
                                    dblRYield = 0;
                                    dblSYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[26])) / lngMQty, 4) * 100;
                                    dblAAYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[7])) / lngMQty, 4) * 100;
                                    //dblA0Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[8])) / lngMQty, 4) * 100;
                                    //dblA1Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[9])) / lngMQty, 4) * 100;
                                    //dblA2Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[10])) / lngMQty, 4) * 100;
                                    //dblA3Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[11])) / lngMQty, 4) * 100;
                                    //dblA4Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[12])) / lngMQty, 4) * 100;
                                    //dblA5Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[13])) / lngMQty, 4) * 100;
                                    //dblABYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[14])) / lngMQty, 4) * 100;
                                    //dblADYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[15])) / lngMQty, 4) * 100;
                                    //dblAFYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[16])) / lngMQty, 4) * 100;
                                    //dblAHYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[17])) / lngMQty, 4) * 100;
                                    //dblAKYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[18])) / lngMQty, 4) * 100;
                                    //dblALYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[19])) / lngMQty, 4) * 100;
                                    //dblAMYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[20])) / lngMQty, 4) * 100;
                                    //dblAPYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[21])) / lngMQty, 4) * 100;
                                    //dblAVYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[22])) / lngMQty, 4) * 100;
                                    //dblAXYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[23])) / lngMQty, 4) * 100;
                                    dblALevelYield = 0;
                                    lngDFQty = 0;
                                    lngSDFQty = Convert.ToInt32(drType[0].ItemArray[26]);
                                    lngRDFQty = 0;
                                }
                                else
                                {
                                    lngChipQty = Convert.ToInt32(drType[0].ItemArray[29]) + Convert.ToInt32(drType[0].ItemArray[31]);
                                    lngMQty = lngChipQty;
                                    dblAYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[29])) / lngMQty, 4) * 100;
                                    dblAAYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[32])) / lngMQty, 4) * 100;
                                    dblSYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[31])) / lngMQty, 4) * 100;
                                    lngSDFQty = Convert.ToInt32(drType[0].ItemArray[26]);
                                }
                            }
                            /*V1.00 Begin*/
                            else if (strType == "ReLon1")
                            {
                                /*
                                ChipQty=A+R+S
                                AYield=A/(ChipQty)
                                RYield=R/(ChipQty)
                                SYield=S/(ChipQty)
                                AAYield=AA/(ChipQty)
                                A?Yield=A?/(ChipQty)
                                (AA+A0+A1+A2)Yield=A?/(ChipQty)
                                 */
                                lngMQty = Convert.ToInt32(drType[0].ItemArray[3]);
                                lngChipQty = Convert.ToInt32(drType[0].ItemArray[3]);
                                dblAYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[4])) / lngMQty, 4) * 100;
                                dblRYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[5])) / lngMQty, 4) * 100;
                                dblSYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[6])) / lngMQty, 4) * 100;
                                dblAAYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[7])) / lngMQty, 4) * 100;
                                //dblA0Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[8])) / lngMQty, 4) * 100;
                                //dblA1Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[9])) / lngMQty, 4) * 100;
                                //dblA2Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[10])) / lngMQty, 4) * 100;
                                //dblA3Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[11])) / lngMQty, 4) * 100;
                                //dblA4Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[12])) / lngMQty, 4) * 100;
                                //dblA5Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[13])) / lngMQty, 4) * 100;
                                //dblABYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[14])) / lngMQty, 4) * 100;
                                //dblADYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[15])) / lngMQty, 4) * 100;
                                //dblAFYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[16])) / lngMQty, 4) * 100;
                                //dblAHYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[17])) / lngMQty, 4) * 100;
                                //dblAKYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[18])) / lngMQty, 4) * 100;
                                //dblALYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[19])) / lngMQty, 4) * 100;
                                //dblAMYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[20])) / lngMQty, 4) * 100;
                                //dblAPYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[21])) / lngMQty, 4) * 100;
                                //dblAVYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[22])) / lngMQty, 4) * 100;
                                //dblAXYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[23])) / lngMQty, 4) * 100;
                                //dblALevelYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[7]) +
                                //Convert.ToDouble(drType[0].ItemArray[8]) +
                                //Convert.ToDouble(drType[0].ItemArray[9]) +
                                //Convert.ToDouble(drType[0].ItemArray[10])
                                //) / lngMQty, 4) * 100;
                                lngDFQty = 0;
                                lngSDFQty = Convert.ToInt32(drType[0].ItemArray[6]);
                                lngRDFQty = Convert.ToInt32(drType[0].ItemArray[5]);
                            }
                            /*V1.00 End*/
                            else
                            {
                                /*
                                ChipQty=A+R+S
                                AYield=A/(ChipQty-R)
                                RYield=R/(ChipQty-R)
                                SYield=S/(ChipQty-R)
                                AAYield=AA/(ChipQty-R)
                                A?Yield=A?/(ChipQty-R)
                                (AA+A0+A1+A2)Yield=A?/(ChipQty-R)
                                 */
                                lngMQty = Convert.ToInt32(drType[0].ItemArray[3]) - Convert.ToInt32(drType[0].ItemArray[5]);
                                lngChipQty = Convert.ToInt32(drType[0].ItemArray[3]);
                                dblAYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[4])) / lngMQty, 4) * 100;
                                dblRYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[5])) / lngMQty, 4) * 100;
                                dblSYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[6])) / lngMQty, 4) * 100;
                                dblAAYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[7])) / lngMQty, 4) * 100;
                                //dblA0Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[8])) / lngMQty, 4) * 100;
                                //dblA1Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[9])) / lngMQty, 4) * 100;
                                //dblA2Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[10])) / lngMQty, 4) * 100;
                                //dblA3Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[11])) / lngMQty, 4) * 100;
                                //dblA4Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[12])) / lngMQty, 4) * 100;
                                //dblA5Yield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[13])) / lngMQty, 4) * 100;
                                //dblABYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[14])) / lngMQty, 4) * 100;
                                //dblADYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[15])) / lngMQty, 4) * 100;
                                //dblAFYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[16])) / lngMQty, 4) * 100;
                                //dblAHYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[17])) / lngMQty, 4) * 100;
                                //dblAKYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[18])) / lngMQty, 4) * 100;
                                //dblALYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[19])) / lngMQty, 4) * 100;
                                //dblAMYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[20])) / lngMQty, 4) * 100;
                                //dblAPYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[21])) / lngMQty, 4) * 100;
                                //dblAVYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[22])) / lngMQty, 4) * 100;
                                //dblAXYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[23])) / lngMQty, 4) * 100;
                                //dblALevelYield = (lngMQty == 0) ? 0 : Math.Round((Convert.ToDouble(drType[0].ItemArray[7]) +
                                //Convert.ToDouble(drType[0].ItemArray[8]) +
                                //Convert.ToDouble(drType[0].ItemArray[9]) +
                                //Convert.ToDouble(drType[0].ItemArray[10])
                                //) / lngMQty, 4) * 100;
                                lngDFQty = 0;
                                lngSDFQty = Convert.ToInt32(drType[0].ItemArray[6]);
                                lngRDFQty = Convert.ToInt32(drType[0].ItemArray[5]);
                            }
                            lngTarget = Convert.ToInt32(drType[0].ItemArray[24]);

                            DataRow drFPY = dtOVFPY.NewRow();
                            drFPY["ReportDT"] = strReportDT;
                            drFPY["PRODUCT_ID"] = strPRODUCTID;
                            drFPY["OPERATION_ID"] = strType;
                            drFPY["Chip_Qty"] = lngChipQty;
                            drFPY["A_Yield"] = dblAYield;
                            drFPY["R_Yield"] = dblRYield;
                            drFPY["S_Yield"] = dblSYield;
                            drFPY["AA_Yield"] = dblAAYield;
                            drFPY["A0_Yield"] = dblA0Yield;
                            drFPY["A1_Yield"] = dblA1Yield;
                            drFPY["A2_Yield"] = dblA2Yield;
                            drFPY["A3_Yield"] = dblA3Yield;
                            drFPY["A4_Yield"] = dblA4Yield;
                            drFPY["A5_Yield"] = dblA5Yield;
                            drFPY["AB_Yield"] = dblABYield;
                            drFPY["AD_Yield"] = dblADYield;
                            drFPY["AF_Yield"] = dblAFYield;
                            drFPY["AH_Yield"] = dblAHYield;
                            drFPY["AK_Yield"] = dblAKYield;
                            drFPY["AL_Yield"] = dblALYield;
                            drFPY["AM_Yield"] = dblAMYield;
                            drFPY["AP_Yield"] = dblAPYield;
                            drFPY["AV_Yield"] = dblAVYield;
                            drFPY["AX_Yield"] = dblAXYield;
                            drFPY["UNDEFINE_CNT"] = lngTarget;
                            drFPY["ALevel_Yield"] = dblALevelYield;
                            drFPY["ItemNo"] = i;
                            drFPY["DFQty"] = lngDFQty;
                            drFPY["S_DFQty"] = lngSDFQty;
                            drFPY["R_DFQty"] = lngRDFQty;
                            dtOVFPY.Rows.Add(drFPY);
                            /*-------------------------------------------------------------------------------------*/
                            /*LOT1&外觀不做FPY的計算，值做當站良率顯示*/
                            //if (strType != "LOT1&外觀")
                            //{
                            /*處理FPY的數據*/
                            object[] findTheseVals = new object[3];
                            if (strMode != "Days")
                            {
                                findTheseVals[0] = "TOTAL";
                            }
                            else
                            {
                                findTheseVals[0] = strReportDT;
                            }
                            findTheseVals[1] = strPRODUCTID;
                            findTheseVals[2] = "OverAll";
                            DataRow drFPYCheck = dtOVFPY.Rows.Find(findTheseVals);

                            if (drFPYCheck == null)   /*不存在數據則新增到數據集*/
                            {
                                DataRow drFPYNew = dtOVFPY.NewRow();
                                drFPYNew.Table.Columns.Add();
                                drFPYNew["ReportDT"] = strReportDT;
                                drFPYNew["PRODUCT_ID"] = strPRODUCTID;
                                drFPYNew["OPERATION_ID"] = "OverAll";
                                drFPYNew["Chip_Qty"] = lngChipQty;
                                drFPYNew["A_Yield"] = dblAYield;
                                drFPYNew["R_Yield"] = dblRYield;
                                drFPYNew["S_Yield"] = dblSYield;
                                drFPYNew["AA_Yield"] = dblAAYield;
                                drFPYNew["A0_Yield"] = dblA0Yield;
                                drFPYNew["A1_Yield"] = dblA1Yield;
                                drFPYNew["A2_Yield"] = dblA2Yield;
                                drFPYNew["A3_Yield"] = dblA3Yield;
                                drFPYNew["A4_Yield"] = dblA4Yield;
                                drFPYNew["A5_Yield"] = dblA5Yield;
                                drFPYNew["AB_Yield"] = dblABYield;
                                drFPYNew["AD_Yield"] = dblADYield;
                                drFPYNew["AF_Yield"] = dblAFYield;
                                drFPYNew["AH_Yield"] = dblAHYield;
                                drFPYNew["AK_Yield"] = dblAKYield;
                                drFPYNew["AL_Yield"] = dblALYield;
                                drFPYNew["AM_Yield"] = dblAMYield;
                                drFPYNew["AP_Yield"] = dblAPYield;
                                drFPYNew["AV_Yield"] = dblAVYield;
                                drFPYNew["AX_Yield"] = dblAXYield;
                                drFPYNew["UNDEFINE_CNT"] = lngTarget;
                                drFPYNew["ALevel_Yield"] = dblALevelYield;
                                drFPYNew["ItemNo"] = 999;  /*設定為無限大排定優先*/
                                drFPY["DFQty"] = lngDFQty;
                                drFPY["S_DFQty"] = lngSDFQty;
                                drFPY["R_DFQty"] = lngRDFQty;
                                dtOVFPY.Rows.Add(drFPYNew);
                            }
                            else  /*存在數據則更新現有數據集*/
                            {
                                drFPYCheck.BeginEdit();
                                drFPYCheck["Chip_Qty"] = lngChipQty;
                                drFPYCheck["A_Yield"] = Math.Round(Convert.ToDouble(drFPYCheck["A_Yield"]) * dblAYield / 100, 2);
                                drFPYCheck["R_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["R_Yield"]) / 100) * (1 - dblRYield / 100), 4) * 100;
                                drFPYCheck["S_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["S_Yield"]) / 100) * (1 - dblSYield / 100), 4) * 100;
                                drFPYCheck["AA_Yield"] = Math.Round(Convert.ToDouble(drFPYCheck["AA_Yield"]) * dblAAYield / 100, 2);
                                drFPYCheck["A0_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["A0_Yield"]) / 100) * (1 - dblA0Yield / 100), 4) * 100;
                                drFPYCheck["A1_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["A1_Yield"]) / 100) * (1 - dblA1Yield / 100), 4) * 100;
                                drFPYCheck["A2_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["A2_Yield"]) / 100) * (1 - dblA2Yield / 100), 4) * 100;
                                drFPYCheck["A3_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["A3_Yield"]) / 100) * (1 - dblA3Yield / 100), 4) * 100;
                                drFPYCheck["A4_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["A4_Yield"]) / 100) * (1 - dblA4Yield / 100), 4) * 100;
                                drFPYCheck["A5_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["A5_Yield"]) / 100) * (1 - dblA5Yield / 100), 4) * 100;
                                drFPYCheck["AB_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["AB_Yield"]) / 100) * (1 - dblABYield / 100), 4) * 100;
                                drFPYCheck["AD_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["AD_Yield"]) / 100) * (1 - dblADYield / 100), 4) * 100;
                                drFPYCheck["AF_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["AF_Yield"]) / 100) * (1 - dblAFYield / 100), 4) * 100;
                                drFPYCheck["AH_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["AH_Yield"]) / 100) * (1 - dblAHYield / 100), 4) * 100;
                                drFPYCheck["AK_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["AK_Yield"]) / 100) * (1 - dblAKYield / 100), 4) * 100;
                                drFPYCheck["AL_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["AL_Yield"]) / 100) * (1 - dblALYield / 100), 4) * 100;
                                drFPYCheck["AM_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["AM_Yield"]) / 100) * (1 - dblAMYield / 100), 4) * 100;
                                drFPYCheck["AP_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["AP_Yield"]) / 100) * (1 - dblAPYield / 100), 4) * 100;
                                drFPYCheck["AV_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["AV_Yield"]) / 100) * (1 - dblAVYield / 100), 4) * 100;
                                drFPYCheck["AX_Yield"] = Math.Round(1 - (1 - Convert.ToDouble(drFPYCheck["AX_Yield"]) / 100) * (1 - dblAXYield / 100), 4) * 100;
                                drFPYCheck["UNDEFINE_CNT"] = drFPYCheck["UNDEFINE_CNT"];
                                drFPYCheck["ALevel_Yield"] = Math.Round(Convert.ToDouble(drFPYCheck["ALevel_Yield"]) * dblALevelYield / 100, 2);
                                drFPYCheck.EndEdit();
                            }
                            //}

                        }
                    }
                }
            }
            Session["dtOVFPY"] = null;
            Session["dtOVFPY"] = dtOVFPY;
        }
        catch (Exception ex)
        {
            throw ex;
        }
    }
    private void BoudDefectDataTable(DataSet dsTmp, string strMode, string strProdID, string strGradeID)
    {
        try
        {
            DataTable dtOVDef = (DataTable)Session["dtOVDef"];
            DataTable dtOVFPY = (DataTable)Session["dtOVFPY"];
            DBConn dbConn = new DBConn(tbFABID.Text.ToString());
            /*-------------------------------------------------------------------------------------*/
            /*將各站點用編號區分，循環處理這幾個站點的資料*/
            for (int DTCnt = 0; DTCnt <= Convert.ToInt32(tbDiffDate.Text); DTCnt++)
            {
                string strReportDT = "";
                if (strMode != "Days")
                {
                    strReportDT = "TOTAL";
                    DTCnt = Convert.ToInt32(tbDiffDate.Text);
                }
                else
                {
                    if (tbDateType.Text == "D")
                    {
                        strReportDT = Convert.ToDateTime(tbFDate.Text).AddDays(DTCnt).ToString("yyyy-MM-dd");
                    }
                    else
                    {
                        if (Convert.ToString((Convert.ToInt32(tbFDate.Text) + DTCnt)).Length == 1)
                        {
                            if (tbDateType.Text == "M") { strReportDT = "M0" + Convert.ToString((Convert.ToInt32(tbFDate.Text) + DTCnt)); }
                        }
                        else
                        {
                            if (tbDateType.Text == "M") { strReportDT = "M" + Convert.ToString((Convert.ToInt32(tbFDate.Text) + DTCnt)); }
                        }

                        if (Convert.ToString((Convert.ToInt32(tbFDate.Text) + 1 + DTCnt)).Length == 1)
                        {
                            if (tbDateType.Text == "W") { strReportDT = "W0" + Convert.ToString((Convert.ToInt32(tbFDate.Text) + 1 + DTCnt)); }
                        }
                        else
                        {
                            if (tbDateType.Text == "W") { strReportDT = "W" + Convert.ToString((Convert.ToInt32(tbFDate.Text) + 1 + DTCnt)); }
                        }
                    }
                }
                /*-------------------------------------------------------------------------------------*/
                string strPRODUCTID = "";         /*產品型號*/
                strPRODUCTID = strProdID.ToString();       /*獲取產品型號*/
                /*-------------------------------------------------------------------------------------*/
                /*處理各產品的S&R DefectCode的數據*/
                for (int i = 0; i < 2; i++)
                {
                    string strGrade = "";
                    if (strGradeID != "ALL")
                    {
                        strGrade = strGradeID;
                        i = 2;
                    }
                    else
                    {
                        switch (i)
                        {
                            case 0: strGrade = "S"; break;
                            case 1: strGrade = "R"; break;
                            default:
                                return;
                        }
                    }
                    /*-------------------------------------------------------------------------------------*/
                    DataRow[] drDef = dsTmp.Tables[0].Select(" (REPORTDT='" + strReportDT + "' AND PRODUCT_ID='" + strPRODUCTID + "' AND LOT_GRADE = '" + strGrade + "' )", "TTL_CNT DESC");
                    String strSql1 = "";
                    String FLG = "";
                    strSql1 = "";
                    strSql1 = " SELECT PRODID FROM MRPYMSM WHERE FABID='" + tbFABID.Text + "' AND PRODID='" + strProdID + "' ";
                    DataTable ds = new DataTable();
                    ds = dbConn.GetDataSetBySql(strSql1).Tables[0];
                    if (ds.Rows.Count == 1)
                    {
                        FLG = "1";
                    }
                    else
                    {
                        FLG = "0";
                    }
                    if (drDef.Length > 0)
                    {
                        for (int DefCnt = 0; DefCnt < Convert.ToInt32(drDef.Length); DefCnt++)
                        {

                            if (strMode != "Days")
                            {
                                if (strGrade == "S")
                                {
                                    ddlSDefList.Items.Add(drDef[DefCnt].ItemArray[3].ToString() + " " + drDef[DefCnt].ItemArray[4].ToString());
                                }
                                if (strGrade == "R")
                                {
                                    ddlRDefList.Items.Add(drDef[DefCnt].ItemArray[3].ToString() + " " + drDef[DefCnt].ItemArray[4].ToString());
                                }
                            }
                            long lng8020 = 0, lng8040 = 0, lng8050 = 0, lng8060 = 0,/* lng8080 = 0,*/ lng8090 = 0, lngVIEWR1 = 0, lng808T = 0, lngLOT1R = 0, lngVIEWR = 0, lngLOT1S = 0, lngLOT = 0, lng8180 = 0;   /*V1.00*//*V1.02*/
                            double dblDefectRate = 1;
                            double dbRelon1Rate = 0;     /*V1.01*/ 
                            DataRow[] dr8020 = dtOVFPY.Select(" (REPORTDT='" + strReportDT + "' AND PRODUCT_ID='" + strPRODUCTID + "' AND OPERATION_ID='SemiScribe')");
                            DataRow[] dr8040 = dtOVFPY.Select(" (REPORTDT='" + strReportDT + "' AND PRODUCT_ID='" + strPRODUCTID + "' AND OPERATION_ID='LCInjection')");
                            DataRow[] dr8050 = dtOVFPY.Select(" (REPORTDT='" + strReportDT + "' AND PRODUCT_ID='" + strPRODUCTID + "' AND OPERATION_ID='EndSealing')");
                            DataRow[] dr8060 = dtOVFPY.Select(" (REPORTDT='" + strReportDT + "' AND PRODUCT_ID='" + strPRODUCTID + "' AND OPERATION_ID='RoughClean')");
                            //DataRow[] dr8080 = dtOVFPY.Select(" (REPORTDT='" + strReportDT + "' AND PRODUCT_ID='" + strPRODUCTID + "' AND OPERATION_ID='LOT1&外觀')");
                            DataRow[] dr808T = dtOVFPY.Select(" (REPORTDT='" + strReportDT + "' AND PRODUCT_ID='" + strPRODUCTID + "' AND OPERATION_ID='LOT1&外觀(808T)')");  /*V1.02*/
                            DataRow[] dr8090 = dtOVFPY.Select(" (REPORTDT='" + strReportDT + "' AND PRODUCT_ID='" + strPRODUCTID + "' AND OPERATION_ID='FinalClean')");
                            DataRow[] dr8180 = dtOVFPY.Select(" (REPORTDT='" + strReportDT + "' AND PRODUCT_ID='" + strPRODUCTID + "' AND OPERATION_ID='ReLon1')");        /*V1.00*/
                            //DataRow[] dr808E = dtOVFPY.Select(" (REPORTDT='" + strReportDT + "' AND PRODUCT_ID='" + strPRODUCTID + "' AND OPERATION_ID='外觀(n)')");

                            DataRow[] drLOT1 = dtOVFPY.Select(" (REPORTDT='" + strReportDT + "' AND PRODUCT_ID='" + strPRODUCTID + "' AND OPERATION_ID='LOT1')");
                            DataRow[] drVIEW = dtOVFPY.Select(" (REPORTDT='" + strReportDT + "' AND PRODUCT_ID='" + strPRODUCTID + "' AND OPERATION_ID='外觀')");

                            if (dr8020.Length > 0)
                            {
                                lng8020 = Convert.ToInt32(dr8020[0].ItemArray[3]);
                                if (lng8020 != 0)
                                {
                                    dblDefectRate = dblDefectRate * (1 - Convert.ToDouble(drDef[DefCnt].ItemArray[6]) / lng8020);
                                }
                            }
                            if (dr8040.Length > 0)
                            {
                                lng8040 = Convert.ToInt32(dr8040[0].ItemArray[3]);
                                if (lng8040 != 0)
                                {
                                    dblDefectRate = dblDefectRate * (1 - Convert.ToDouble(drDef[DefCnt].ItemArray[7]) / lng8040);
                                }
                            }
                            if (dr8050.Length > 0)
                            {
                                lng8050 = Convert.ToInt32(dr8050[0].ItemArray[3]);
                                if (lng8050 != 0)
                                {
                                    dblDefectRate = dblDefectRate * (1 - Convert.ToDouble(drDef[DefCnt].ItemArray[8]) / lng8050);
                                }
                            }
                            if (dr8060.Length > 0)
                            {
                                lng8060 = Convert.ToInt32(dr8060[0].ItemArray[3]);
                                if (lng8060 != 0)
                                {
                                    dblDefectRate = dblDefectRate * (1 - Convert.ToDouble(drDef[DefCnt].ItemArray[9]) / lng8060);
                                }
                            }
                            
                            if (drLOT1.Length > 0)
                            {
                                lngLOT = Convert.ToInt32(drLOT1[0].ItemArray[3]);
                            }
                            if (drLOT1.Length > 0)
                            {
                                lngLOT1R = Convert.ToInt32(drLOT1[0].ItemArray[29]);
                                if ((lngLOT - lngLOT1R) != 0)
                                {
                                    dblDefectRate = dblDefectRate * (1 - Convert.ToDouble(drDef[DefCnt].ItemArray[10]) / (lngLOT - lngLOT1R));
                                }
                            }
                            if (FLG == "0")
                            {
                                if (drVIEW.Length > 0)
                                {
                                    lngLOT1S = Convert.ToInt32(drLOT1[0].ItemArray[28]);
                                    lngVIEWR = Convert.ToInt32(drVIEW[0].ItemArray[29]);
                                    if ((lngLOT - lngVIEWR - lngLOT1S) != 0)
                                    {
                                        dblDefectRate = dblDefectRate * (1 - Convert.ToDouble(drDef[DefCnt].ItemArray[11]) / (lngLOT - lngVIEWR - lngLOT1S));
                                    }
                                }
                            }
                            else
                            {
                                if (drVIEW.Length > 0)
                                {
                                    lngVIEWR1 = Convert.ToInt32(drVIEW[0].ItemArray[3]);
                                    if (lngVIEWR1 != 0)
                                    {
                                        dblDefectRate = dblDefectRate * (1 - Convert.ToDouble(drDef[DefCnt].ItemArray[11]) / lngVIEWR1);
                                    }
                                }
                            }
                            /*V1.02 Begin*/
                            if (dr808T.Length > 0)
                            {
                                lng808T = Convert.ToInt32(dr808T[0].ItemArray[3]);
                                if (lng808T != 0)
                                {
                                    dblDefectRate = dblDefectRate * (1 - Convert.ToDouble(drDef[DefCnt].ItemArray[14]) / lng808T);
                                }
                            }
                            /*V1.02 End*/ 
                            if (dr8090.Length > 0)
                            {
                                lng8090 = Convert.ToInt32(dr8090[0].ItemArray[3]);
                                if (lng8090 != 0)
                                {
                                    dblDefectRate = dblDefectRate * (1 - Convert.ToDouble(drDef[DefCnt].ItemArray[12]) / lng8090);
                                }
                            }
                            /*V1.00 Begin*/
                            if (dr8180.Length > 0)
                            {
                                if (ddlSelType.SelectedValue == "BEOL")        /*V1.01*/
                                {
                                    lng8180 = Convert.ToInt32(dr8180[0].ItemArray[3]);
                                    if (lng8180 != 0)
                                    {
                                        dblDefectRate = dblDefectRate * (1 - Convert.ToDouble(drDef[DefCnt].ItemArray[13]) / lng8180);
                                        dbRelon1Rate = Convert.ToDouble(drDef[DefCnt].ItemArray[13]) / lng8180;   /*V1.01*/ 
                                    }
                                }
                            }
                            /*V1.00 End*/   
                            /*-------------------------------------------------------------------------------------*/
                            DataRow drNew = dtOVDef.NewRow();
                            drNew.Table.Columns.Add();
                            drNew["ReportDT"] = strReportDT;
                            drNew["PRODUCT_ID"] = strPRODUCTID;
                            drNew["LOTGRADE"] = strGrade;
                            drNew["DEFCODE"] = drDef[DefCnt].ItemArray[3].ToString();
                            drNew["DEFECTDESC"] = drDef[DefCnt].ItemArray[4].ToString();
                            drNew["TTL_CNT"] = Convert.ToInt32(drDef[DefCnt].ItemArray[5]);
                            drNew["SEMISCRIBE"] = Convert.ToInt32(drDef[DefCnt].ItemArray[6]);
                            drNew["LCInjection"] = Convert.ToInt32(drDef[DefCnt].ItemArray[7]);
                            drNew["EndSealing"] = Convert.ToInt32(drDef[DefCnt].ItemArray[8]);
                            drNew["ROUGHCLEAN"] = Convert.ToInt32(drDef[DefCnt].ItemArray[9]);
                            //drNew["LOT1_OUTVIEW"] = Convert.ToInt32(drDef[DefCnt].ItemArray[10]);
                            drNew["LOT1"] = Convert.ToInt32(drDef[DefCnt].ItemArray[10]);
                            drNew["OUTVIEW"] = Convert.ToInt32(drDef[DefCnt].ItemArray[11]);
                            drNew["LOT1_OUTVIEW_808T"] = Convert.ToInt32(drDef[DefCnt].ItemArray[14]); /*V1.02*/
                            drNew["FINALCLEAN"] = Convert.ToInt32(drDef[DefCnt].ItemArray[12]);
                            //drNew["OUTVIEW_808E"] = Convert.ToInt32(drDef[DefCnt].ItemArray[14]);
                            drNew["ReLon1"] = Convert.ToInt32(drDef[DefCnt].ItemArray[13]);          /*V1.00*/
                            drNew["ReLon1Rate"] = Math.Round(dbRelon1Rate, 4) * 100;                  /*V1.01*/
                            drNew["DefectRate"] = Math.Round(1 - dblDefectRate, 4) * 100;
                            drNew["Percentage"] = 0;
                            drNew["ItemNo"] = DefCnt;
                            dtOVDef.Rows.Add(drNew);
                            /*-------------------------------------------------------------------------------------*/
                        }
                    }
                }
            }
            Session["dtOVDef"] = null;
            Session["dtOVDef"] = dtOVDef;
        }
        catch (Exception ex)
        {
            throw ex;
        }
    }
    protected void QueryDataGroupByFPY()
    {
        DataTable dtOVFPY = (DataTable)Session["dtOVFPY"];
        dtOVFPY.DefaultView.RowFilter = "";
        DataRow[] drChart = dtOVFPY.Select("ReportDT='TOTAL' AND OPERATION_ID='OverAll'", "PRODUCT_ID");
        if (drChart.Length > 0)
        {
            ChartAll.Series.Clear();
            ChartAll.DataSource = "";
            ChartAll.Series.Clear();

            ChartAll.Series.Add("Series1");
            ChartAll.Titles.Add("Title1");
            ChartAll.DataSource = drChart;

            ChartAll.Series["Series1"].Color = System.Drawing.Color.FromArgb(71, 94, 118);
            ChartAll.Series["Series1"].BackGradientType = GradientType.VerticalCenter;
            ChartAll.Series["Series1"].Name = "Chip_Qty";
            ChartAll.Series["Chip_Qty"].ValueMemberX = "PRODUCT_ID";
            ChartAll.Series["Chip_Qty"].ValueMembersY = "Chip_Qty";
            ChartAll.Series["Chip_Qty"].XValueType = ChartValueTypes.String;
            ChartAll.Series["Chip_Qty"].ToolTip = " #VALX:  #VALY{##,##0.##}";

            int Cnt = 1;
            foreach (ListItem li in this.cblLevel.Items)
            {
                if (li.Selected)
                {
                    Cnt = Cnt + 1;
                    if (Cnt == 2) { ChartAll.Series.Add("Series2"); ChartAll.Series["Series2"].Color = Color.Red; }
                    if (Cnt == 3) { ChartAll.Series.Add("Series3"); ChartAll.Series["Series3"].Color = Color.Lime; }
                    if (Cnt == 4) { ChartAll.Series.Add("Series4"); ChartAll.Series["Series4"].Color = Color.Olive; }
                    if (Cnt == 5) { ChartAll.Series.Add("Series5"); ChartAll.Series["Series4"].Color = Color.White; }

                    ChartAll.Series["Series" + Cnt.ToString()].Name = li.Value + "_Yield";
                    ChartAll.Series[li.Value + "_Yield"].ValueMemberX = "PRODUCT_ID";
                    ChartAll.Series[li.Value + "_Yield"].ValueMembersY = li.Value + "_Yield";
                    ChartAll.Series[li.Value + "_Yield"].Type = SeriesChartType.Line;
                    ChartAll.Series[li.Value + "_Yield"].YAxisType = AxisType.Secondary;
                    ChartAll.Series[li.Value + "_Yield"].MarkerStyle = MarkerStyle.Triangle;
                    ChartAll.Series[li.Value + "_Yield"].XValueType = ChartValueTypes.String;
                    ChartAll.Series[li.Value + "_Yield"].ToolTip = " #VALX:  #VALY{##,##0.##}";


                }
            }


            ChartAll.Titles[0].Alignment = ContentAlignment.TopCenter;
            ChartAll.Titles[0].Font = new Font("Arial", 12, FontStyle.Bold);
            ChartAll.Titles[0].Color = Color.Blue;
            ChartAll.Titles[0].Text = tbFABName.Text + " BEOL Over All Yield";

            ChartAll.ChartAreas["Default"].BackColor = System.Drawing.Color.FromArgb(196, 189, 219);
            ChartAll.ChartAreas["Default"].AxisX.LabelStyle.FontAngle = -60;
            ChartAll.ChartAreas["Default"].AxisX.Interval = 1;
            ChartAll.ChartAreas["Default"].AxisX.Title = "PRODUCT_ID";
            ChartAll.ChartAreas["Default"].AxisY.Title = "Chip_Qty";
            ChartAll.ChartAreas["Default"].AxisY.LabelStyle.Format = "##,##0.##";
            ChartAll.ChartAreas["Default"].AxisY2.Title = "Yield(%) ";
            ChartAll.ChartAreas["Default"].AxisY2.LabelStyle.Format = "##,##0.##";
            ChartAll.ChartAreas["Default"].AxisY.MajorGrid.LineStyle = ChartDashStyle.Dot;
            ChartAll.ChartAreas["Default"].AxisY.MajorGrid.LineColor = Color.White;
            ChartAll.ChartAreas["Default"].AxisY2.MajorGrid.LineStyle = ChartDashStyle.Dot;
            ChartAll.ChartAreas["Default"].AxisY2.MajorGrid.LineColor = Color.White;
            ChartAll.ChartAreas["Default"].AxisX.MajorGrid.LineStyle = ChartDashStyle.Dot;
            ChartAll.ChartAreas["Default"].AxisX.MajorGrid.LineColor = Color.White;

            ChartAll.BackColor = System.Drawing.Color.FromArgb(234, 234, 234);

            ChartAll.UI.Toolbar.Enabled = true;
            ChartAll.UI.Toolbar.Position.Width = 28;
            ChartAll.UI.Toolbar.BorderStyle = 0;

            ChartAll.Visible = true;
            ChartAll.DataBind();
        }
    }
