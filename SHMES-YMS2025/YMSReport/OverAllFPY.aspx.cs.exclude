    }
    protected void ClearDataBound()
    {
        lblDataRunTime.Text = "";
        tbDateType.Text = "";
        tbCPFlag.Text = "";
        tbFDate.Text = "";
        tbTDate.Text = "";
        tbDiffDate.Text = "0";

        tbSqlDate.Text = "";
        tbSqlWhere.Text = "";

        lblFabID.Text = tbFABName.Text;

        Session["dtOVFPY"] = null;
        Session["dtOVDef"] = null;

        PMain.Enabled = true;
        PMain.Height = 60;

        ChangeHeight();
        ClearChartBound();
        PageTitleBound();

        IBGBYData.Enabled = false;
        PTotal.Visible = false;

        ddlByProdID.Items.Clear();
        ddlSDefList.Items.Clear();
        ddlRDefList.Items.Clear();
        GetSubject();

        cblLevel.SelectedIndex = 0;
        cblLevel.Enabled = false;

        GridView1.Dispose();
        GridView2.Dispose();
        GridView3.Dispose();
        GridView4.Dispose();
        GridView5.Dispose();
        GridView6.Dispose();
        GridView7.Dispose();

        GridView1.DataBind();
        GridView2.DataBind();
        GridView3.DataBind();
        GridView4.DataBind();
        GridView5.DataBind();
        GridView6.DataBind();
        GridView7.DataBind();
        lblTTime.Text = "";
        lblTime01.Text = "";
        lblTime02.Text = "";
        lblTime03.Text = "";
        GC.Collect();
    }
