    protected void GridViewDataBound()
    {
        DataTable dtOVFPY = (DataTable)Session["dtOVFPY"];
        DataTable dtOVDef = (DataTable)Session["dtOVDef"];
        dtOVFPY.DefaultView.RowFilter = "";
        dtOVFPY.DefaultView.RowFilter = "(ReportDT='Total' AND OPERATION_ID='OverAll')";
        dtOVFPY.DefaultView.Sort = "ReportDT,ItemNo";
        GridView1.DataSource = dtOVFPY;
        GridView1.DataBind();

        dtOVFPY.DefaultView.RowFilter = "";
        dtOVFPY.DefaultView.RowFilter = "(ReportDT='Total' AND PRODUCT_ID = '" + ddlByProdID.SelectedValue + "' )";
        dtOVFPY.DefaultView.Sort = "ItemNo";
        GridView2.DataSource = dtOVFPY;
        GridView2.DataBind();
        dtOVFPY.DefaultView.RowFilter = "";

        dtOVFPY.DefaultView.RowFilter = "";
        dtOVFPY.DefaultView.RowFilter = "(ReportDT<>'Total' AND PRODUCT_ID = '" + ddlByProdID.SelectedValue + "' AND OPERATION_ID='OverAll'  )";
        dtOVFPY.DefaultView.Sort = "ReportDT,ItemNo";
        GridView3.DataSource = dtOVFPY;
        GridView3.DataBind();
        dtOVFPY.DefaultView.RowFilter = "";

        dtOVDef.DefaultView.RowFilter = "";
        dtOVDef.DefaultView.RowFilter = "(ReportDT='Total' AND PRODUCT_ID = '" + ddlByProdID.SelectedValue + "' AND LOTGRADE='S')";
        //dtOVDef.DefaultView.Sort = "ReportDT,DefectRate DESC";
        GridView4.DataSource = dtOVDef;
        GridView4.DataBind();

        dtOVDef.DefaultView.RowFilter = "";
        dtOVDef.DefaultView.RowFilter = "(ReportDT<>'Total' AND PRODUCT_ID = '" + ddlByProdID.SelectedValue + "' AND DEFCODE = '" + ddlSDefList.SelectedValue.ToString().Split(' ')[0].Trim().ToString() + "' AND LOTGRADE='S')";
        dtOVDef.DefaultView.Sort = "ReportDT,DefectRate DESC";
        GridView5.DataSource = dtOVDef;
        GridView5.DataBind();
        dtOVDef.DefaultView.RowFilter = "";
        dtOVDef.DefaultView.RowFilter = "(ReportDT='Total' AND PRODUCT_ID = '" + ddlByProdID.SelectedValue + "' AND LOTGRADE='R')";
        dtOVDef.DefaultView.Sort = "ReportDT,DefectRate DESC";
        GridView6.DataSource = dtOVDef;
        GridView6.DataBind();
        dtOVDef.DefaultView.RowFilter = "";
        dtOVDef.DefaultView.RowFilter = "(ReportDT<>'Total' AND PRODUCT_ID = '" + ddlByProdID.SelectedValue + "' AND DEFCODE = '" + ddlRDefList.SelectedValue.ToString().Split(' ')[0].Trim().ToString() + "' AND LOTGRADE='R')";
        dtOVDef.DefaultView.Sort = "ReportDT,DefectRate DESC";
        GridView7.DataSource = dtOVDef;
        GridView7.DataBind();
        dtOVDef.DefaultView.RowFilter = "";
    }
    protected void ddlByProdID_SelectedIndexChanged(object sender, EventArgs e)
    {
        DataTable dtOVFPY = (DataTable)Session["dtOVFPY"];
        AppClass Apc = new AppClass();
        ClearChartBound();
        int intSecCnt = 0;
        lblTime01.Text = "";
        DateTime dtF = System.DateTime.Now;
        dtOVFPY.DefaultView.RowFilter = "";
        DataRow[] drsDel = dtOVFPY.Select("ReportDT<>'Total'");
        foreach (DataRow drDel in drsDel)
        {
            dtOVFPY.Rows.Remove(drDel);
        }
        dtOVFPY.DefaultView.RowFilter = "";
        Session["dtOVFPY"] = null;
        Session["dtOVFPY"] = dtOVFPY;

        QueryFPYDataBound("Days", ddlByProdID.SelectedValue);
        ddlSDefList.Items.Clear();
        ddlRDefList.Items.Clear();
        CreateDefSessionDataTable();
        QueryDefectDataBound("TOTAL", ddlByProdID.SelectedValue, "ALL");
        QueryDefectDataBound("Days", ddlByProdID.SelectedValue, "S");
        QueryDefectDataBound("Days", ddlByProdID.SelectedValue, "R");
        GridViewDataBound();
        ChartDataBound();
        Apc.RecordLogInfo(tbFABID.Text, tbLoginNTName.Text, "UnLogin", Session.SessionID.ToString(), "Query", HttpContext.Current.Request.Url.AbsolutePath.ToString(), tbLoginPCName.Text, tbLoginPCIP.Text, "Query-ddlByProdID", "ProdID:" + ddlByProdID.SelectedValue.ToString(), "");

        DateTime dtT = System.DateTime.Now;
        TimeSpan tsDiff = dtT - dtF;
        intSecCnt = Convert.ToInt32(tsDiff.TotalSeconds);
        lblTime01.Text = "查詢耗時：" + intSecCnt.ToString() + "s";

        lblTime02.Text = "";
        lblTime03.Text = "";
    }
    protected void cblLevel_SelectedIndexChanged(object sender, EventArgs e)
    {
        if (cblLevel.Items.Count >= 4)
        {
            int Cnt = 0;
            foreach (ListItem li in this.cblLevel.Items)
            {
                if (li.Selected)
                {
                    Cnt = Cnt + 1;
                }
            }
            if (Cnt >= 4)
            {
                Page.ClientScript.RegisterStartupScript(Page.GetType(), "message", "<script language='javascript'>alert('選擇項目過多，不能操作3個，請重新選擇！');</script>");
                cblLevel.SelectedIndex = 0;
            }
        }
        ChartDataBound();
    }
    protected void ChartDataBound()
    {
        lblFabID.Text = tbFABName.Text;
        PageTitleBound();
        ClearChartBound();
        QueryDataGroupByFPY();
        QueryDataGroupByProdID();
        QueryDataGroupByReportDT();
        QueryDataGroupBySDefectCode();
        QueryDataGroupByRDefectCode();
        QueryDataGroupBySDefectCodeDT();
        QueryDataGroupByRDefectCodeDT();
    }
    protected void ExportExcel_Click(object sender, EventArgs e)
    {
        AppClass Apc = new AppClass();
        Apc.RecordLogInfo(tbFABID.Text, tbLoginNTName.Text, "UnLogin", Session.SessionID.ToString(), "Export", HttpContext.Current.Request.Url.AbsolutePath.ToString(), tbLoginPCName.Text, tbLoginPCIP.Text, "Export-Excel", "", "");
        Response.Clear();
        Response.Buffer = false;
        Response.Charset = "UTF-8";
        //Response.ContentType = "Content-Language;content=UTF-8";
        Response.AppendHeader("Content-Disposition", "attachment;filename=addNewWorker.xls");
        Response.ContentEncoding = System.Text.Encoding.GetEncoding("BIG5");
        Response.ContentType = "application/ms-excel";
        Response.Write("<meta http-equiv=Content-Type content=\"text/html; charset=BIG5\">");
        this.EnableViewState = false;
        System.IO.StringWriter oStringWriter = new System.IO.StringWriter();
        System.Web.UI.HtmlTextWriter oHtmlTextWriter = new System.Web.UI.HtmlTextWriter(oStringWriter);
        this.GridView1.RenderControl(oHtmlTextWriter);
        this.GridView2.RenderControl(oHtmlTextWriter);
        this.GridView3.RenderControl(oHtmlTextWriter);
        this.GridView4.RenderControl(oHtmlTextWriter);
        this.GridView5.RenderControl(oHtmlTextWriter);
        this.GridView6.RenderControl(oHtmlTextWriter);
        this.GridView7.RenderControl(oHtmlTextWriter);
        Response.Output.Write(oStringWriter.ToString());
        Response.End();
    }
