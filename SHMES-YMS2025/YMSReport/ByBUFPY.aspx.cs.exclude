    protected void Page_Load(object sender, EventArgs e)
    {
        // if (Session["Login"] == null)
        //{            
        //    tbFABID.Text = "";
        //    tbFABName.Text = "";
        //    Page.Response.Redirect(@"~\Default.aspx");
        //    return;
        //}
        if (Session["Login"] == null)
        {
            HyperLink1.Visible = false;
        }
        if (!Page.IsPostBack)
        {
            cbSpanTwoYears.Checked = false;
            AppClass Apc = new AppClass();
            if (Request.QueryString["FABID"] != null)
            {
                tbFABID.Text = this.Request.QueryString["FABID"].ToString();
                if (tbFABID.Text == "B")
                {
                    tbFABName.Text = "SH";
                }
                /*---------------------------------------------*/
                Session["Login"] = tbFABID.Text.ToString();
                /*---------------------------------------------*/

                string strLoginPCName = "";
                string strLoginPCIP = "";
                string strLoginNTName = "";
                tbLoginNTName.Text = "";
                tbLoginPCIP.Text = "";
                tbLoginPCName.Text = "";

                Apc.GetLoginInfo(out strLoginPCName, out strLoginPCIP, out strLoginNTName);

                tbLoginNTName.Text = strLoginNTName;
                tbLoginPCIP.Text = strLoginPCIP;
                tbLoginPCName.Text = strLoginPCName;
                HyperLink1.NavigateUrl = "~/MainButton.aspx?FABID=" + tbFABID.Text.Trim();
                Apc.RecordLogInfo(tbFABID.Text, tbLoginNTName.Text, "UnLogin", Session.SessionID.ToString(), "Browse", HttpContext.Current.Request.Url.AbsolutePath.ToString(), tbLoginPCName.Text, tbLoginPCIP.Text, "Choose Report", tbFABID.Text.ToString(), "");
            }
            else
            {
                Page.Response.Redirect(@"~\Default.aspx");
            }
            if (tbFABName.Text == "")
            {
                Page.Response.Redirect(@"~\Default.aspx");
                return;
            }

            lblFabID.Text = tbFABName.Text;
            lblTTime.Text = "";
            lblTTime1.Text = "";
            tbFdate.Text = "";
            tbTdate.Text = "";
            tbFweek.Text = "";
            tbTweek.Text = "";
            tbFmonth.Text = "";
            tbTmonth.Text = "";
            ChKBUlist1.Enabled = false;
            PageTitleBound();
            DataBoundtxtDate();
            DataBoundBU();
            txtDate.Attributes.Add("readonly", "readonly");

            lblDataRunTime.Text = Apc.QueryDataRunTime(tbFABID.Text).ToString();

            GetSubject();
        }
    }
    protected void GetSubject()
    {
        AppClass Apc = new AppClass();
        /**************************************************************************************************************************/
        string strTitle = "";
        string strCon = "";
        string strDateTime = "";

        if (Apc.QuerySubject("ByBUFPY", "ByBUFPY", out strTitle, out strCon, out strDateTime) == true)
        {
            lblTitle.Text = strTitle.ToString();
            tbCon.Text = strCon.ToString();
            Page.ClientScript.RegisterStartupScript(Page.GetType(), "message", "<script language='javascript'>RunFunc();</script>");
        }
        else
        {
            lblTitle.Text = "";
            tbCon.Text = "";
            strDateTime = "";
        }
        /**************************************************************************************************************************/
    }
    protected void PageTitleBound()
    {
        Page.Title = "By Bu First Pass Yield";
    }
    protected void DataBoundtxtDate()
    {
        txtDate.Text = System.DateTime.Now.AddHours(-12).ToString("yyyy-MM-dd");
    }
    protected void ButnQuery_Click(object sender, EventArgs e)
    {
        /*----------------------*/
        //選擇時間推出周別月份
        int intSecCnt = 0;
        DateTime dtF = System.DateTime.Now;
        string strSql = "";
        AppClass Apc = new AppClass();
        DBConn dbConn = new DBConn(tbFABID.Text.ToString());
        strSql = "";
        if (cbSpanTwoYears.Checked == true)
        {
            strSql = strSql + " SELECT ";
            strSql = strSql + "     CONVERT(VARCHAR(7),DATEADD(MONTH,-12,'" + txtDate.Text + "'),120) AS FRMONTH, ";
            strSql = strSql + "     CONVERT(VARCHAR(7),DATEADD(MONTH,-1,'" + txtDate.Text + "'),120) AS TOMONTH, ";
            strSql = strSql + "     CASE WHEN DATEDIFF(WW,CAST(YEAR('" + txtDate.Text + "') AS VARCHAR(4)) + '-01-01','" + txtDate.Text + "') - 4 < 0 THEN ";
            strSql = strSql + " 	    CAST(YEAR('" + txtDate.Text + "') - 1 AS VARCHAR(4))+'-'+RIGHT('0'+CAST(DATEDIFF(WW,CAST(YEAR('" + txtDate.Text + "') - 1 AS VARCHAR(4)) + '-01-01','" + txtDate.Text + "') - 4 AS VARCHAR(2)),2) ";
            strSql = strSql + "     ELSE ";
            strSql = strSql + " 	    CAST(YEAR('" + txtDate.Text + "') AS VARCHAR(4))+'-'+RIGHT('0'+CAST(DATEDIFF(WW,CAST(YEAR('" + txtDate.Text + "') AS VARCHAR(4)) + '-01-01','" + txtDate.Text + "') - 4 AS VARCHAR(2)),2) ";
            strSql = strSql + "     END AS FRWEEK, ";
            strSql = strSql + "     CASE WHEN DATEDIFF(WW,CAST(YEAR('" + txtDate.Text + "') AS VARCHAR(4)) + '-01-01','" + txtDate.Text + "') - 1 < 0 THEN ";
            strSql = strSql + " 	    CAST(YEAR('" + txtDate.Text + "') - 1 AS VARCHAR(4))+'-'+RIGHT('0'+CAST(DATEDIFF(WW,CAST(YEAR('" + txtDate.Text + "') - 1 AS VARCHAR(4)) + '-01-01','" + txtDate.Text + "') - 1 AS VARCHAR(2)),2) ";
            strSql = strSql + "     ELSE ";
            strSql = strSql + " 	    CAST(YEAR('" + txtDate.Text + "') AS VARCHAR(4))+'-'+RIGHT('0'+CAST(DATEDIFF(WW,CAST(YEAR('" + txtDate.Text + "') AS VARCHAR(4)) + '-01-01','" + txtDate.Text + "') - 1 AS VARCHAR(2)),2) ";
            strSql = strSql + "     END AS TOWEEK, ";
            strSql = strSql + "     CONVERT(VARCHAR(10),DATEADD(DAY,(DATEPART(w,'" + txtDate.Text + "') - 1) * -1,'" + txtDate.Text + "'),120) AS FRDATE, ";
            strSql = strSql + "     '" + txtDate.Text + "' AS TODATE ";
        }
        else
        {
            strSql = strSql + " SELECT ";
            strSql = strSql + " 	CAST(YEAR('" + txtDate.Text + "') AS VARCHAR(4)) + '-01' AS FRMONTH, ";
            strSql = strSql + " 	CASE WHEN DATEPART(MONTH,'" + txtDate.Text + "') = 1 THEN  ";
            strSql = strSql + " 		CAST(YEAR('" + txtDate.Text + "') AS VARCHAR(4)) + '-01'  ";
            strSql = strSql + " 	ELSE  ";
            strSql = strSql + " 		CONVERT(VARCHAR(7),DATEADD(MONTH,-1,'" + txtDate.Text + "'),120)  ";
            strSql = strSql + " 	END AS TOMONTH, ";
            strSql = strSql + " 	CASE WHEN DATEDIFF(WW,CAST(YEAR('" + txtDate.Text + "') AS VARCHAR(4)) + '-01-01','" + txtDate.Text + "') < 4 THEN  ";
            strSql = strSql + " 		CAST(YEAR('" + txtDate.Text + "') AS VARCHAR(4)) + '-01' ";
            strSql = strSql + " 	ELSE ";
            strSql = strSql + " 		CAST(YEAR('" + txtDate.Text + "') AS VARCHAR(4)) + '-' + RIGHT('0'+CAST(DATEDIFF(WW,CAST(YEAR('" + txtDate.Text + "') AS VARCHAR(4)) + '-01-01','" + txtDate.Text + "') - 4 AS VARCHAR(2)),2) ";
            strSql = strSql + " 	END AS FRWEEK, ";
            strSql = strSql + " 	CASE WHEN DATEDIFF(WW,CAST(YEAR('" + txtDate.Text + "') AS VARCHAR(4)) + '-01-01','" + txtDate.Text + "') < 1 THEN  ";
            strSql = strSql + " 		CAST(YEAR('" + txtDate.Text + "') AS VARCHAR(4)) + '-01' ";
            strSql = strSql + " 	ELSE ";
            strSql = strSql + " 		CAST(YEAR('" + txtDate.Text + "') AS VARCHAR(4)) + '-' + RIGHT('0'+CAST(DATEDIFF(WW,CAST(YEAR('" + txtDate.Text + "') AS VARCHAR(4)) + '-01-01','" + txtDate.Text + "') - 1 AS VARCHAR(2)),2) ";
            strSql = strSql + " 	END AS TOWEEK, ";
            strSql = strSql + " 	CONVERT(VARCHAR(10),DATEADD(DAY,(DATEPART(w,'" + txtDate.Text + "') - 1) * -1,'" + txtDate.Text + "'),120) AS FRDATE, ";
            strSql = strSql + " 	'" + txtDate.Text + "' AS TODATE ";
        }

        DataSet ds = dbConn.GetDataSetBySql(strSql, "");
        if (ds.Tables[0].Rows.Count == 1)
        {
            tbFmonth.Text = ds.Tables[0].Rows[0][0].ToString();
            tbTmonth.Text = ds.Tables[0].Rows[0][1].ToString();

            tbFweek.Text = ds.Tables[0].Rows[0][2].ToString();
            tbTweek.Text = ds.Tables[0].Rows[0][3].ToString();

            tbFdate.Text = ds.Tables[0].Rows[0][4].ToString();
            tbTdate.Text = ds.Tables[0].Rows[0][5].ToString();
        }
        ds.Dispose();
        /*------------------------------------------------------------------*/
        ChKBUlist1.Enabled = true;
        BtDefcode.Visible = true;
        QueryFPYDataBound();/*處理FPY數據*/
        QueryFPYBYPRODDataBound();
        Panel1.Enabled = false;
        string strLogWhere = "Date:" + txtDate.Text.ToString() +
                             ";Shop:" + DdlSHOP.SelectedValue.ToString();
        Apc.RecordLogInfo(tbFABID.Text, tbLoginNTName.Text, "UnLogin", Session.SessionID.ToString(), "Query", HttpContext.Current.Request.Url.AbsolutePath.ToString(), tbLoginPCName.Text, tbLoginPCIP.Text, "Query-btQuery", strLogWhere.Replace("'", ""), "");
        /*--------------------------------------------------------------------------------------*/
        DateTime dtT = System.DateTime.Now;
        TimeSpan tsDiff = dtT - dtF;
        intSecCnt = Convert.ToInt32(tsDiff.TotalSeconds);
        lblTTime.Text = "查詢耗時：" + intSecCnt.ToString() + "s";
        /*--------------------------------------------------------------------------------------*/
    }
    protected void DataBoundBU()
    {
        string strSql = "";
        DBConn dbConn = new DBConn(tbFABID.Text.ToString());
        strSql = "";
        strSql = "SELECT BU FROM REP.MBUM WHERE FABID = '" + tbFABID.Text + " ' UNION ALL SELECT 'ALL' AS BU";
        DataSet ds = new DataSet();
        ds = dbConn.GetDataSetBySql(strSql, "");
        ChKBUlist1.DataSource = ds;
        ChKBUlist1.DataTextField = "BU";
        ChKBUlist1.DataValueField = "BU";
        ChKBUlist1.DataBind();
        ds.Dispose();

        for (int i = 0; i < ChKBUlist1.Items.Count; i++)
        {
            ChKBUlist1.Items[i].Selected = true;
        }
    }
