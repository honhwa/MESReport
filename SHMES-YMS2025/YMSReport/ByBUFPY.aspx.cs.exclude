    protected void QueryFPYDataBound()
    {
        try
        {
            StringBuilder strSql = new StringBuilder();
            DBConn dbConn = new DBConn(tbFABID.Text.ToString());
            /*----------------------------------------------------------------------------------------------*/
            strSql.Remove(0, strSql.Length);
            strSql.Append(" SELECT T1.BU AS BU_ID");

            for (int DTCnt = 0; DTCnt < 12; DTCnt++)
            {
                string strDate = Convert.ToDateTime(tbFmonth.Text).AddMonths(DTCnt).ToString("yyyy-MM");
                strSql.Append(" ,SUM(CASE WHEN DATETYPE='M' AND REPORTDT= '" + strDate + "'THEN Convert(decimal(18,2),A_YIELD) ELSE 0 END) AS  'M" + strDate + "'");
                if (strDate.ToString() == tbTmonth.Text.ToString())
                {
                    break;
                }
            }
            for (int DTCnt = 0; DTCnt < 5; DTCnt++)
            {
                int intYear = Convert.ToInt32(tbFweek.Text.Substring(0,4).ToString());
                int intWeek = Convert.ToInt32(tbFweek.Text.Substring(5, 2).ToString()) + DTCnt;
                string strDate = "";
                if (intWeek > 52)
                {
                    intYear = Convert.ToInt32(tbFweek.Text.Substring(0, 4).ToString()) + 1;
                    intWeek = intWeek - 53;
                }
                if (intWeek.ToString().Length == 1)
                {
                    strDate = intYear.ToString() + "-0" + intWeek.ToString();
                }
                else
                {
                    strDate = intYear.ToString() + "-" + intWeek.ToString();
                }

                strSql.Append(" ,SUM(CASE WHEN DATETYPE='W' AND REPORTDT= '" + strDate + "'THEN Convert(decimal(18,2),A_YIELD) ELSE 0 END) AS  'W" + strDate + "'");
                if (strDate.ToString() == tbTweek.Text.ToString())
                {
                    break;
                }
            }
            for (int DTCnt = 0; DTCnt < 7; DTCnt++)
            {
                string strDate = Convert.ToDateTime(tbFdate.Text).AddDays(DTCnt).ToString("yyyy-MM-dd");
                strSql.Append(" ,SUM(CASE WHEN DATETYPE='D' AND REPORTDT= '" + strDate + "'THEN Convert(decimal(18,2),A_YIELD) ELSE 0 END) AS  '" + strDate + "'");
                if (strDate.ToString() == tbTdate.Text.ToString())
                {
                    break;
                }
            }
            strSql.Append(" FROM (");
            strSql.Append(" SELECT  REPORTDT,DATETYPE,BU,PRODUCT_ID,CHIPQTY,A_YIELD");
            strSql.Append(" FROM YIELD_TBL_FPYByBU WHERE PRODUCT_ID='ALL'  ");
            strSql.Append(" AND DATETYPE='D'");
            strSql.Append(" AND REPORTDT>= '" + tbFdate.Text + "'");
            strSql.Append(" AND REPORTDT<= '" + tbTdate.Text + "'");
            if (DdlSHOP.Text == "CELL2")
            {
                strSql.Append(" AND SHOP='CELL2'");
            }
            else
            {
                strSql.Append(" AND SHOP='MODULE'");
            }
            strSql.Append(" UNION ALL");

            strSql.Append(" SELECT  REPORTDT,DATETYPE,BU,PRODUCT_ID,CHIPQTY,A_YIELD");
            strSql.Append(" FROM YIELD_TBL_FPYByBU WHERE PRODUCT_ID='ALL'  ");
            strSql.Append(" AND DATETYPE='W'");
            strSql.Append(" AND REPORTDT>= '" + tbFweek.Text + "'");
            strSql.Append(" AND REPORTDT<= '" + tbTweek.Text + "'");
            if (DdlSHOP.Text == "CELL2")
            {
                strSql.Append(" AND SHOP='CELL2'");
            }
            else
            {
                strSql.Append(" AND SHOP='MODULE'");
            }

            strSql.Append(" UNION ALL");

            strSql.Append(" SELECT  REPORTDT,DATETYPE,BU,PRODUCT_ID,CHIPQTY,A_YIELD");
            strSql.Append(" FROM YIELD_TBL_FPYByBU WHERE PRODUCT_ID='ALL'  ");
            strSql.Append(" AND DATETYPE='M'");
            strSql.Append(" AND REPORTDT>= '" + tbFmonth.Text + "'");
            strSql.Append(" AND REPORTDT<= '" + tbTmonth.Text + "'");
            if (DdlSHOP.Text == "CELL2")
            {
                strSql.Append(" AND SHOP='CELL2'");
            }
            else
            {
                strSql.Append(" AND SHOP='MODULE'");
            }
            strSql.Append(" ) T1 GROUP BY BU;");
            /*----------------------------------------------------------------------------------------------*/


            /*----------------------------------------------------------------------------------------------*/
            strSql.Append(" SELECT * FROM(SELECT 3 AS ITEMNO,REPORTDT,DATETYPE");
            for (int i = 0; i < ChKBUlist1.Items.Count; i++)
            {
                if (ChKBUlist1.Items[i].Selected == true)
                {
                    strSql.Append(" ,SUM(CASE WHEN BU='" + ChKBUlist1.Items[i].Value.ToString() + "' THEN Convert(decimal(18,2),A_YIELD) ELSE 0 END) AS " + ChKBUlist1.Items[i].Value.ToString() + "_YIELD");
                }
            }
            strSql.Append(" FROM YIELD_TBL_FPYByBU WHERE PRODUCT_ID='ALL'  ");
            strSql.Append(" AND DATETYPE='D'");
            strSql.Append(" AND REPORTDT>= '" + tbFdate.Text + "'");
            strSql.Append(" AND REPORTDT<= '" + tbTdate.Text + "'");
            if (DdlSHOP.Text == "CELL2")
            {
                strSql.Append(" AND SHOP='CELL2'");
            }
            else
            {
                strSql.Append(" AND SHOP='MODULE'");
            }
            strSql.Append(" GROUP BY REPORTDT,DATETYPE");
            strSql.Append(" UNION ALL");
            strSql.Append(" SELECT 2 AS ITEMNO,DATETYPE+REPORTDT AS REPORTDT,DATETYPE");
            for (int i = 0; i < ChKBUlist1.Items.Count; i++)
            {
                if (ChKBUlist1.Items[i].Selected == true)
                {
                    strSql.Append(" ,SUM(CASE WHEN BU='" + ChKBUlist1.Items[i].Value.ToString() + "' THEN Convert(decimal(18,2),A_YIELD) ELSE 0 END) AS " + ChKBUlist1.Items[i].Value.ToString() + "_YIELD");
                }
            }
            strSql.Append(" FROM YIELD_TBL_FPYByBU WHERE PRODUCT_ID='ALL'  ");
            strSql.Append(" AND DATETYPE='W'");
            strSql.Append(" AND REPORTDT>= '" + tbFweek.Text + "'");
            strSql.Append(" AND REPORTDT<= '" + tbTweek.Text + "'");
            if (DdlSHOP.Text == "CELL2")
            {
                strSql.Append(" AND SHOP='CELL2'");
            }
            else
            {
                strSql.Append(" AND SHOP='MODULE'");
            }
            strSql.Append(" GROUP BY REPORTDT,DATETYPE");
            strSql.Append(" UNION ALL");
            strSql.Append(" SELECT 1 AS ITEMNO,DATETYPE+REPORTDT AS REPORTDT,DATETYPE");
            for (int i = 0; i < ChKBUlist1.Items.Count; i++)
            {
                if (ChKBUlist1.Items[i].Selected == true)
                {
                    strSql.Append(" ,SUM(CASE WHEN BU='" + ChKBUlist1.Items[i].Value.ToString() + "' THEN Convert(decimal(18,2),A_YIELD) ELSE 0 END) AS " + ChKBUlist1.Items[i].Value.ToString() + "_YIELD");
                }
            }
            strSql.Append(" FROM YIELD_TBL_FPYByBU WHERE PRODUCT_ID='ALL'  ");
            strSql.Append(" AND DATETYPE='M'");
            strSql.Append(" AND REPORTDT>= '" +  tbFmonth.Text + "'");
            strSql.Append(" AND REPORTDT<= '" +  tbTmonth.Text + "'");
            if (DdlSHOP.Text == "CELL2")
            {
                strSql.Append(" AND SHOP='CELL2'");
            }
            else
            {
                strSql.Append(" AND SHOP='MODULE'");
            }
            strSql.Append(" GROUP BY REPORTDT,DATETYPE");
            strSql.Append(" )TT ORDER BY ITEMNO,REPORTDT");
            /*----------------------------------------------------------------------------------------------*/
            /*----------------------------------------------------------------------------------------------*/
            DataSet dt011 = new DataSet();
            SqlDataAdapter sqlApt011 = new SqlDataAdapter(strSql.ToString(), dbConn.ConnectionString);
            sqlApt011.Fill(dt011);
            /*-------------------------------------------------------------------------------------*/
            ClearChartBound();
            QueryDataGroupByFPY(dt011);
            GridView1.DataSource = dt011.Tables[0];
            GridView1.DataBind();
            /*-------------------------------------------------------------------------------------*/
            dt011.Dispose();
            sqlApt011.Dispose();
            strSql.Remove(0, strSql.Length);
        }
        catch (Exception ex)
        {
            throw ex;
        }
    }
    protected void QueryFPYBYPRODDataBound()
    {
        try
        {
            StringBuilder strSql = new StringBuilder();
            DBConn dbConn = new DBConn(tbFABID.Text.ToString());
            int Year = Convert.ToDateTime(tbTdate.Text).Year;
            /*----------------------------------------------------------------------------------------------*/
            strSql.Remove(0, strSql.Length);
            strSql.Append(" SELECT T1.BU AS BU_ID,T1.PRODUCT_ID");
            for (int DTCnt = 0; DTCnt < 12; DTCnt++)
            {
                string strDate = Convert.ToDateTime(tbFmonth.Text).AddMonths(DTCnt).ToString("yyyy-MM");
                strSql.Append(" ,SUM(CASE WHEN DATETYPE='M' AND REPORTDT= '" + strDate + "'THEN Convert(decimal(18,2),A_YIELD) ELSE 0 END) AS  'M" + strDate + "'");
                if (strDate.ToString() == tbTmonth.Text.ToString())
                {
                    break;
                }
            }
            for (int DTCnt = 0; DTCnt < 5; DTCnt++)
            {
                int intYear = Convert.ToInt32(tbFweek.Text.Substring(0, 4).ToString());
                int intWeek = Convert.ToInt32(tbFweek.Text.Substring(5, 2).ToString()) + DTCnt;
                string strDate = "";
                if (intWeek > 52)
                {
                    intYear = Convert.ToInt32(tbFweek.Text.Substring(0, 4).ToString()) + 1;
                    intWeek = intWeek - 53;
                }
                if (intWeek.ToString().Length == 1)
                {
                    strDate = intYear.ToString() + "-0" + intWeek.ToString();
                }
                else
                {
                    strDate = intYear.ToString() + "-" + intWeek.ToString();
                }

                strSql.Append(" ,SUM(CASE WHEN DATETYPE='W' AND REPORTDT= '" + strDate + "'THEN Convert(decimal(18,2),A_YIELD) ELSE 0 END) AS  'W" + strDate + "'");
                if (strDate.ToString() == tbTweek.Text.ToString())
                {
                    break;
                }
            }
            for (int DTCnt = 0; DTCnt < 7; DTCnt++)
            {
                string strDate = Convert.ToDateTime(tbFdate.Text).AddDays(DTCnt).ToString("yyyy-MM-dd");
                strSql.Append(" ,SUM(CASE WHEN DATETYPE='D' AND REPORTDT= '" + strDate + "'THEN Convert(decimal(18,2),A_YIELD) ELSE 0 END) AS  '" + strDate + "'");
                if (strDate.ToString() == tbTdate.Text.ToString())
                {
                    break;
                }
            }
            strSql.Append(" FROM (");
            strSql.Append(" SELECT  REPORTDT AS REPORTDT,DATETYPE,BU,PRODUCT_ID,CHIPQTY AS CHIP_QTY,A_YIELD ");
            strSql.Append(" FROM YIELD_TBL_FPYByBU ");
            strSql.Append(" WHERE BU!='ALL' ");
            strSql.Append(" AND DATETYPE='D'");
            strSql.Append(" AND REPORTDT>= '" + tbFdate.Text + "'");
            strSql.Append(" AND REPORTDT<= '" + tbTdate.Text + "'");
            if (DdlSHOP.Text == "CELL2")
            {
                strSql.Append(" AND SHOP='CELL2'");
            }
            else
            {
                strSql.Append(" AND SHOP='MODULE'");
            }
            strSql.Append(" UNION ALL");

            strSql.Append(" SELECT  REPORTDT AS REPORTDT,DATETYPE,BU,PRODUCT_ID,CHIPQTY AS CHIP_QTY,A_YIELD ");
            strSql.Append(" FROM YIELD_TBL_FPYByBU ");
            strSql.Append(" WHERE BU!='ALL' ");
            strSql.Append(" AND DATETYPE='W'");
            strSql.Append(" AND REPORTDT>= '" + tbFweek.Text + "'");
            strSql.Append(" AND REPORTDT<= '" + tbTweek.Text + "'");
            if (DdlSHOP.Text == "CELL2")
            {
                strSql.Append(" AND SHOP='CELL2'");
            }
            else
            {
                strSql.Append(" AND SHOP='MODULE'");
            }
            strSql.Append(" UNION ALL");

            strSql.Append(" SELECT  REPORTDT AS REPORTDT,DATETYPE,BU,PRODUCT_ID,CHIPQTY AS CHIP_QTY,A_YIELD ");
            strSql.Append(" FROM YIELD_TBL_FPYByBU ");
            strSql.Append(" WHERE BU!='ALL' ");
            strSql.Append(" AND DATETYPE='M'");
            strSql.Append(" AND REPORTDT>= '" +  tbFmonth.Text + "'");
            strSql.Append(" AND REPORTDT<= '" +  tbTmonth.Text + "'");
            if (DdlSHOP.Text == "CELL2")
            {
                strSql.Append(" AND SHOP='CELL2'");
            }
            else
            {
                strSql.Append(" AND SHOP='MODULE'");
            }
            strSql.Append(" ) T1 GROUP BY BU,PRODUCT_ID");
            /*----------------------------------------------------------------------------------------------*/
            /*QTY*/
            strSql.Append(" UNION ALL");
            strSql.Append(" SELECT T1.BU,'ALL-QTY' AS PRODUCT_ID");
            for (int DTCnt = 0; DTCnt < 12; DTCnt++)
            {
                string strDate = Convert.ToDateTime(tbFmonth.Text).AddMonths(DTCnt).ToString("yyyy-MM");
                strSql.Append(" ,SUM(CASE WHEN DATETYPE='M' AND REPORTDT= '" + strDate + "'THEN Convert(decimal(18,2),CHIPQTY) ELSE 0 END) AS  'M" + strDate + "'");
                if (strDate.ToString() == tbTmonth.Text.ToString())
                {
                    break;
                }
            }
            for (int DTCnt = 0; DTCnt < 5; DTCnt++)
            {
                int intYear = Convert.ToInt32(tbFweek.Text.Substring(0, 4).ToString());
                int intWeek = Convert.ToInt32(tbFweek.Text.Substring(5, 2).ToString()) + DTCnt;
                string strDate = "";
                if (intWeek > 52)
                {
                    intYear = Convert.ToInt32(tbFweek.Text.Substring(0, 4).ToString()) + 1;
                    intWeek = intWeek - 53;
                }
                if (intWeek.ToString().Length == 1)
                {
                    strDate = intYear.ToString() + "-0" + intWeek.ToString();
                }
                else
                {
                    strDate = intYear.ToString() + "-" + intWeek.ToString();
                }

                strSql.Append(" ,SUM(CASE WHEN DATETYPE='W' AND REPORTDT= '" + strDate + "'THEN Convert(decimal(18,2),CHIPQTY) ELSE 0 END) AS  'W" + strDate + "'");
                if (strDate.ToString() == tbTweek.Text.ToString())
                {
                    break;
                }
            }
            for (int DTCnt = 0; DTCnt < 7; DTCnt++)
            {
                string strDate = Convert.ToDateTime(tbFdate.Text).AddDays(DTCnt).ToString("yyyy-MM-dd");
                strSql.Append(" ,SUM(CASE WHEN DATETYPE='D' AND REPORTDT= '" + strDate + "'THEN Convert(decimal(18,2),CHIPQTY) ELSE 0 END) AS  '" + strDate + "'");
                if (strDate.ToString() == tbTdate.Text.ToString())
                {
                    break;
                }
            }
            strSql.Append("FROM (");
            strSql.Append(" SELECT  REPORTDT AS REPORTDT,DATETYPE,BU,FLOOR(CHIPQTY) AS CHIPQTY ");
            strSql.Append(" FROM YIELD_TBL_FPYByBU ");
            strSql.Append(" WHERE BU!='ALL' ");
            strSql.Append(" AND DATETYPE='D'");
            strSql.Append(" AND REPORTDT>= '" + tbFdate.Text + "'");
            strSql.Append(" AND REPORTDT<= '" + tbTdate.Text + "'");
            if (DdlSHOP.Text == "CELL2")
            {
                strSql.Append(" AND SHOP='CELL2'");
            }
            else
            {
                strSql.Append(" AND SHOP='MODULE'");
            }
            strSql.Append(" UNION ALL");

            strSql.Append(" SELECT  REPORTDT AS REPORTDT,DATETYPE,BU,FLOOR(CHIPQTY) AS CHIPQTY ");
            strSql.Append(" FROM YIELD_TBL_FPYByBU ");
            strSql.Append(" WHERE BU!='ALL' ");
            strSql.Append(" AND DATETYPE='W'");
            strSql.Append(" AND REPORTDT>= '" + tbFweek.Text + "'");
            strSql.Append(" AND REPORTDT<= '" + tbTweek.Text + "'");
            if (DdlSHOP.Text == "CELL2")
            {
                strSql.Append(" AND SHOP='CELL2'");
            }
            else
            {
                strSql.Append(" AND SHOP='MODULE'");
            }
            strSql.Append(" UNION ALL");

            strSql.Append(" SELECT  REPORTDT AS REPORTDT,DATETYPE,BU,FLOOR(CHIPQTY) AS CHIPQTY ");
            strSql.Append(" FROM YIELD_TBL_FPYByBU ");
            strSql.Append(" WHERE BU!='ALL' ");
            strSql.Append(" AND DATETYPE='M'");
            strSql.Append(" AND REPORTDT>= '" + tbFmonth.Text + "'");
            strSql.Append(" AND REPORTDT<= '" + tbTmonth.Text + "'");
            if (DdlSHOP.Text == "CELL2")
            {
                strSql.Append(" AND SHOP='CELL2'");
            }
            else
            {
                strSql.Append(" AND SHOP='MODULE'");
            }
            strSql.Append(" ) T1 GROUP BY BU");

            /*----------------------------------------------------------------------------------------------*/
            DataSet dt011 = new DataSet();
            SqlDataAdapter sqlApt011 = new SqlDataAdapter(strSql.ToString(), dbConn.ConnectionString);
            sqlApt011.Fill(dt011);
            /*-------------------------------------------------------------------------------------*/
            dt011.Tables[0].DefaultView.Sort = "BU_ID,PRODUCT_ID";
            GridView2.DataSource = dt011.Tables[0];
            GridView2.DataBind();
            /*-------------------------------------------------------------------------------------*/
            dt011.Dispose();
            sqlApt011.Dispose();
            strSql.Remove(0, strSql.Length);
        }
        catch (Exception ex)
        {
            throw ex;
        }
    }
