			"   :pagination='false'",
			"   :flexwidth='1'",
			"   :export-file-name='PageSetting.Title'>",
			"   <template #export-button>",
			" <a-button type='success'> 导出 </a-button>",
			" </template>",
			"  </DynamicTable>",
			" </div>",
			"</a-col>",
			"</a-row>",
			"</a-card>",
			" </div>",
			"",
			"</template>",
			"",
							
			"<script lang='tsx' setup>",
			"import { PageParams } from '@/components/core/dynamic-table/src/dynamic-table'",
			"import { useLoading } from '@/components/feat/Loading';",
			"import { GetCommon } from '@/api/pages/common';",
			"import { cloneDeep } from 'lodash';",
			"import {onMounted } from '@vue/runtime-core';",
			"import { reactive, ref } from '@vue/reactivity';",
			"import { useForm } from '@/components/core/schema-form';",
			"import { useTable } from '@/components/core/dynamic-table';",
			"import useRemoteSelect from '@/pages/ReportPortal/utils/useRemoteSelect';",
			"import { ReportCommon } from '@/store/module/ReportCommon';",
			"import { message } from 'ant-design-vue';",
			"import { getRowClassNmae } from '@/pages/ReportPortal/utils/common'",
			"const UseParamsAdd = ReportCommon()",
			"let FactoryType: string = UseParamsAdd.Fab;",
			"const [openFullLoading, closeFullLoading] = useLoading({",
			"tip: '數據加載中...'",
			"});",
			"const report = ref<HTMLElement | null>(null);",
			"function getImport(site: string) {",
			" const { schemas, optionsdata } = require(`@/pages/ReportPortal/FS/???/\\${site}/form-schema`);",
			" const { baseColumns } = require(`@/pages/ReportPortal/FS/???/\\${site}/Table`);",
			"return { schemas, optionsdata, baseColumns };",
			"}",

			"let { schemas, optionsdata, baseColumns } = getImport(FactoryType);",
			"",
			"let PageSetting = reactive<BasePageParams.BasePageSetting>({",
			" List: [] as any,",
			" Columns: [] as any,",
			" Title: '',",
			" moreData: [],",
			" SQLHidden: '',",
			" APIColumns: [] as any,",
			"});",
			"switch (FactoryType) { ",
			" case '': ",
			" PageSetting.Title = '';",
			" break;",
			"  default:",
			"  break;",
			" }",
			"const [DynamicTable] = useTable();",
			"const [SchemaForm, dynamicFormRef] = useForm({",
			"labelWidth: 120,",
			" schemas:schemas(FactoryType),",
			"actionColOptions: {",
			" span: 24",
			" },",
			" layout: 'vertical'",
			"});",
			"",
			"",

			"async function confirm(values) {",
			"openFullLoading();",
			"let baseParams = {",
			"apiName: '???',",
			"FactoryType: FactoryType,",
			" G_FAC: UseParamsAdd.G_FAC_COM",
			" };",
			"Object.keys(values).forEach((key) => {",
			"if (!values[key]) {",
			" values[key] = '';",
			"}",
			" });",
			"",
			"",
			"try {",

			"let { api01:{ Data: { Table: Data } } } = await GetCommon({...baseParams,...values});",
			"if (Data.length == 0) {",
			" PageSetting.moreData = [];",
			" closeFullLoading();",
			" return message.warn('无数据!');",
			" }",
			"",
			"PageSetting.moreData = Data;",
			"PageSetting.Columns = baseColumns;",
			
			"",
			"closeFullLoading();",
			"} catch (error) {",
			"console.log(error)",
			"PageSetting.moreData = [];",
			"  closeFullLoading();",
			" }",
			"",

			"}",
			"",


			" onMounted(async () => {",

			"})",
			"</script>",
			"",

			"<style lang=\"less\" scoped>",
			"",
			"</style>"
