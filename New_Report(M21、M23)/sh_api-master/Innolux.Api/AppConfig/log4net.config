<?xml version="1.0" encoding="utf-8" ?>
<log4net>
  <!--根配置-->
  <root>
    <!--日志级别:可选值: OFF > FATAL > ERROR > WARN > INFO > DEBUG  > ALL -->
    <level value="OFF"/>
    <!-- <appender-ref ref="ErrorLogAppender" />
       <appender-ref ref="InfoLogAppender" />
       <appender-ref ref="DbLogAppender" />-->
  </root>

  <!--GrayLog-->
  <appender name="GrayLogAppender" type="log4net.Appender.UdpAppender">
    <param name="Encoding" value="utf-8" />
    <remoteAddress value="10.189.127.62" />
    <remotePort value="9031" />
    <layout type="Innolux.Core.Logger.InnoluxLayout" >
      <conversionPattern value="%date | %-5level | %serverName | %P{Route} | %message%newline" />
    </layout>
  </appender>

  <!-- 错误 Error.log-->
  <appender name="ErrorLogAppender" type="log4net.Appender.RollingFileAppender">
    <!--目录路径，可以是相对路径或绝对路径-->
    <file value="logs/ErrorLog/"/>
    <!--防止多线程时不能写Log,官方说线程非安全-->
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <!--文件名，按日期生成文件夹-->
    <datePattern value="'Log'_yyyy-MM-dd.TXT" />
    <!--追加到文件-->
    <appendToFile value="true"/>
    <!--创建日志文件的方式，可选值：Date[日期],文件大小[Size],混合[Composite]-->
    <rollingStyle value="Composite"/>
    <!--名称是否可以更改 为false为可以更改-->
    <staticLogFileName value="false"/>
    <!--单个文件大小。单位:KB|MB|GB-->
    <maximumFileSize value="10MB"/>
    <!--最多保留的文件数，设为"-1"则不限-->
    <maxSizeRollBackups value="-1"/>
    <!--日志格式-->
    <layout type="Innolux.Core.Logger.InnoluxLayout">
      <conversionPattern value="%date | %-5level | %serverName | %P{Route} | %message%newline"/>
    </layout>
    <!--<filter type="log4net.Filter.LevelRangeFilter">
            <param name="LevelMin" value="ERROR" />
            <param name="LevelMax" value="ERROR" />
        </filter>-->
  </appender>

  <!-- 警告 Db.log-->
  <appender name="DbLogAppender" type="log4net.Appender.RollingFileAppender">
    <!--目录路径，可以是相对路径或绝对路径-->
    <file value="logs/DbLog/"/>
    <!--防止多线程时不能写Log,官方说线程非安全-->
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <!--文件名，按日期生成文件夹-->
    <datePattern value="'Log'_yyyy-MM-dd.TXT" />
    <!--追加到文件-->
    <appendToFile value="true"/>
    <!--创建日志文件的方式，可选值：Date[日期],文件大小[Size],混合[Composite]-->
    <rollingStyle value="Composite"/>
    <!--名称是否可以更改 为false为可以更改-->
    <staticLogFileName value="false"/>
    <!--单个文件大小。单位:KB|MB|GB-->
    <maximumFileSize value="10MB"/>
    <!--最多保留的文件数，设为"-1"则不限-->
    <maxSizeRollBackups value="-1"/>
    <!--日志格式-->
    <layout type="Innolux.Core.Logger.InnoluxLayout">
      <conversionPattern value="%date | %-5level | %serverName | %P{Route} | %message%newline"/>
    </layout>
    <!--<filter type="log4net.Filter.LevelRangeFilter">
			<param name="LevelMin" value="ERROR" />
			<param name="LevelMax" value="ERROR" />
		</filter>-->
  </appender>

  <!-- 信息 Info.log-->
  <appender name="InfoLogAppender" type="log4net.Appender.RollingFileAppender">
    <!--目录路径，可以是相对路径或绝对路径-->
    <file value="logs/InfoLog/"/>
    <!--防止多线程时不能写Log,官方说线程非安全-->
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <!--文件名，按日期生成文件夹-->
    <datePattern value="'Log'_yyyy-MM-dd.TXT" />
    <!--追加到文件-->
    <appendToFile value="true"/>
    <!--创建日志文件的方式，可选值：Date[日期],文件大小[Size],混合[Composite]-->
    <rollingStyle value="Composite"/>
    <!--名称是否可以更改 为false为可以更改-->
    <staticLogFileName value="false"/>
    <!--单个文件大小。单位:KB|MB|GB-->
    <maximumFileSize value="10MB"/>
    <!--最多保留的文件数，设为"-1"则不限-->
    <maxSizeRollBackups value="-1"/>
    <!--日志格式-->
    <layout type="Innolux.Core.Logger.InnoluxLayout">
      <conversionPattern value="%date | %-5level | %serverName | %P{Route} | %message%newline"/>
    </layout>
    <!--<filter type="log4net.Filter.LevelRangeFilter">
			<param name="LevelMin" value="ERROR" />
			<param name="LevelMax" value="ERROR" />
		</filter>-->
  </appender>

  <logger name="GrayLoger" additivity="false">
    <level value="ALL" />
    <appender-ref ref="GrayLogAppender" />
  </logger>

  <logger name="ErrorLoger" additivity="false">
    <level value="ERROR" />
    <appender-ref ref="ErrorLogAppender" />
  </logger>

  <logger name="DbLoger" additivity="false">
    <level value="ALL" />
    <appender-ref ref="DbLogAppender" />
  </logger>

  <logger name="InfoLoger" additivity="false">
    <level value="ALL" />
    <appender-ref ref="InfoLogAppender" />
  </logger>

</log4net>